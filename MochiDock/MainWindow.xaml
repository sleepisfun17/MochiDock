<Window x:Class="MochiDock.MainWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

        xmlns:local="clr-namespace:MochiDock"

        xmlns:views="clr-namespace:MochiDock.Views"

        xmlns:cards="clr-namespace:MochiDock.Views.Cards"

        xmlns:controls="clr-namespace:MochiDock.Controls"

        mc:Ignorable="d"

        Title="Mochi Dock"

        Icon="icon.ico"

        Width="680" Height="450"

        WindowStyle="None"

        AllowsTransparency="True"

        Background="Transparent"

        Topmost="True"

        ShowInTaskbar="False"

        ShowActivated="False"

        ResizeMode="NoResize"

        FontFamily="{DynamicResource IslandUiFont}"

        TextOptions.TextFormattingMode="Ideal"

        TextOptions.TextRenderingMode="Grayscale"


        SnapsToDevicePixels="True"

        UseLayoutRounding="True">

    <Window.Resources>

        <views:CardTypeToVisibilityConverter x:Key="CardVisibilityConverter" />

        <views:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />

        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Button styles -->


        <!-- Stable Segmented Activity Tabs: Active Tab Shows Pill Label, Inactive Tabs Stay Stable Icon-Only -->
        <Style x:Key="TabLabelBaseStyle" TargetType="TextBlock" BasedOn="{StaticResource HeaderLabel}">
            <Setter Property="Width" Value="0"/><Setter Property="Opacity" Value="0"/><Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="{DynamicResource IslandSmallLabelWeight}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Tag}" Value="Active">
                    <Setter Property="Margin" Value="5,0,3,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Header tab button: borderless pill with a vector icon and label -->
        <Style x:Key="ActivityTabButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{DynamicResource IslandUiFont}"/>
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource IslandInkBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Opacity" Value="0.90" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource IslandTabHoverBrush}" />
                    <Setter Property="Opacity" Value="1.0" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.7" />
                </Trigger>
                <Trigger Property="Tag" Value="Active">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Opacity" Value="1.0" />
                    <Setter Property="Padding" Value="10,4" />
                </Trigger>
            </Style.Triggers>
        </Style>


        <!-- Modern Rounded Dark Tray Menu Styles -->

        <Style x:Key="ModernTrayMenuItemStyle" TargetType="MenuItem">
            <Setter Property="FontFamily" Value="{DynamicResource IslandUiFont}"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
            <Setter Property="UseLayoutRounding" Value="True"/>

            <Setter Property="Foreground" Value="{DynamicResource IslandInkBrush}" />

            <Setter Property="FontSize" Value="12" />

            <Setter Property="FontWeight" Value="{DynamicResource IslandSmallLabelWeight}" />

            <Setter Property="Padding" Value="10,6" />

            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="MenuItem">

                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="8" Margin="2,1" Padding="{TemplateBinding Padding}">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="22" SharedSizeGroup="IconGroup" />

                                    <ColumnDefinition Width="*" />

                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ArrowGroup" />

                                </Grid.ColumnDefinitions>

                                <!-- Icon / Checkmark -->

                                <ContentPresenter Grid.Column="0" ContentSource="Icon" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,0" />

                                <!-- Header / Label -->

                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" />

                                <!-- Submenu Arrow -->

                                <TextBlock x:Name="Arrow" Grid.Column="2" Text="›" Foreground="{DynamicResource IslandMutedInkBrush}" FontSize="14" VerticalAlignment="Center" Margin="8,0,2,0" Visibility="Collapsed" />

                                <!-- Submenu Popup -->

                                <Popup x:Name="SubMenuPopup" AllowsTransparency="True" Placement="Right" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">

                                    <Grid Margin="4">
                                        <Border Background="{DynamicResource IslandSurfaceBrush}" BorderBrush="{DynamicResource IslandSubCardBorderBrush}" BorderThickness="1.2" CornerRadius="12" IsHitTestVisible="False"><Border.Effect>

                                            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.6" />

                                        </Border.Effect></Border>
                                        <Border Background="{DynamicResource IslandSurfaceBrush}" BorderBrush="{DynamicResource IslandSubCardBorderBrush}" BorderThickness="1.2" CornerRadius="12" Padding="4">
                                            <StackPanel IsItemsHost="True" />
                                        </Border>
                                    </Grid>

                                </Popup>

                            </Grid>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsHighlighted" Value="True">

                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource IslandTabActiveBrush}" />

                            </Trigger>

                            <Trigger Property="HasItems" Value="True">

                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <Style x:Key="ModernTraySeparatorStyle" TargetType="Separator">

            <Setter Property="Background" Value="{DynamicResource IslandSubCardBorderBrush}" />

            <Setter Property="Height" Value="1" />

            <Setter Property="Margin" Value="6,4" />

        </Style>

        <Style x:Key="ModernTrayMenuStyle" TargetType="ContextMenu">
            <Setter Property="FontFamily" Value="{DynamicResource IslandUiFont}"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
            <Setter Property="UseLayoutRounding" Value="True"/>

            <Setter Property="Background" Value="{DynamicResource IslandSurfaceBrush}" />

            <Setter Property="BorderBrush" Value="{DynamicResource IslandSubCardBorderBrush}" />

            <Setter Property="BorderThickness" Value="1.2" />

            <Setter Property="Padding" Value="4" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ContextMenu">

                        <Grid>
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" IsHitTestVisible="False"><Border.Effect>

                                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.65" />

                            </Border.Effect></Border>
                                        <Border Background="{TemplateBinding Background}"

                                BorderBrush="{TemplateBinding BorderBrush}"

                                BorderThickness="{TemplateBinding BorderThickness}"

                                CornerRadius="12"

                                Padding="{TemplateBinding Padding}">
                                            <StackPanel IsItemsHost="True" />
                                        </Border>
                                    </Grid>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>

    <!-- Top Root Grid: Click outside island passes through -->

    <!-- Interface size: everything lives under ScaleRoot, whose LayoutTransform is the user's zoom (see ApplyInterfaceScale). The window itself is
         BaseWindowWidth x BaseWindowHeight times that scale. Positions (top margin, gaming offset, Notch edge, horizontal ratio) are window
         coordinates in screen DIPs and are never inside the transform. RootVerticalTranslate is always 0 (the window moves instead). -->
    <Grid x:Name="ScaleRoot">
    <Grid.LayoutTransform><ScaleTransform x:Name="InterfaceScaleTransform" ScaleX="1" ScaleY="1"/></Grid.LayoutTransform>
    <Grid HorizontalAlignment="Center" VerticalAlignment="Top">

        <Grid.RenderTransform>

            <TranslateTransform x:Name="RootVerticalTranslate" Y="0" />

        </Grid.RenderTransform>

        <!-- COMPACT MODE: Split Capsule Container (Main Pill + Companion Bubble) -->

        <StackPanel x:Name="CompactContainer" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0">

            <!-- 1. Primary Compact Pill -->

            <controls:IslandChrome x:Name="CompactPillBorder"

                    Background="{DynamicResource IslandGroundBrush}"

                    BorderBrush="{DynamicResource IslandBorderBrush}"

                    BorderThickness="1.2"

                    Width="44"

                    Cursor="Hand"

                    MouseEnter="IslandBorder_MouseEnter"

                    MouseLeave="IslandBorder_MouseLeave"

                    MouseLeftButtonUp="CompactView_MouseLeftButtonUp"

                    MouseMove="CompactPill_MouseMove"

                    PreviewMouseWheel="CompactPill_PreviewMouseWheel"

                    MouseDown="CompactPill_MouseDown">

                <Border.Style>

                    <Style TargetType="Border">

                        <Setter Property="Height" Value="36" />
                        <Setter Property="CornerRadius" Value="18" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPrayerArrivalVisible}" Value="True">
                                <Setter Property="Height" Value="48" />
                                <Setter Property="CornerRadius" Value="24" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsStatsShownInCapsule}" Value="True">
                                <Setter Property="Height" Value="48" />
                                <Setter Property="CornerRadius" Value="24" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasCompactLyricRomaji}" Value="True">
                                <Setter Property="Height" Value="48" />
                                <Setter Property="CornerRadius" Value="24" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>

                    <!-- Normal Media & Mascot Pill Content: Stretch layout so Mochi stays completely static -->

                    <Grid x:Name="PillNormalContent" Margin="0" VerticalAlignment="Center">

                        <Grid.Style>

                            <Style TargetType="Grid">

                                <Setter Property="HorizontalAlignment" Value="Center" />

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding IsCompactTextVisible}" Value="True">

                                        <Setter Property="HorizontalAlignment" Value="Stretch" />

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Grid.Style>

                        <Grid.ColumnDefinitions>

                            <!-- Col 0: Mochi Mascot anchor (Full circle when idle, 48px left cap when capsule active) -->

                            <ColumnDefinition x:Name="PillCol0">

                                <ColumnDefinition.Style>

                                    <Style TargetType="ColumnDefinition">

                                        <Setter Property="Width" Value="*" />

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding IsCompactTextVisible}" Value="True">

                                                <Setter Property="Width" Value="48" />

                                            </DataTrigger>

                                            <!-- Keep PillCol0 equal to PillCol2 in these states so the centred clock sits in the middle of the capsule. -->
                                            <DataTrigger Binding="{Binding IsWeatherInMainPill}" Value="True">

                                                <Setter Property="Width" Value="76" />

                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding IsBothPomodoroAndWeatherInMainPill}" Value="True">

                                                <Setter Property="Width" Value="102" />

                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </ColumnDefinition.Style>

                            </ColumnDefinition>

                            <!-- Col 1: Center Ticker / Telemetry content (Collapsed when idle) -->

                            <ColumnDefinition x:Name="PillCol1">

                                <ColumnDefinition.Style>

                                    <Style TargetType="ColumnDefinition">

                                        <Setter Property="Width" Value="0" />

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding IsCompactTextVisible}" Value="True">

                                                <Setter Property="Width" Value="*" />

                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </ColumnDefinition.Style>

                            </ColumnDefinition>

                            <!-- Col 2: Right balance anchor (Collapsed when idle, 48px when music/notification active, 16px when stats only) -->

                            <ColumnDefinition x:Name="PillCol2">

                                <ColumnDefinition.Style>

                                    <Style TargetType="ColumnDefinition">

                                        <Setter Property="Width" Value="0" />

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding IsCompactTextVisible}" Value="True">

                                                <Setter Property="Width" Value="18" />

                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding IsRestingClockPill}" Value="True">

                                                <Setter Property="Width" Value="48" />

                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding CurrentMedia.IsPlaying}" Value="True">

                                                <Setter Property="Width" Value="48" />

                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding HasSingleNotification}" Value="True">

                                                <Setter Property="Width" Value="48" />

                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding IsPomodoroInMainPill}" Value="True">
                                                <Setter Property="Width" Value="48" />
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding IsWeatherInMainPill}" Value="True">
                                                <Setter Property="Width" Value="76" />
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding IsBothPomodoroAndWeatherInMainPill}" Value="True">
                                                <Setter Property="Width" Value="102" />
                                            </DataTrigger>

                                        <DataTrigger Binding="{Binding IsPrayerReminderVisible}" Value="True"><Setter Property="Width" Value="0"/></DataTrigger></Style.Triggers>

                                    </Style>

                                </ColumnDefinition.Style>

                            </ColumnDefinition>

                        </Grid.ColumnDefinitions>

                        <!-- Mascot Living in the Pill (Always centered: dead-center in idle circle, centered in 48px left cap when expanded) -->

                        <controls:MascotControl Grid.Column="0"

                                                x:Name="PillMascot"

                                                Mood="{Binding MascotMood}"

                                                Width="22" Height="19"
                                                VerticalAlignment="Center">
                            <controls:MascotControl.Style>
                                <Style TargetType="controls:MascotControl">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="Margin" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWeatherInMainPill}" Value="True">
                                            <Setter Property="HorizontalAlignment" Value="Left" />
                                            <Setter Property="Margin" Value="13,0,0,0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:MascotControl.Style>
                        </controls:MascotControl>

                        <!-- Ticker Content: High-Res Color Icon + Text (Stretches across all available center width) -->

                        <Grid x:Name="PillTickerContent" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="4,0"

                              >
                            <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="{Binding IsCompactTextVisible, Converter={StaticResource BoolToVisibility}}"/><Style.Triggers><DataTrigger Binding="{Binding IsPrayerReminderVisible}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="Auto" />

                                <ColumnDefinition Width="*" />

                            </Grid.ColumnDefinitions>

                            <!-- Icons in Col 0 -->

                            <Grid Grid.Column="0" VerticalAlignment="Center">

                                <!-- Official High-Res Color Icon: Desktop Mode (Laptop/PC) -->

                                <Image Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"

                                       Source="pack://application:,,,/Assets/Icons/desktop.png"

                                       RenderOptions.BitmapScalingMode="HighQuality">

                                    <Image.Style>

                                        <Style TargetType="Image">

                                            <Setter Property="Visibility" Value="Collapsed" />

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding CompactCapsuleIconType}" Value="Desktop">

                                                    <Setter Property="Visibility" Value="Visible" />

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </Image.Style>

                                </Image>

                                <!-- Official High-Res Color Icon: WhatsApp Single Notification -->

                                <Image Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"

                                       Source="pack://application:,,,/Assets/Icons/whatsapp.png"

                                       RenderOptions.BitmapScalingMode="HighQuality">

                                    <Image.Style>

                                        <Style TargetType="Image">

                                            <Setter Property="Visibility" Value="Collapsed" />

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding CompactCapsuleIconType}" Value="WhatsApp">

                                                    <Setter Property="Visibility" Value="Visible" />

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </Image.Style>

                                </Image>

                                <!-- Apps card: the watched app's own logo -->

                                <Image Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center" Source="{Binding CurrentApp.Icon}" RenderOptions.BitmapScalingMode="HighQuality">

                                    <Image.Style>

                                        <Style TargetType="Image">

                                            <Setter Property="Visibility" Value="Collapsed" />

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding CompactCapsuleIconType}" Value="Apps">

                                                    <Setter Property="Visibility" Value="Visible" />

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </Image.Style>

                                </Image>

                                <!-- Official Discord Vector Icon: Discord Single Notification -->

                                <Path Width="15" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"

                                      Fill="{DynamicResource IslandDiscordBrush}" Stretch="Uniform"

                                      Data="M19.27 5.33C17.94 4.71 16.5 4.26 15 4a.09.09 0 0 0-.07.03c-.18.33-.39.76-.53 1.09a16.09 16.09 0 0 0-4.8 0c-.14-.34-.35-.76-.54-1.09-.01-.02-.04-.03-.07-.03-1.5.26-2.93.71-4.27 1.33-.01 0-.02.01-.03.02-2.72 4.07-3.47 8.03-3.1 11.95 0 .02.01.04.03.05 1.8 1.32 3.53 2.12 5.24 2.65.03.01.06 0 .07-.02.4-.55.76-1.13 1.07-1.74.02-.04 0-.08-.04-.09-.57-.22-1.11-.48-1.64-.78-.04-.02-.04-.08-.01-.11.11-.08.22-.17.33-.25.02-.02.05-.02.07-.01 3.44 1.57 7.15 1.57 10.55 0 .02-.01.05-.01.07.01.11.09.22.17.33.26.04.03.04.08-.01.11-.52.31-1.07.56-1.64.78-.04.01-.05.06-.04.09.32.61.68 1.19 1.07 1.74.03.01.06.02.09.02 1.72-.53 3.45-1.33 5.25-2.65.02-.01.03-.03.03-.05.44-4.53-.73-8.46-3.1-11.95-.01-.01-.02-.02-.04-.02zM8.52 14.91c-1.03 0-1.89-.95-1.89-2.12s.84-2.12 1.89-2.12c1.06 0 1.9.96 1.89 2.12 0 1.17-.84 2.12-1.89 2.12zm6.97 0c-1.03 0-1.89-.95-1.89-2.12s.84-2.12 1.89-2.12c1.06 0 1.9.96 1.89 2.12 0 1.17-.83 2.12-1.89 2.12z">

                                    <Path.Style>

                                        <Style TargetType="Path">

                                            <Setter Property="Visibility" Value="Collapsed" />

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding CompactCapsuleIconType}" Value="Discord">

                                                    <Setter Property="Visibility" Value="Visible" />

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </Path.Style>

                                </Path>

                                <!-- Official High-Res Color Icon: Email Single Notification -->

                                <Image Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"

                                       Source="pack://application:,,,/Assets/Icons/email.png"

                                       RenderOptions.BitmapScalingMode="HighQuality">

                                    <Image.Style>

                                        <Style TargetType="Image">

                                            <Setter Property="Visibility" Value="Collapsed" />

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding CompactCapsuleIconType}" Value="Email">

                                                    <Setter Property="Visibility" Value="Visible" />

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </Image.Style>

                                </Image>

                            </Grid>

                            <!-- Smooth Marquee or 2-line Lyric in Col 1 (Fills remaining horizontal space dynamically) -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0,0,0,0">
<Button Content="{Binding HardwareNoticeText}" Click="HardwareNotice_Click" Visibility="{Binding IsHardwareNoticeVisible, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource ActionButton}" ToolTip="Open Stats"/>
<controls:MarqueeTextBlock x:Name="CapsuleMarquee" CenterNumerals="{Binding IsPrimaryCapsuleReading}" Typography.NumeralAlignment="Tabular"
                                                           Text="{Binding CompactCapsuleText}"
                                                           ScrollSpeed="{Binding CapsuleScrollSpeed}"
                                                           PaceSeconds="{Binding CompactLineSeconds}"
                                                           EnableScrolling="{Binding IsCompactMarqueeEnabled}"
                                                           RaiseCycleCompleted="True"
                                                           CycleCompleted="CapsuleMarquee_CycleCompleted"
                                                           Foreground="{DynamicResource IslandInkBrush}"
                                                           HorizontalAlignment="Stretch"
                                                           VerticalAlignment="Center">
                                    <controls:MarqueeTextBlock.Style>
                                        <Style TargetType="controls:MarqueeTextBlock">
                                            <Setter Property="FontSize" Value="13" />
                                            <Setter Property="FontWeight" Value="{DynamicResource IslandSmallLabelWeight}" />
                                            <Style.Triggers><DataTrigger Binding="{Binding IsPrimaryCapsuleReading}" Value="True"><Setter Property="FontWeight" Value="{DynamicResource IslandPrimaryReadingWeight}"/></DataTrigger><DataTrigger Binding="{Binding IsPrayerReminderVisible}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsHardwareNoticeVisible}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                <DataTrigger Binding="{Binding IsStatsShownInCapsule}" Value="True">
                                                    <Setter Property="FontSize" Value="12.5" />
                                                    <Setter Property="FontWeight" Value="{DynamicResource IslandSmallLabelWeight}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasCompactLyricRomaji}" Value="True">
                                                    <Setter Property="FontSize" Value="13" />
                                                    <Setter Property="FontWeight" Value="{DynamicResource IslandSmallLabelWeight}" />
                                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </controls:MarqueeTextBlock.Style>
                                </controls:MarqueeTextBlock>

                                <!-- 2nd Line: Romaji Furigana Reading (Visible when music is playing with romaji) -->
                                <TextBlock Text="{Binding CurrentLyricRomaji}"
                                           FontSize="10.5"
                                           FontWeight="{DynamicResource IslandSmallLabelWeight}"
                                           Foreground="{DynamicResource IslandMutedInkBrush}"
                                           HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,1,0,0"
                                           Visibility="{Binding HasCompactLyricRomaji, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>

                        </Grid>

                        <!-- Dynamic Island Animated Audio Waveform / Notification Count Indicator on the right (Column 2) -->

                        <controls:PrayerReminderReadout x:Name="PrayerReminderContent" Grid.Column="1" Grid.ColumnSpan="2" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsPrayerReminderVisible, Converter={StaticResource BoolToVisibility}}" ShowWeather="{Binding IsWeatherInPrayerReminder}" Acknowledged="PrayerReminderOK_Click"/>
                        <Grid x:Name="PillRightAnchors" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsPrayerReminderVisible}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>

                            <!-- 4 Animated Waveform Bars (Active when music is playing and not gaming and not takeover) -->

                            <Grid Visibility="{Binding IsAudioWaveformVisible, Converter={StaticResource BoolToVisibility}}"

                                  VerticalAlignment="Center">

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="14">
                                    <Border Width="2.2" Height="14" CornerRadius="1" Background="{DynamicResource IslandSpotifyBrush}" Margin="1,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,1">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleY="0.57" />
                                        </Border.RenderTransform>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAudioWaveformVisible}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard x:Name="EqAnim1">
                                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.29" To="1.0" Duration="0:0:0.45" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <StopStoryboard BeginStoryboardName="EqAnim1" />
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <Border Width="2.2" Height="14" CornerRadius="1" Background="{DynamicResource IslandSpotifyBrush}" Margin="1,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,1">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleY="0.93" />
                                        </Border.RenderTransform>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAudioWaveformVisible}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard x:Name="EqAnim2">
                                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.93" To="0.36" Duration="0:0:0.35" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <StopStoryboard BeginStoryboardName="EqAnim2" />
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <Border Width="2.2" Height="14" CornerRadius="1" Background="{DynamicResource IslandSpotifyBrush}" Margin="1,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,1">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleY="0.43" />
                                        </Border.RenderTransform>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAudioWaveformVisible}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard x:Name="EqAnim3">
                                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.36" To="0.93" Duration="0:0:0.55" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <StopStoryboard BeginStoryboardName="EqAnim3" />
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <Border Width="2.2" Height="14" CornerRadius="1" Background="{DynamicResource IslandSpotifyBrush}" Margin="1,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,1">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleY="0.71" />
                                        </Border.RenderTransform>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAudioWaveformVisible}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard x:Name="EqAnim4">
                                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.71" To="0.29" Duration="0:0:0.40" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <StopStoryboard BeginStoryboardName="EqAnim4" />
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </StackPanel>

                            </Grid>

                            <!-- Multi-Notification Rotation Counter (e.g. 1/3) -->

                            <TextBlock Text="{Binding RotationPositionText}"

                                       Foreground="{DynamicResource IslandMutedInkBrush}"

                                       FontSize="10"

                                       FontWeight="{DynamicResource IslandSmallLabelWeight}"

                                       VerticalAlignment="Center"

                                       HorizontalAlignment="Center"

                                       Margin="2,0,4,0"

                                       Visibility="{Binding ShowRotationPosition, Converter={StaticResource BoolToVisibility}}" />

                            <!-- Single Activity Notification Indicator Dot (when only 1 notification is in the main pill) -->

                            <TextBlock Text="●" Foreground="{Binding CompanionBubbleColor}" FontSize="10" VerticalAlignment="Center"

                                       HorizontalAlignment="Center"

                                       Margin="0,0,2,0">

                                <TextBlock.Style>

                                    <Style TargetType="TextBlock">

                                        <Setter Property="Visibility" Value="Collapsed" />

                                        <Style.Triggers>

                                            <MultiDataTrigger>

                                                <MultiDataTrigger.Conditions>

                                                    <Condition Binding="{Binding HasSingleNotification}" Value="True" />

                                                    <Condition Binding="{Binding ShowRotationPosition}" Value="False" />

                                                    <Condition Binding="{Binding IsAudioWaveformVisible}" Value="False" />

                                                    <Condition Binding="{Binding IsWeatherInMainPill}" Value="False" />

                                                </MultiDataTrigger.Conditions>

                                                <Setter Property="Visibility" Value="Visible" />

                                            </MultiDataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </TextBlock.Style>

                            </TextBlock>

                            <!-- Dynamic Right Anchors: Pomodoro & Weather side-by-side without overlap -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,4,0">
                                <!-- Pomodoro Icon (Visible when Pomodoro is active) -->
                                <Viewbox Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <Viewbox.Style>
                                        <Style TargetType="Viewbox">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPomodoroInMainPill}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Viewbox.Style>
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="{DynamicResource IslandRedBrush}" Data="M12,5 C6.5,5 3,8.5 3,14 C3,19 6.8,22 12,22 C17.2,22 21,19 21,14 C21,8.5 17.5,5 12,5 Z" />
                                        <Path Fill="{DynamicResource IslandGreenBrush}" Data="M12,2 C12,4 11.5,5.2 10.5,5.8 C11.5,5.5 12.5,5.5 13.5,5.8 C12.5,5.2 12,4 12,2 Z" />
                                        <Path Fill="{DynamicResource IslandGreenBrush}" Data="M12,5.2 C13.8,3.8 16.5,4 18,5 C16.2,5.8 14.5,5.8 12.8,5.5 Z" />
                                        <Path Fill="{DynamicResource IslandGreenBrush}" Data="M12,5.2 C10.2,3.8 7.5,4 6,5 C7.8,5.8 9.5,5.8 11.2,5.5 Z" />
                                    </Canvas>
                                </Viewbox>

                                <!-- Weather Badge: Vector Icon + Celsius Readout (Visible when Weather is active; measured by ApplyClockWeatherLayout) -->
                                <StackPanel x:Name="PillWeatherBadge" Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWeatherInMainPill}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <ContentControl Content="{Binding WeatherInfo}"
                                                    ContentTemplate="{StaticResource WeatherVectorIconTemplate}"
                                                    Width="17" Height="17"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,4,0" />
                                    <controls:CompactTextLine VerticalAlignment="Stretch"><TextBlock Text="{Binding WeatherTemperatureBadge}"
                                               Foreground="{DynamicResource IslandInkBrush}"
                                               FontSize="11.5"
                                               FontWeight="{DynamicResource IslandSmallLabelWeight}"
                                               VerticalAlignment="Center" /></controls:CompactTextLine>
                                </StackPanel>
                            </StackPanel>

                        </Grid>

                    </Grid>

                    <StackPanel x:Name="GamingCapsuleContent" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Margin="12,0,12,0">
                        <controls:MascotControl Width="22" Height="19" Mood="{Binding MascotMood}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                        <controls:GamingReadout x:Name="CompactGamingReadout"/>
                    </StackPanel>
                    <!-- Interactive iOS-style Volume Slider Overlay (Shows while scrolling wheel or external volume change) -->

                    <Grid x:Name="CapsuleVolumeOverlay" Visibility="Collapsed" Margin="12,0,14,0" VerticalAlignment="Center">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="Auto" />

                            <ColumnDefinition Width="*" />

                            <ColumnDefinition Width="Auto" />

                        </Grid.ColumnDefinitions>

                        <!-- Crisp Vector Volume Speaker Icon (No font emojis) -->

                        <Path x:Name="CapsuleVolumeVectorIcon" Grid.Column="0" Width="13" Height="13" Stretch="Uniform" Fill="{DynamicResource IslandVolumeBrush}" Margin="0,0,8,0" VerticalAlignment="Center"

                              Data="M3,9v6h4l5,5V4L7,9H3z M16.5,12c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-0.73 2.5-2.25 2.5-4.02z M14,3.23v2.06c2.89,0.86 5,3.54 5,6.71s-2.11,5.85-5,6.71v2.06c4.01-0.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z" />

                        <ProgressBar x:Name="CapsuleVolumeProgress" Grid.Column="1" Height="6" Minimum="0" Maximum="100" Value="50"
                                     Background="{DynamicResource IslandVolumeTrackBrush}" Foreground="{DynamicResource IslandVolumeBrush}" BorderThickness="0" VerticalAlignment="Center">
                            <ProgressBar.Template>
                                <ControlTemplate TargetType="ProgressBar">
                                    <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
                                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left" />
                                    </Border>
                                </ControlTemplate>
                            </ProgressBar.Template>
                        </ProgressBar>

                        <TextBlock x:Name="CapsuleVolumeText" Grid.Column="2" Text="50%" Foreground="{DynamicResource IslandInkBrush}" FontSize="11" FontWeight="{DynamicResource IslandSmallStrongWeight}" Margin="8,0,0,0" VerticalAlignment="Center" />

                    </Grid>

                    <!-- Interactive Resolution Switcher Toast Overlay (Centered pill notification) -->
                    <StackPanel x:Name="CapsuleResolutionOverlay"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <Path Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource IslandAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"
                              Data="M20,3H4C2.9,3,2,3.9,2,5v11c0,1.1,0.9,2,2,2h6l-2,2v1h8v-1l-2-2h6c1.1,0,2-0.9,2-2V5C22,3.9,21.1,3,20,3z M20,16H4V5h16V16z" />
                        <TextBlock x:Name="CapsuleResolutionText" Text="2304×1440 (16:10) @ 200Hz"
                                   Foreground="{DynamicResource IslandInkBrush}" FontSize="11.5" FontWeight="{DynamicResource IslandSmallStrongWeight}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Charger / low-battery notice (silent, short; never expands the dock) -->
                    <StackPanel x:Name="CapsulePowerOverlay"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Visibility="Collapsed">
                        <Path x:Name="CapsulePowerIcon" Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource IslandGreenBrush}" Margin="0,0,8,0" VerticalAlignment="Center"
                              Data="M11,21h-1l1-7H7.5c-0.88,0-0.33-0.75-0.31-0.78C8.48,10.94,10.42,7.54,13.01,3h1l-1,7h3.51c0.4,0,0.62,0.19,0.4,0.66C12.97,17.55,11,21,11,21z" />
                        <TextBlock x:Name="CapsulePowerText" Text="Charging · 54%"
                                   Foreground="{DynamicResource IslandInkBrush}" FontSize="11.5" FontWeight="{DynamicResource IslandSmallStrongWeight}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Interactive Prayer Arrival Notification Overlay (Shows for 1 minute when prayer time arrives) -->
                    <Grid x:Name="CapsulePrayerArrivalOverlay"
                          Visibility="Collapsed"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          Margin="0"
                          Cursor="Hand"
                          MouseLeftButtonUp="PrayerArrivalOverlay_MouseLeftButtonUp">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Warm circular badge with crescent moon -->
                        <Border Grid.Column="0"
                                Width="30" Height="30"
                                CornerRadius="15"
                                Background="{DynamicResource IslandPrayerBadgeBackgroundBrush}"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0">
                            <Viewbox Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M19.77 13.9A8 8 0 1 1 10.1 4.23A7 7 0 0 0 19.77 13.9Z"
                                          Stroke="{DynamicResource IslandPrayerBadgeStrokeBrush}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <!-- Two-line stacked text: Title + Subtitle -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="PrayerArrivalTitleText"
                                       Text="{Binding PrayerArrivalTitle}"
                                       FontFamily="{DynamicResource IslandUiFont}"
                                       FontWeight="{DynamicResource IslandPrimaryReadingWeight}"
                                       FontSize="13"
                                       Foreground="{DynamicResource IslandInkBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="PrayerArrivalSubtitleText"
                                       Text="{Binding PrayerArrivalSubtitle}"
                                       FontFamily="{DynamicResource IslandUiFont}"
                                       FontWeight="{DynamicResource IslandSmallLabelWeight}"
                                       FontSize="11"
                                       Foreground="{DynamicResource IslandSecondaryInkBrush}"
                                       Margin="0,1,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                </Grid>

            </controls:IslandChrome>

            <!-- 2. Secondary Companion Bubble (iOS Dynamic Island Multitasking Split Bubble) -->

            <!-- The shadow lives on a text-free sibling layer so the "+N" badge text is never rasterized by an effect. -->
            <Grid Visibility="{Binding HasCompanionBubble, Converter={StaticResource BoolToVisibility}}"
                  Width="38" Height="38" Margin="8,1,0,0">

            <Border Background="{DynamicResource IslandGroundBrush}" CornerRadius="19" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.5" />
                </Border.Effect>
            </Border>

            <Border x:Name="CompanionBubble"

                    Background="{DynamicResource IslandGroundBrush}"

                    BorderBrush="{DynamicResource IslandBorderBrush}"

                    BorderThickness="1.2"

                    CornerRadius="19"

                    Cursor="Hand"

                    MouseLeftButtonUp="CompanionBubble_MouseLeftButtonUp"

                    ToolTip="Click to open active notification">

                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">

                    <!-- WhatsApp Official High-Res Color Icon -->

                    <Image Width="22" Height="22"

                           Source="pack://application:,,,/Assets/Icons/whatsapp.png"

                           RenderOptions.BitmapScalingMode="HighQuality"

                           HorizontalAlignment="Center" VerticalAlignment="Center">

                        <Image.Style>

                            <Style TargetType="Image">

                                <Setter Property="Visibility" Value="Collapsed" />

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding CompanionBubbleType}" Value="WhatsApp">

                                        <Setter Property="Visibility" Value="Visible" />

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Image.Style>

                    </Image>

                    <!-- Apps card: the watched app's own logo -->

                    <Image Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{Binding CurrentApp.Icon}" RenderOptions.BitmapScalingMode="HighQuality">

                        <Image.Style>

                            <Style TargetType="Image">

                                <Setter Property="Visibility" Value="Collapsed" />

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding CompanionBubbleType}" Value="Apps">

                                        <Setter Property="Visibility" Value="Visible" />

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Image.Style>

                    </Image>

                    <!-- Discord Official Emblem -->

                    <Path Width="20" Height="16" Stretch="Uniform" Fill="{DynamicResource IslandDiscordBrush}"

                          HorizontalAlignment="Center" VerticalAlignment="Center"

                          Data="M19.27 5.33C17.94 4.71 16.5 4.26 15 4a.09.09 0 0 0-.07.03c-.18.33-.39.76-.53 1.09a16.09 16.09 0 0 0-4.8 0c-.14-.34-.35-.76-.54-1.09-.01-.02-.04-.03-.07-.03-1.5.26-2.93.71-4.27 1.33-.01 0-.02.01-.03.02-2.72 4.07-3.47 8.03-3.1 11.95 0 .02.01.04.03.05 1.8 1.32 3.53 2.12 5.24 2.65.03.01.06 0 .07-.02.4-.55.76-1.13 1.07-1.74.02-.04 0-.08-.04-.09-.57-.22-1.11-.48-1.64-.78-.04-.02-.04-.08-.01-.11.11-.08.22-.17.33-.25.02-.02.05-.02.07-.01 3.44 1.57 7.15 1.57 10.55 0 .02-.01.05-.01.07.01.11.09.22.17.33.26.04.03.04.08-.01.11-.52.31-1.07.56-1.64.78-.04.01-.05.06-.04.09.32.61.68 1.19 1.07 1.74.03.01.06.02.09.02 1.72-.53 3.45-1.33 5.25-2.65.02-.01.03-.03.03-.05.44-4.53-.73-8.46-3.1-11.95-.01-.01-.02-.02-.04-.02zM8.52 14.91c-1.03 0-1.89-.95-1.89-2.12s.84-2.12 1.89-2.12c1.06 0 1.9.96 1.89 2.12 0 1.17-.84 2.12-1.89 2.12zm6.97 0c-1.03 0-1.89-.95-1.89-2.12s.84-2.12 1.89-2.12c1.06 0 1.9.96 1.89 2.12 0 1.17-.83 2.12-1.89 2.12z">

                        <Path.Style>

                            <Style TargetType="Path">

                                <Setter Property="Visibility" Value="Collapsed" />

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding CompanionBubbleType}" Value="Discord">

                                        <Setter Property="Visibility" Value="Visible" />

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Path.Style>

                    </Path>

                    <!-- Email Official Fluent Color Icon -->

                    <Image Width="20" Height="20"

                           Source="pack://application:,,,/Assets/Icons/email.png"

                           RenderOptions.BitmapScalingMode="HighQuality"

                           HorizontalAlignment="Center" VerticalAlignment="Center">

                        <Image.Style>

                            <Style TargetType="Image">

                                <Setter Property="Visibility" Value="Collapsed" />

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding CompanionBubbleType}" Value="Email">

                                        <Setter Property="Visibility" Value="Visible" />

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Image.Style>

                    </Image>

                    <!-- Extra count pill badge (+1, +2) -->

                    <Border Background="{DynamicResource IslandIconButtonBackgroundBrush}" BorderBrush="{DynamicResource IslandControlBorderBrush}" BorderThickness="1" CornerRadius="6"

                            Padding="3,0,3,1" Margin="0,0,-12,-12"

                            HorizontalAlignment="Right" VerticalAlignment="Bottom"

                            Visibility="{Binding HasCompanionExtraCount, Converter={StaticResource BoolToVisibility}}">

                        <TextBlock Text="{Binding CompanionExtraCountText}" Foreground="{DynamicResource IslandInkBrush}" FontSize="9" FontWeight="{DynamicResource IslandSmallStrongWeight}" />

                    </Border>

                </Grid>

            </Border>

            </Grid>

        </StackPanel>

        <!-- EXPANDED CARD VIEW CONTAINER -->

        <controls:IslandChrome x:Name="ExpandedBorder"

                Visibility="Collapsed"

                Background="{DynamicResource IslandGroundBrush}"

                BorderBrush="{DynamicResource IslandBorderBrush}"

                BorderThickness="1.2"

                CornerRadius="20"

                HorizontalAlignment="Center"

                VerticalAlignment="Top"

                Margin="0,4,0,0"

                Width="500" Height="160"
                MouseEnter="IslandBorder_MouseEnter"
                MouseLeave="IslandBorder_MouseLeave">

            <Grid Margin="14,10,14,12">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="*" />

                </Grid.RowDefinitions>

                <!-- Top Bar: Mascot + Multitasking Activity Tabs (Left) and Control Icons (Right) in strict columns -->

                <Grid Grid.Row="0" Margin="0,0,0,10">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*" />

                        <ColumnDefinition Width="Auto" />

                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Mascot inside Expanded Card -->
                        <controls:MascotControl Grid.Column="0" x:Name="CardMascot" Mood="{Binding MascotMood}" Width="32" Height="28" Margin="0,0,8,0" VerticalAlignment="Center" />

                        <!-- Segmented Activity Tabs (Strict constrained width so right close/pin buttons never crop) -->
                        <ScrollViewer x:Name="HeaderTabsViewport" SizeChanged="HeaderTabsPanel_SizeChanged" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" Focusable="False" Margin="0,0,8,0">
                            <Grid x:Name="HeaderTabsLayer"><controls:HeaderSelectionOverlay x:Name="HeaderPillOverlay" IsSelectionEnabled="{Binding IsExpanded}" Tabs="{Binding ElementName=HeaderTabsPanel}"><Border x:Name="HeaderSelectionPill" IsHitTestVisible="False" HorizontalAlignment="Left" Height="28" VerticalAlignment="Center" CornerRadius="14" Background="{DynamicResource IslandTabActiveBrush}" BorderBrush="{DynamicResource IslandHeaderSelectionBorderBrush}" BorderThickness="1"/></controls:HeaderSelectionOverlay><StackPanel PreviewMouseWheel="HeaderTabs_Wheel" x:Name="HeaderTabsPanel" Orientation="Horizontal" VerticalAlignment="Center" SizeChanged="HeaderTabsPanel_SizeChanged">
<Button Style="{StaticResource ActivityTabButton}" Tag="{Binding IsMediaActive, Converter={StaticResource BoolToActiveTag}}" Click="TabMedia_Click" ToolTip="Media Player">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><ContentControl Content="{StaticResource NavMusic}" VerticalAlignment="Center"/><TextBlock Text="Media" Style="{StaticResource TabLabelBaseStyle}"
                                                   controls:TabLabelMotion.Active="{Binding IsMediaActive}" />
                                    </StackPanel>
                                </Button>

<Button Style="{StaticResource ActivityTabButton}"
                                        Tag="{Binding IsWhatsAppActive, Converter={StaticResource BoolToActiveTag}}"
                                        Visibility="{Binding HasActiveWhatsApp, Converter={StaticResource BoolToVisibility}}"
                                        Click="TabWhatsApp_Click"
                                        ToolTip="WhatsApp message">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><ContentControl Content="{StaticResource NavMessage}" VerticalAlignment="Center"/><TextBlock Text="WhatsApp" Style="{StaticResource TabLabelBaseStyle}"
                                                   controls:TabLabelMotion.Active="{Binding IsWhatsAppActive}" />
                                    </StackPanel>
                                </Button>

<Button Style="{StaticResource ActivityTabButton}"
                                        Tag="{Binding IsEmailActive, Converter={StaticResource BoolToActiveTag}}"
                                        Visibility="{Binding HasActiveEmail, Converter={StaticResource BoolToVisibility}}"
                                        Click="TabEmail_Click"
                                        ToolTip="Email message">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><ContentControl Content="{StaticResource NavMail}" VerticalAlignment="Center"/><TextBlock Text="Email" Style="{StaticResource TabLabelBaseStyle}"
                                                   controls:TabLabelMotion.Active="{Binding IsEmailActive}" />
                                    </StackPanel>
                                </Button>

<Button Style="{StaticResource ActivityTabButton}"
                                        Tag="{Binding IsDiscordActive, Converter={StaticResource BoolToActiveTag}}"
                                        Visibility="{Binding HasActiveDiscord, Converter={StaticResource BoolToVisibility}}"
                                        Click="TabDiscord_Click"
                                        ToolTip="Discord message">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><ContentControl Content="{StaticResource NavMessage}" VerticalAlignment="Center"/><TextBlock Text="Discord" Style="{StaticResource TabLabelBaseStyle}"
                                                   controls:TabLabelMotion.Active="{Binding IsDiscordActive}" />
                                    </StackPanel>
                                </Button>

<Button Style="{StaticResource ActivityTabButton}"
                                        Tag="{Binding IsAppsActive, Converter={StaticResource BoolToActiveTag}}"
                                        Visibility="{Binding HasActiveApps, Converter={StaticResource BoolToVisibility}}"
                                        Click="TabApps_Click"
                                        ToolTip="App notifications">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><ContentControl Content="{StaticResource NavBell}" VerticalAlignment="Center"/><TextBlock Text="Apps" Style="{StaticResource TabLabelBaseStyle}"
                                                   controls:TabLabelMotion.Active="{Binding IsAppsActive}" />
                                    </StackPanel>
                                </Button>

<Button Style="{StaticResource ActivityTabButton}" Tag="{Binding IsHardwareActive, Converter={StaticResource BoolToActiveTag}}" Click="TabHardware_Click" ToolTip="System Performance" Visibility="{Binding ShowStatsTab, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><ContentControl Content="{StaticResource NavGauge}" VerticalAlignment="Center"/><TextBlock Text="Stats" Style="{StaticResource TabLabelBaseStyle}"
                                                   controls:TabLabelMotion.Active="{Binding IsHardwareActive}" />
                                    </StackPanel>
                                </Button>

<Button Style="{StaticResource ActivityTabButton}" Tag="{Binding IsWeatherActive, Converter={StaticResource BoolToActiveTag}}" Click="TabWeather_Click" ToolTip="Weather Forecast" Visibility="{Binding ShowWeatherTab, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><ContentControl Content="{StaticResource NavWeather}" VerticalAlignment="Center"/><TextBlock Text="Weather" Style="{StaticResource TabLabelBaseStyle}"
                                                   controls:TabLabelMotion.Active="{Binding IsWeatherActive}" />
                                    </StackPanel>
                                </Button>

<Button Style="{StaticResource ActivityTabButton}" Tag="{Binding IsPomodoroActive, Converter={StaticResource BoolToActiveTag}}" Click="TabPomodoro_Click" ToolTip="Focus / Pomodoro Timer" Visibility="{Binding ShowPomodoroTab, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><ContentControl Content="{StaticResource NavTimer}" VerticalAlignment="Center"/><TextBlock Text="Focus" Style="{StaticResource TabLabelBaseStyle}"
                                                   controls:TabLabelMotion.Active="{Binding IsPomodoroActive}" />
                                    </StackPanel>
                                </Button>

<Button Style="{StaticResource ActivityTabButton}" Tag="{Binding IsPrayerActive, Converter={StaticResource BoolToActiveTag}}" Click="TabPrayer_Click" ToolTip="Islamic Prayer Times" Visibility="{Binding EnablePrayerTimes, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><ContentControl Content="{StaticResource NavMoon}" VerticalAlignment="Center"/><TextBlock Text="Prayer" Style="{StaticResource TabLabelBaseStyle}"
                                                   controls:TabLabelMotion.Active="{Binding IsPrayerActive}" />
                                    </StackPanel>
                                </Button>

<Button Style="{StaticResource ActivityTabButton}" Tag="{Binding IsFileShelfActive, Converter={StaticResource BoolToActiveTag}}" Click="TabFileShelf_Click" ToolTip="File Shelf &amp; Paired Drop" Visibility="{Binding ShowFileShelfTab, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><ContentControl Content="{StaticResource NavTray}" VerticalAlignment="Center"/><TextBlock Text="Shelf" Style="{StaticResource TabLabelBaseStyle}"
                                                   controls:TabLabelMotion.Active="{Binding IsFileShelfActive}" />
                                    </StackPanel>
                                </Button>

<Button Style="{StaticResource ActivityTabButton}" Tag="{Binding IsClipboardActive, Converter={StaticResource BoolToActiveTag}}" Click="TabClipboard_Click" ToolTip="Clipboard History" Visibility="{Binding ShowClipboardTab, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><ContentControl Content="{StaticResource NavClipboard}" VerticalAlignment="Center"/><TextBlock Text="Clip" Style="{StaticResource TabLabelBaseStyle}"
                                                   controls:TabLabelMotion.Active="{Binding IsClipboardActive}" />
                                    </StackPanel>
                                </Button>

<Button Style="{StaticResource ActivityTabButton}" Tag="{Binding IsTodayActive, Converter={StaticResource BoolToActiveTag}}" Click="TabToday_Click" Visibility="{Binding ShowTodayTab, Converter={StaticResource BoolToVisibility}}" ToolTip="Today calendar"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><ContentControl Content="{StaticResource NavCalendar}" VerticalAlignment="Center"/><TextBlock Text="Today" Style="{StaticResource TabLabelBaseStyle}" controls:TabLabelMotion.Active="{Binding IsTodayActive}"/></StackPanel></Button>

<Button Style="{StaticResource ActivityTabButton}" Tag="{Binding IsAiUsageActive, Converter={StaticResource BoolToActiveTag}}" Click="TabAiUsage_Click" Visibility="{Binding ShowAiUsageTab, Converter={StaticResource BoolToVisibility}}" ToolTip="Local AI Coding Plan Usage"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><ContentControl Content="{StaticResource NavSparkles}" VerticalAlignment="Center"/><TextBlock Text="AI Usage" Style="{StaticResource TabLabelBaseStyle}" controls:TabLabelMotion.Active="{Binding IsAiUsageActive}"/></StackPanel></Button>

<Button Style="{StaticResource ActivityTabButton}" Tag="{Binding IsScriptActive, Converter={StaticResource BoolToActiveTag}}" Click="TabScript_Click" Visibility="{Binding ShowScriptTab, Converter={StaticResource BoolToVisibility}}" ToolTip="Webcam Teleprompter / Script"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><ContentControl Content="{StaticResource NavScript}" VerticalAlignment="Center"/><TextBlock Text="Script" Style="{StaticResource TabLabelBaseStyle}" controls:TabLabelMotion.Active="{Binding IsScriptActive}"/></StackPanel></Button>

<Button Style="{StaticResource ActivityTabButton}" Tag="{Binding IsDownloadsActive, Converter={StaticResource BoolToActiveTag}}" Click="TabDownloads_Click" Visibility="{Binding ShowDownloadsTab, Converter={StaticResource BoolToVisibility}}" ToolTip="Media Downloader"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><ContentControl Content="{StaticResource NavDownload}" VerticalAlignment="Center"/><TextBlock Text="Downloads" Style="{StaticResource TabLabelBaseStyle}" controls:TabLabelMotion.Active="{Binding IsDownloadsActive}"/></StackPanel></Button>

<Button Style="{StaticResource ActivityTabButton}" Tag="{Binding IsFxRatesActive, Converter={StaticResource BoolToActiveTag}}" Visibility="{Binding ShowFxRatesTab, Converter={StaticResource BoolToVisibility}}" Click="TabFxRates_Click" ToolTip="FX Rates"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><ContentControl Content="{StaticResource NavFx}" VerticalAlignment="Center"/><TextBlock Text="FX Rates" Style="{StaticResource TabLabelBaseStyle}" controls:TabLabelMotion.Active="{Binding IsFxRatesActive}"/></StackPanel></Button>
</StackPanel></Grid>
                        </ScrollViewer>
                    </Grid>

                    <!-- Right Actions: Settings, Pin & Collapse with Fluent 3D Icons -->

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Pin Button -->
                        <Button Width="26" Height="24" Margin="0,0,4,0"
                                Click="PinButton_Click"
                                ToolTip="{Binding PinToolTip}"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{DynamicResource IslandIconButtonBackgroundBrush}" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="ButtonBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="10" Padding="5,3">
                                                    <ContentControl x:Name="PinHost" Content="{StaticResource NavPin}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                        <Setter TargetName="PinHost" Property="Content" Value="{StaticResource NavPinActive}"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource IslandIconButtonHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource IslandIconButtonPressedBrush}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource IslandAccentFillBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource IslandSelectionBorderBrush}" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsPinned}" Value="True" />
                                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="{DynamicResource IslandAccentFillBrush}" />
                                            <Setter Property="Opacity" Value="0.9" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Settings Button -->
                        <Button Style="{StaticResource IslandIconButton}" Click="SettingsButton_Click" ToolTip="Dock Settings / Monitor" Margin="0,0,8,0">
                            <ContentControl Content="{StaticResource NavGear}"/>
                        </Button>

                        <!-- Live date and time, top right of the header -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource HeaderDate}" x:Name="HeaderDateText" Text="{Binding CurrentDateText}" Foreground="{DynamicResource IslandMutedInkBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock Style="{StaticResource HeaderClock}" Text="{Binding CurrentTimeText}" Foreground="{DynamicResource IslandInkBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- No close button: the card collapses when the pointer leaves -->
                    </StackPanel>

                </Grid>

                <!-- Main Dynamic Content: MODULAR CARDS -->

                <controls:TabTransitionHost Grid.Row="1" SelectedKey="{Binding ActiveCardType}" x:Name="CardTransitions" Order="Media,WhatsApp,Email,Discord,Apps,Hardware,Weather,Pomodoro,Prayer,FileShelf,Clipboard,Today,AiUsage,Script,Downloads,FxRates,Settings">

                    <!-- Pomodoro Card Component -->

                    <cards:PomodoroCardView Tag="Pomodoro" Visibility="Collapsed" />

                    <!-- Prayer Times Card Component -->
                    <cards:PrayerCardView Tag="Prayer" Visibility="Collapsed" />

                    <!-- Weather Card Component -->

                    <cards:WeatherCardView Tag="Weather" Visibility="Collapsed" />

                    <!-- A. Media Player Card Component -->

                    <cards:MediaCardView Tag="Media" Visibility="Collapsed" />

                    <!-- B. WhatsApp Card Component (with emoji support & quick reactions) -->

                    <cards:WhatsAppCardView Tag="WhatsApp" Visibility="Collapsed" />

                    <!-- B2. Discord Card Component -->

                    <cards:DiscordCardView Tag="Discord" Visibility="Collapsed" />

                    <!-- B3. Apps Card: notifications from the watched apps -->

                    <cards:AppsCardView Tag="Apps" Visibility="Collapsed" />

                    <!-- C. Email Card Component (Mailspring Gmail & Outlook) -->

                    <cards:EmailCardView Tag="Email" Visibility="Collapsed" />

                    <!-- D. Settings Card Component -->

                    <cards:SettingsCardView Tag="Settings" Visibility="Collapsed" />

                    <!-- E. Hardware Monitor Card Component -->

                    <cards:FxRatesCardView Tag="FxRates" Visibility="Collapsed"/><cards:TodayCardView Tag="Today" Visibility="Collapsed"/><cards:HardwareCardView Tag="Hardware" Visibility="Collapsed" />

                    <!-- Optional cards (each has a tab switch in Settings > Tabs) -->
                    <cards:AiUsageCardView x:Name="AiUsageCard" Tag="AiUsage" Visibility="Collapsed" />
                    <cards:ScriptCardView Tag="Script" Visibility="Collapsed" />
                    <cards:DownloadsCardView Tag="Downloads" Visibility="Collapsed" />

                    <!-- F. Session / Overnight Summary Card Component -->

                    <cards:SummaryCardView Tag="Summary" Visibility="Collapsed" />

                    <!-- H. File Shelf Card Component -->
                    <cards:FileShelfCardView Tag="FileShelf" Visibility="Collapsed" />

                    <!-- I. Clipboard Card Component -->
                    <cards:ClipboardCardView Tag="Clipboard" Visibility="Collapsed" />

                </controls:TabTransitionHost>

            </Grid>

        </controls:IslandChrome>

    </Grid>
    </Grid>

</Window>

