<Application x:Class="MochiDock.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MochiDock"
             xmlns:views="clr-namespace:MochiDock.Views"
             xmlns:controls="clr-namespace:MochiDock.Controls"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Views/WeatherIconResources.xaml" /><ResourceDictionary Source="Views/NavigationIconResources.xaml" /><ResourceDictionary Source="Views/ColorIconResources.xaml" /><ResourceDictionary Source="Views/TypographyResources.xaml" /><ResourceDictionary Source="Views/Settings/SettingsResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="QuicksandFont">/MochiDock;component/Assets/Fonts/#Quicksand, Yu Gothic UI, Meiryo UI, Segoe UI Emoji</FontFamily>
            <FontWeight x:Key="IslandPrimaryReadingWeight">Bold</FontWeight>
            <FontWeight x:Key="IslandHeadingWeight">Bold</FontWeight>
            <FontWeight x:Key="IslandSmallLabelWeight">SemiBold</FontWeight>
            <FontWeight x:Key="IslandSmallStrongWeight">SemiBold</FontWeight>
            <FontWeight x:Key="IslandBodyWeight">SemiBold</FontWeight>
            <FontFamily x:Key="SystemUiFont">Segoe UI Variable Text, Segoe UI Variable, Segoe UI, Yu Gothic UI, Meiryo UI, Segoe UI Emoji</FontFamily>
            <FontFamily x:Key="IslandUiFont">/MochiDock;component/Assets/Fonts/#Quicksand, Yu Gothic UI, Meiryo UI, Segoe UI Emoji</FontFamily>

            <!-- Dynamic Theme Resources (Defaults to Classic Dark) -->
            <SolidColorBrush x:Key="IslandGroundBrush" Color="#000000" />
            <SolidColorBrush x:Key="IslandBorderBrush" Color="#2C2C3A" />
            <SolidColorBrush x:Key="IslandSurfaceBrush" Color="#0C0C10" />
            <SolidColorBrush x:Key="IslandSubCardBackgroundBrush" Color="#101016" />
            <SolidColorBrush x:Key="IslandSubCardBorderBrush" Color="#2C2C3A" />
            <SolidColorBrush x:Key="IslandChipBackgroundBrush" Color="#101016" />
            <SolidColorBrush x:Key="IslandChipActiveBrush" Color="#1A1A26" />
            <SolidColorBrush x:Key="IslandChipBorderBrush" Color="#32324A" />
            <SolidColorBrush x:Key="IslandIconButtonBackgroundBrush" Color="#1E1E26" />
            <SolidColorBrush x:Key="IslandIconButtonHoverBrush" Color="#30303C" />
            <SolidColorBrush x:Key="IslandActionButtonBackgroundBrush" Color="#20202A" />
            <SolidColorBrush x:Key="IslandActionButtonHoverBrush" Color="#343442" />
            <SolidColorBrush x:Key="IslandActionButtonPressedBrush" Color="#444458" />
            <SolidColorBrush x:Key="IslandIconButtonPressedBrush" Color="#3E3E4E" />
            <SolidColorBrush x:Key="IslandTabActiveBrush" Color="#242430" />
            <SolidColorBrush x:Key="IslandTabHoverBrush" Color="#18FFFFFF" />
            <SolidColorBrush x:Key="IslandInkBrush" Color="#F5F5F5" />
            <SolidColorBrush x:Key="IslandSecondaryInkBrush" Color="#9E9E9E" />
            <SolidColorBrush x:Key="IslandMutedInkBrush" Color="#808080" />
            <SolidColorBrush x:Key="IslandAccentBrush" Color="#EBEBF0" />
            <SolidColorBrush x:Key="IslandEmailBadgeBackgroundBrush" Color="#22222C" />
            <SolidColorBrush x:Key="IslandEmailBadgeInkBrush" Color="#E5E5EA" />
            <SolidColorBrush x:Key="IslandAccentFillBrush" Color="#EBEBF0" />
            <SolidColorBrush x:Key="IslandSelectionBorderBrush" Color="#D4D4DF" />
            <SolidColorBrush x:Key="IslandSelectionFillBrush" Color="#24FFFFFF" />
            <SolidColorBrush x:Key="IslandHeaderSelectionBorderBrush" Color="Transparent" />
            <Color x:Key="IslandSelectionColor">#D4D4DF</Color>
            <SolidColorBrush x:Key="IslandSliderThumbBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="IslandMediaGlyphBrush" Color="#121216" />
            <SolidColorBrush x:Key="IslandAccentButtonInkBrush" Color="#121216" />
            <SolidColorBrush x:Key="IslandStatusBrush" Color="#FFD60A" />
            <Color x:Key="IslandAccentColor">#EBEBF0</Color>
            <SolidColorBrush x:Key="IslandAccentSubtleBrush" Color="#24FFFFFF" />
            <SolidColorBrush x:Key="IslandPositiveBrush" Color="#34D399" />
            <SolidColorBrush x:Key="IslandPositiveSubtleBrush" Color="#2634D399" />
            <SolidColorBrush x:Key="IslandNegativeBrush" Color="#FB7185" />
            <SolidColorBrush x:Key="IslandNegativeSubtleBrush" Color="#26FB7185" />
            <SolidColorBrush x:Key="IslandWarningBrush" Color="#F59E0B" />
            <SolidColorBrush x:Key="IslandWarningSubtleBrush" Color="#26F59E0B" />
            <SolidColorBrush x:Key="IslandGaugeTrackBrush" Color="#2C2C40" />
            <SolidColorBrush x:Key="IslandTrackBrush" Color="#2C2C40" />
            <SolidColorBrush x:Key="IslandPrayerBadgeBackgroundBrush" Color="#22222C" />
            <SolidColorBrush x:Key="IslandPrayerBadgeStrokeBrush" Color="#EBEBF0" />
            <SolidColorBrush x:Key="IslandVolumeBrush" Color="#EBEBF0" />
            <SolidColorBrush x:Key="IslandVolumeTrackBrush" Color="#333336" />
            <SolidColorBrush x:Key="IslandHighlightBrush" Color="#D4BC8E" />
            <SolidColorBrush x:Key="IslandHighlightSubtleBrush" Color="#26D4BC8E" />
            <SolidColorBrush x:Key="IslandQiblaBrush" Color="#D4BC8E" />
            <SolidColorBrush x:Key="IslandControlBackgroundBrush" Color="#181822" />
            <SolidColorBrush x:Key="IslandControlBorderBrush" Color="#3E3E52" />
            <SolidColorBrush x:Key="IslandScrollBarThumbBrush" Color="#4A4A5E" />
            <SolidColorBrush x:Key="IslandScrollBarThumbHoverBrush" Color="#787894" />
            <SolidColorBrush x:Key="IslandSaturdayBrush" Color="#38BDF8" />
            <SolidColorBrush x:Key="IslandGreenBrush" Color="#30D158" />
            <SolidColorBrush x:Key="IslandOrangeBrush" Color="#FF9F0A" />
            <SolidColorBrush x:Key="IslandRedBrush" Color="#FF453A" />
            <SolidColorBrush x:Key="IslandBlueBrush" Color="#0A84FF" />
            <SolidColorBrush x:Key="IslandInfoBrush" Color="#64B5F6" />
            <SolidColorBrush x:Key="IslandWhatsAppInkBrush" Color="#062B14" />
            <SolidColorBrush x:Key="IslandWhatsAppBrush" Color="#25D366" />
            <SolidColorBrush x:Key="IslandWhatsAppSubtleBrush" Color="#1A25D366" />
            <SolidColorBrush x:Key="IslandWhatsAppBorderBrush" Color="#3325D366" />
            <SolidColorBrush x:Key="IslandPurpleBrush" Color="#BF5AF2" />
            <SolidColorBrush x:Key="IslandChartGridBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="IslandChartGridStrongBrush" Color="#25FFFFFF" />
            <SolidColorBrush x:Key="IslandDiscordBrush" Color="#5865F2" />
            <SolidColorBrush x:Key="IslandDiscordInkBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="IslandSpotifyBrush" Color="#1DB954" />

            <!-- Dynamic Media Lyric Brushes -->
            <SolidColorBrush x:Key="ActiveLyricBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ActiveLyricRomajiBrush" Color="#D0FFFFFF" />
            <SolidColorBrush x:Key="InactiveLyricBrush" Color="#8CFFFFFF" />
            <SolidColorBrush x:Key="InactiveLyricRomajiBrush" Color="#6EFFFFFF" />

            <!-- Dynamic Weather Brushes -->
            <SolidColorBrush x:Key="WeatherCloudBrush" Color="#B0B0C4" />
            <SolidColorBrush x:Key="WeatherCloudStroke" Color="Transparent" />
            <SolidColorBrush x:Key="WeatherClearCloudBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="WeatherPartlyCloudBrush" Color="#E0E0EA" />
            <SolidColorBrush x:Key="WeatherSunBrush" Color="#FFAE00" />
            <SolidColorBrush x:Key="WeatherPartlySunBrush" Color="#FFB800" />
            <SolidColorBrush x:Key="WeatherCoronaBrush" Color="#FFD043" />
            <SolidColorBrush x:Key="WeatherMistBrush" Color="#9898AA" />
            <SolidColorBrush x:Key="WeatherSnowflakeBrush" Color="#E0F2FE" />

            <views:CardTypeToVisibilityConverter x:Key="CardVisibilityConverter" />
        <views:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <views:BoolToActiveTagConverter x:Key="BoolToActiveTag" />
        <views:BooleanToTextConverter x:Key="BoolToTextConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Interface size (zoom). MainWindow replaces this with the real scale; tooltips and combo-box drop-downs open in their own windows,
             so they apply it themselves (the dock and settings content is scaled by their LayoutTransform). -->
        <ScaleTransform x:Key="IslandInterfaceScaleTransform" ScaleX="1" ScaleY="1"/>

        <!-- Keyboard focus ring shared by every interactive control style -->
        <Style x:Key="IslandFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="-2" CornerRadius="8" BorderThickness="1.5" BorderBrush="{DynamicResource IslandSelectionBorderBrush}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Focus rings for the small toggles: the ring follows the control's own corners (its radius + 2, since it sits 2 DIPs outside). -->
        <Style x:Key="IslandCheckFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="-2" CornerRadius="7" BorderThickness="1.5" BorderBrush="{DynamicResource IslandSelectionBorderBrush}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IslandRoundFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="-2" CornerRadius="11" BorderThickness="1.5" BorderBrush="{DynamicResource IslandSelectionBorderBrush}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shared Button Styles -->
        <Style x:Key="IslandIconButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource IslandFocusVisual}"/>
            <Setter Property="FontFamily" Value="{DynamicResource IslandUiFont}"/>
            <Setter Property="Background" Value="{DynamicResource IslandIconButtonBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource IslandInkBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5" x:Name="PressRoot">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Pressed feedback shared by every button template: the surface scales down slightly. -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PressRoot" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource IslandIconButtonHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource IslandIconButtonPressedBrush}" />
                </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsGroupHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource IslandUiFont}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="{DynamicResource IslandSmallLabelWeight}"/>
            <Setter Property="Foreground" Value="{DynamicResource IslandHighlightBrush}"/>
            <Setter Property="Margin" Value="2,10,0,4"/>
            <Setter Property="AutomationProperties.HeadingLevel" Value="Level2"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource IslandFocusVisual}"/>
            <Setter Property="FontFamily" Value="{DynamicResource IslandUiFont}"/>
            <Setter Property="Background" Value="{DynamicResource IslandActionButtonBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource IslandInkBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="{DynamicResource IslandBodyWeight}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="10,5" />
            <!-- No default margin: buttons in a row get Margin="8,0,0,0" (ButtonRowSpacing) on every button after the first. -->
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5" x:Name="PressRoot">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Covers the TextBlock WPF generates for plain string Content. -->
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CardBodyText}">
                                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PressRoot" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource IslandActionButtonHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource IslandActionButtonPressedBrush}" />
                </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
            </Style.Triggers>
            <Style.Resources>
                <!-- The implicit TextBlock style forces IslandInkBrush, which hid text on filled/primary buttons (light on light).
                     Inside any ActionButton-based button, text follows the button's own Foreground instead. -->
                <Style TargetType="TextBlock" BasedOn="{StaticResource CardBodyText}">
                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Style>
            </Style.Resources>
        </Style>

        <Style x:Key="IslandSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource IslandSubCardBorderBrush}"/>
        </Style>

        <Style x:Key="IslandPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{DynamicResource IslandAccentFillBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource IslandAccentButtonInkBrush}"/>
            <Setter Property="FontWeight" Value="{DynamicResource IslandSmallLabelWeight}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <!-- Keep the accent fill: the inherited ActionButton hover would otherwise paint the dark hover grey under dark button text. -->
                    <Setter Property="Background" Value="{DynamicResource IslandAccentFillBrush}"/>
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource IslandAccentFillBrush}"/>
                    <Setter Property="Opacity" Value="0.75"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MonitorSelectionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource IslandIconButtonHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource IslandSelectionBorderBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource IslandIconButtonPressedBrush}"/>
                </Trigger>
                <Trigger Property="Tag" Value="Selected">
                    <Setter Property="Background" Value="{DynamicResource IslandChipActiveBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource IslandSelectionBorderBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Quick preset button (+5m, Paste, + 1 Bar): same as ActionButton with a pill radius and the chip surface -->
        <Style x:Key="IslandChipButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{DynamicResource IslandChipBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource IslandChipBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5" x:Name="PressRoot">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Covers the TextBlock WPF generates for plain string Content. -->
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CardBodyText}">
                                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PressRoot" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark CheckBox Style -->
        <Style x:Key="ModernDarkCheckBox" TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource IslandCheckFocusVisual}"/>
            <Setter Property="FontFamily" Value="{DynamicResource IslandUiFont}"/>
            <Setter Property="FontWeight" Value="{DynamicResource IslandBodyWeight}"/>
            <Setter Property="Foreground" Value="{DynamicResource IslandInkBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="5" Background="{DynamicResource IslandControlBackgroundBrush}" BorderBrush="{DynamicResource IslandControlBorderBrush}" BorderThickness="1.2" VerticalAlignment="Center" SnapsToDevicePixels="True">
                                <Path x:Name="CheckMark" Data="M0 4.2 L3.1 7.2 L9 0" Stroke="{DynamicResource IslandAccentButtonInkBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <!-- The label's spacing lives on the label, so a checkbox without one is exactly its 16-DIP box (and so is its focus ring). -->
                            <ContentPresenter x:Name="Label" Margin="7,0,2,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasContent" Value="False">
                                <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource IslandAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource IslandAccentFillBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource IslandAccentFillBrush}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill toggle switch -->
        <Style x:Key="ModernToggleSwitch" TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource IslandRoundFocusVisual}"/>
            <Setter Property="FontFamily" Value="{DynamicResource IslandUiFont}"/>
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Track" Width="32" Height="18" CornerRadius="9" Background="{DynamicResource IslandControlBorderBrush}" Padding="2" VerticalAlignment="Center">
                                <Border.RenderTransform>
                                    <TranslateTransform />
                                </Border.RenderTransform>
                                <Ellipse x:Name="Knob" Width="14" Height="14" Fill="{DynamicResource IslandSliderThumbBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Border>
                            <ContentPresenter x:Name="Label" Margin="6,0,2,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasContent" Value="False">
                                <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource IslandAccentFillBrush}" />
                                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource IslandAccentButtonInkBrush}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark RadioButton Style -->
        <Style x:Key="ModernDarkRadioButton" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{StaticResource IslandRoundFocusVisual}"/>
            <Setter Property="FontWeight" Value="{DynamicResource IslandBodyWeight}"/>
            <Setter Property="FontFamily" Value="{DynamicResource IslandUiFont}"/>
            <Setter Property="Foreground" Value="{DynamicResource IslandInkBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="RadioOuter" Width="16" Height="16" CornerRadius="8" Background="{DynamicResource IslandControlBackgroundBrush}" BorderBrush="{DynamicResource IslandControlBorderBrush}" BorderThickness="1.2" VerticalAlignment="Center">
                                <Ellipse x:Name="RadioDot" Width="6" Height="6" Fill="{DynamicResource IslandAccentBrush}" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ContentPresenter x:Name="Label" Margin="6,0,2,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasContent" Value="False">
                                <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RadioOuter" Property="Background" Value="{DynamicResource IslandChipActiveBrush}" />
                                <Setter TargetName="RadioOuter" Property="BorderBrush" Value="{DynamicResource IslandAccentBrush}" />
                                <Setter TargetName="RadioDot" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource IslandInkBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RadioOuter" Property="BorderBrush" Value="{DynamicResource IslandAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark TextBox Style with Rounded Corners -->
        <Style x:Key="ModernDarkTextBox" TargetType="TextBox">
            <Setter Property="FontWeight" Value="{DynamicResource IslandBodyWeight}"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="FontFamily" Value="{DynamicResource IslandUiFont}"/>
            <Setter Property="Background" Value="{DynamicResource IslandControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource IslandInkBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IslandControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{DynamicResource IslandAccentBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource IslandInputFontSize}" />
            <!-- The full hint as a tooltip, so a hint that is still trimmed in a narrow box can be read. -->
            <Setter Property="ToolTip" Value="{Binding Path=(controls:TextBoxHint.Text), RelativeSource={RelativeSource Self}, Converter={x:Static controls:NullIfEmptyConverter.Instance}}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Style="{x:Null}"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"
                                              Margin="{TemplateBinding Padding}" />
                                <!-- Hint: the text host is inset by Padding twice (its own margin and the text view's padding) plus 2 DIPs of
                                     text inset, so the hint takes the same: Margin and Padding from the box, plus 2. This keeps it on the caret. -->
                                <Grid Margin="{TemplateBinding Padding}" IsHitTestVisible="False">
                                    <TextBlock x:Name="Hint" Visibility="Collapsed" IsHitTestVisible="False"
                                               Text="{Binding Path=(controls:TextBoxHint.Text), RelativeSource={RelativeSource TemplatedParent}}"
                                               Foreground="{DynamicResource IslandMutedInkBrush}"
                                               FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                                               Margin="2,0,0,0" Padding="{Binding Padding, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static controls:LeftOnlyPaddingConverter.Instance}}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource IslandAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource IslandAccentBrush}" />
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource IslandSubCardBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark PasswordBox Style with Rounded Corners -->
        <Style x:Key="ModernDarkPasswordBox" TargetType="PasswordBox">
            <Setter Property="FontWeight" Value="{DynamicResource IslandBodyWeight}"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="FontFamily" Value="{DynamicResource IslandUiFont}"/>
            <Setter Property="Background" Value="{DynamicResource IslandControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource IslandInkBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IslandControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{DynamicResource IslandAccentBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource IslandInputFontSize}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Style="{x:Null}"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource IslandAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource IslandAccentBrush}" />
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource IslandSubCardBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark Slider Style -->
        <Style x:Key="ModernDarkSlider" TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{StaticResource IslandFocusVisual}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource IslandControlBorderBrush}" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource IslandAccentBrush}" VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Ellipse Width="12" Height="12" Fill="{DynamicResource IslandSliderThumbBrush}" Stroke="{DynamicResource IslandAccentBrush}" StrokeThickness="2" Cursor="Hand" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Sleek Modern ScrollBar / ScrollViewer Styling -->
        <Style x:Key="ModernScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="true" />
            <Setter Property="IsTabStop" Value="false" />
            <Setter Property="Focusable" Value="false" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border CornerRadius="2" Background="{DynamicResource IslandScrollBarThumbBrush}" Opacity="0.85" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Thumb}">
                                <Border CornerRadius="2" Background="{DynamicResource IslandScrollBarThumbHoverBrush}" Opacity="1.0" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernScrollBar" TargetType="{x:Type ScrollBar}">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="true" />
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="4" />
                    <Setter Property="Height" Value="Auto" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="true">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ModernScrollBarThumb}" />
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="4" />
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="false">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ModernScrollBarThumb}" />
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernCardScrollViewer" TargetType="{x:Type ScrollViewer}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Column="0" Grid.Row="0" Margin="{TemplateBinding Padding}" CanContentScroll="{TemplateBinding CanContentScroll}" />
                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Grid.Row="0" Margin="3,0,0,0"
                                       Style="{StaticResource ModernScrollBar}"
                                       Orientation="Vertical"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                            <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Column="0" Grid.Row="1" Margin="0,3,0,0"
                                       Style="{StaticResource ModernScrollBar}"
                                       Orientation="Horizontal"
                                       Value="{TemplateBinding HorizontalOffset}"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Modern Dark ComboBox Style -->
        <Style x:Key="ModernDarkComboBox" TargetType="ComboBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource IslandFocusVisual}"/>
            <Setter Property="FontWeight" Value="{DynamicResource IslandBodyWeight}"/>
            <Setter Property="FontFamily" Value="{DynamicResource IslandUiFont}"/>
            <Setter Property="Foreground" Value="{DynamicResource IslandInkBrush}" />
            <Setter Property="Background" Value="{DynamicResource IslandControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IslandControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="{DynamicResource IslandInputFontSize}" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border" CornerRadius="6" Background="{DynamicResource IslandControlBackgroundBrush}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="20" />
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource IslandMutedInkBrush}" Data="M0 0 L4 4 L8 0 Z" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="true">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource IslandAccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="8,3,24,3"
                                              VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}" LayoutTransform="{DynamicResource IslandInterfaceScaleTransform}">
                                    <Border x:Name="DropDownBorder" Background="{DynamicResource IslandSubCardBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource IslandSubCardBorderBrush}" CornerRadius="6" Margin="0,2,0,0">
                                        <ScrollViewer Margin="4,6" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource IslandAccentBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource ActionButton}"/>
<Style TargetType="TextBox" BasedOn="{StaticResource ModernDarkTextBox}"/>
<Style TargetType="PasswordBox" BasedOn="{StaticResource ModernDarkPasswordBox}"/>
<Style TargetType="ComboBox" BasedOn="{StaticResource ModernDarkComboBox}"/>
<Style TargetType="CheckBox" BasedOn="{StaticResource ModernDarkCheckBox}"/>
<Style TargetType="ContextMenu"><Setter Property="FontFamily" Value="{DynamicResource IslandUiFont}"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource IslandInkBrush}"/><Setter Property="Background" Value="{DynamicResource IslandSurfaceBrush}"/></Style>

        <!-- Rounded ToolTip: no default boxy chrome or system shadow -->
        <Style TargetType="ToolTip">
            <Setter Property="FontFamily" Value="{DynamicResource IslandUiFont}"/>
            <Setter Property="FontWeight" Value="{DynamicResource IslandBodyWeight}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource IslandInkBrush}"/>
            <Setter Property="Background" Value="{DynamicResource IslandSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource IslandSubCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
            <Setter Property="LayoutTransform" Value="{DynamicResource IslandInterfaceScaleTransform}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded ComboBox popup items (theme hover/selection instead of system blue) -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="FontFamily" Value="{DynamicResource IslandUiFont}"/>
            <Setter Property="FontWeight" Value="{DynamicResource IslandBodyWeight}"/>
            <Setter Property="Foreground" Value="{DynamicResource IslandInkBrush}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource IslandTabHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource IslandChipActiveBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Default rounded ProgressBar; explicit styles/templates on specific bars still win -->
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Background" Value="{DynamicResource IslandTrackBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource IslandAccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot" SnapsToDevicePixels="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                            <Border x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded RadioButton, Slider and thin ScrollBar everywhere, not only where a style is set by hand -->
        <Style TargetType="RadioButton" BasedOn="{StaticResource ModernDarkRadioButton}"/>
        <Style TargetType="Slider" BasedOn="{StaticResource ModernDarkSlider}"/>
        <Style TargetType="ScrollViewer" BasedOn="{StaticResource ModernCardScrollViewer}"/>
</ResourceDictionary>
    </Application.Resources>
</Application>
