<Window x:Class="MochiDock.Views.Settings.AdvancedSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MochiDock Settings"
        Width="900" Height="620" MinWidth="760" MinHeight="520"
        WindowStartupLocation="Manual"
        ShowInTaskbar="True" Topmost="False" ResizeMode="CanResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource IslandGroundBrush}"
        FontFamily="{DynamicResource IslandUiFont}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale">
    <!-- SettingsRoot carries the interface size (LayoutTransform), set in code from the view model's effective scale. -->
    <Grid x:Name="SettingsRoot">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource IslandSurfaceBrush}" BorderBrush="{DynamicResource IslandBorderBrush}" BorderThickness="0,0,1,0">
            <ListBox x:Name="SidebarList" Background="Transparent" BorderThickness="0" Padding="10,14"
                     ItemContainerStyle="{StaticResource SettingsSidebarItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Settings sections"
                     SelectionChanged="SidebarList_SelectionChanged">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <!-- Category heading (Dock, Integrations, Features, Data): one palette colour per group plus a marker, so the groups are easy to spot. -->
                                <StackPanel Orientation="Horizontal" Margin="12,16,0,6">
                                    <Border Width="3" Height="12" CornerRadius="1.5" Background="{Binding Foreground, ElementName=GroupLabel}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="GroupLabel" Text="{Binding Name}" FontWeight="{DynamicResource IslandPrimaryReadingWeight}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CardSectionLabel}">
                                                <Setter Property="Foreground" Value="{DynamicResource IslandMutedInkBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Name}" Value="Dock"><Setter Property="Foreground" Value="{DynamicResource IslandBlueBrush}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Name}" Value="Integrations"><Setter Property="Foreground" Value="{DynamicResource IslandGreenBrush}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Name}" Value="Features"><Setter Property="Foreground" Value="{DynamicResource IslandPurpleBrush}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Name}" Value="Data"><Setter Property="Foreground" Value="{DynamicResource IslandWarningBrush}"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Style="{StaticResource CardBodyText}" FontSize="13"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Column="1" Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="32,26,32,10">
                <TextBlock x:Name="SectionTitle" Style="{StaticResource SettingsSectionTitle}"/>
                <TextBlock x:Name="SectionDescription" Style="{StaticResource SettingsRowDescription}" Margin="0,4,0,0"/>
            </StackPanel>
            <!-- The scroll viewport clips its content, and the keyboard focus ring (IslandFocusVisual) draws 2 DIPs outside each control:
                 SectionHost's 4-DIP margin keeps the ring visible while the content still lines up with the 32-DIP header. -->
            <ScrollViewer x:Name="SectionScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,0,28,20">
                <ContentPresenter x:Name="SectionHost" Margin="4"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
