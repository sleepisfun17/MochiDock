<UserControl x:Class="MochiDock.Views.Settings.Sections.DataSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:MochiDock.Views.Settings">
    <StackPanel>
        <TextBlock Style="{StaticResource SettingsGroupHeader}" Text="Updates" Margin="0,0,0,2"/>
        <s:SettingRow Label="Updates" Description="MochiDock asks GitHub for a newer release and tells you. Update now downloads the release's setup, checks it against the checksum GitHub publishes, installs it silently and restarts MochiDock; nothing is installed without your click.">
            <StackPanel>
                <TextBlock Text="{Binding UpdateStatusText}" Style="{StaticResource CardCaptionText}" TextWrapping="Wrap" MaxWidth="300" Margin="0,0,0,6"/>
                <TextBlock Text="{Binding UpdateInstallHint}" Style="{StaticResource CardCaptionText}" Foreground="{DynamicResource IslandMutedInkBrush}" TextWrapping="Wrap" MaxWidth="300" Margin="0,0,0,6"
                           Visibility="{Binding HasUpdateInstallHint, Converter={StaticResource BoolToVisibility}}"/>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ActionButton}" Content="Check now" Click="CheckUpdates_Click" Margin="0"/>
                    <Button Style="{StaticResource IslandPrimaryButtonStyle}" Content="Update now" Click="InstallUpdate_Click" Margin="8,0,0,0"
                            Visibility="{Binding CanInstallUpdate, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Install the update now"/>
                    <Button Style="{StaticResource ActionButton}" Content="Cancel" Click="CancelUpdate_Click" Margin="8,0,0,0"
                            Visibility="{Binding IsUpdateDownloading, Converter={StaticResource BoolToVisibility}}"/>
                    <Button Style="{StaticResource ActionButton}" Content="View release" Click="ViewRelease_Click" Margin="8,0,0,0"
                            Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </StackPanel>
        </s:SettingRow>
        <s:SettingRow Label="Check for updates automatically" Description="At startup and every 12 hours. Only a generic request to GitHub is sent; nothing about you or your PC.">
            <CheckBox x:Name="AutoUpdateCheck" Style="{StaticResource ModernDarkCheckBox}" Checked="AutoUpdate_Changed" Unchecked="AutoUpdate_Changed"/>
        </s:SettingRow>

        <TextBlock Style="{StaticResource SettingsGroupHeader}" Text="Backup and files" Margin="0,18,0,2"/>
        <s:SettingRow Label="Export settings" Description="Save your settings and tasks to a file for another PC. Passwords, keys and values that belong to this PC (monitor, positions, ports, startup) stay here.">
            <Button Style="{StaticResource ActionButton}" Content="Export…" Click="Export_Click" Margin="0"/>
        </s:SettingRow>
        <s:SettingRow x:Name="ImportRow" Label="Import settings" Description="Load an export or an older settings.json. This PC keeps its own monitor, position, port and startup values; tasks are added or updated, and your other tasks stay.">
            <Button Style="{StaticResource ActionButton}" Content="Import…" Click="Import_Click" Margin="0"/>
        </s:SettingRow>
        <s:SettingRow x:Name="ReloadRow" Label="Reload settings" Description="Read settings.json from disk again, for example after editing it by hand.">
            <Button Style="{StaticResource ActionButton}" Content="Reload" Click="Reload_Click" Margin="0"/>
        </s:SettingRow>
        <s:SettingRow Label="Settings file" Description="Show settings.json in Explorer.">
            <Button Style="{StaticResource ActionButton}" Content="Show file" Click="ShowSettingsFile_Click" Margin="0"/>
        </s:SettingRow>
        <s:SettingRow Label="Data folder" Description="Caches, the WhatsApp session and other local data.">
            <Button Style="{StaticResource ActionButton}" Content="Open folder" Click="OpenDataFolder_Click" Margin="0"/>
        </s:SettingRow>

        <TextBlock Style="{StaticResource SettingsGroupHeader}" Text="Diagnostics" Margin="0,18,0,2"/>
        <s:SettingRow Label="Diagnostic logs" Description="Failures that would otherwise be hidden are written here.">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="IssueCountText" Style="{StaticResource CardCaptionText}" Foreground="{DynamicResource IslandWarningBrush}" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed"/>
                <Button Style="{StaticResource ActionButton}" Content="Open logs" Click="OpenLogs_Click" Margin="0"/>
            </StackPanel>
        </s:SettingRow>
        <s:SettingRow Label="Integrations" Description="WhatsApp and Outlook connection state.">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding IntegrationStatus}" Style="{StaticResource CardCaptionText}" VerticalAlignment="Center" Margin="0,0,10,0" MaxWidth="260" TextWrapping="Wrap"/>
                <Button Style="{StaticResource ActionButton}" Content="↻ Reconnect" Click="Reconnect_Click" Margin="0"/>
            </StackPanel>
        </s:SettingRow>
    </StackPanel>
</UserControl>
