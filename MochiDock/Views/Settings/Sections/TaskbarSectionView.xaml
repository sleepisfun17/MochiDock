<s:SettingsSectionBase x:Class="MochiDock.Views.Settings.Sections.TaskbarSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:MochiDock.Views.Settings"
             xmlns:controls="clr-namespace:MochiDock.Controls">
    <StackPanel>
        <!-- Live preview bar -->
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource SettingsGroupHeader}" Text="Live preview" Margin="0"/>
                <TextBlock Style="{StaticResource CardCaptionText}" Text="Shows how your Left and Right taskbar strips look on a dark or light Windows taskbar."/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="PreviewDarkBtn" Style="{StaticResource MonitorSelectionButton}" Content="Dark" Padding="10,4" FontSize="11" Tag="Selected" Click="PreviewTheme_Click" AutomationProperties.Name="Preview on dark taskbar"/>
                <Button x:Name="PreviewLightBtn" Style="{StaticResource MonitorSelectionButton}" Content="Light" Padding="10,4" FontSize="11" Margin="8,0,0,0" Click="PreviewTheme_Click" AutomationProperties.Name="Preview on light taskbar"/>
            </StackPanel>
        </Grid>
        <Border x:Name="PreviewBar" Height="52" CornerRadius="8" Padding="8,0" Margin="0,0,0,14"
                Background="{DynamicResource IslandGroundBrush}" BorderBrush="{DynamicResource IslandSubCardBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="PreviewLeftImage" Grid.Column="0" Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="48" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                <TextBlock x:Name="PreviewEmptyHint" Grid.Column="1" Text="Turn on any item below to preview" Style="{StaticResource CardCaptionText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7" Visibility="Collapsed"/>
                <Image x:Name="PreviewRightImage" Grid.Column="2" Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="48" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
            </Grid>
        </Border>

        <TextBlock Style="{StaticResource SettingsGroupHeader}" Text="Blocks, side and order" Margin="0,0,0,2"/>
        <TextBlock Style="{StaticResource CardCaptionText}" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Choose individual items, place each block on the Left edge or Right side of the taskbar, and reorder blocks within each side. Click a block on the taskbar to open its card, right-click for a menu. All Taskbar settings are kept per PC."/>
        <StackPanel x:Name="BlockOrderList" Margin="0,0,0,6"/>

        <TextBlock Style="{StaticResource SettingsGroupHeader}" Text="Display and placement" Margin="0,16,0,2"/>
        <s:SettingRow Label="Display" Description="Which monitor's taskbar shows the readout (Primary, same monitor as MochiDock, a specific display, or all displays).">
            <ComboBox x:Name="MonitorCombo" Style="{StaticResource ModernDarkComboBox}" Width="240" SelectionChanged="Monitor_Changed" AutomationProperties.Name="Taskbar readout display"/>
        </s:SettingRow>
        <s:SettingRow Label="Right side position" Description="Where Right-side blocks sit: beside the system tray/clock, or right after your pinned and open task buttons.">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="PlaceTrayRadio" Style="{StaticResource ModernDarkRadioButton}" Content="Left of the tray" GroupName="TaskbarPlacement" Checked="Placement_Checked" Margin="0,0,14,0"/>
                <RadioButton x:Name="PlaceTaskButtonsRadio" Style="{StaticResource ModernDarkRadioButton}" Content="After the task buttons" GroupName="TaskbarPlacement" Checked="Placement_Checked"/>
            </StackPanel>
        </s:SettingRow>
        <s:SettingRow x:Name="LeftOffsetRow" Label="Left offset" Description="Horizontal nudge in pixels (−500 to 500) for blocks placed on the Left side.">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ActionButton}" Content="&#x2212;" Width="28" Padding="0,4" Click="LeftOffsetMinus_Click" ToolTip="Move 4 px left" AutomationProperties.Name="Decrease left offset"/>
                <TextBox x:Name="LeftOffsetBox" Style="{StaticResource ModernDarkTextBox}" Width="72" Margin="8,0,0,0" LostFocus="LeftOffsetBox_LostFocus" KeyDown="LeftOffsetBox_KeyDown" AutomationProperties.Name="Left zone offset in pixels"/>
                <Button Style="{StaticResource ActionButton}" Content="+" Width="28" Padding="0,4" Margin="8,0,0,0" Click="LeftOffsetPlus_Click" ToolTip="Move 4 px right" AutomationProperties.Name="Increase left offset"/>
                <TextBlock Text="px" Style="{StaticResource CardCaptionText}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                <Button Style="{StaticResource ActionButton}" Content="Reset" Margin="8,0,0,0" Click="LeftOffsetReset_Click" AutomationProperties.Name="Reset left offset"/>
            </StackPanel>
        </s:SettingRow>
        <s:SettingRow x:Name="OffsetRow" Label="Right offset" Description="Horizontal nudge in pixels (−500 to 500) for blocks placed on the Right side.">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ActionButton}" Content="&#x2212;" Width="28" Padding="0,4" Click="OffsetMinus_Click" ToolTip="Move 4 px left" AutomationProperties.Name="Decrease right offset"/>
                <TextBox x:Name="OffsetBox" Style="{StaticResource ModernDarkTextBox}" Width="72" Margin="8,0,0,0" LostFocus="OffsetBox_LostFocus" KeyDown="OffsetBox_KeyDown" AutomationProperties.Name="Right zone offset in pixels"/>
                <Button Style="{StaticResource ActionButton}" Content="+" Width="28" Padding="0,4" Margin="8,0,0,0" Click="OffsetPlus_Click" ToolTip="Move 4 px right" AutomationProperties.Name="Increase right offset"/>
                <TextBlock Text="px" Style="{StaticResource CardCaptionText}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                <Button Style="{StaticResource ActionButton}" Content="Reset" Margin="8,0,0,0" Click="OffsetReset_Click" AutomationProperties.Name="Reset right offset"/>
            </StackPanel>
        </s:SettingRow>
        <s:SettingRow x:Name="VerticalOffsetRow" Label="Vertical offset" Description="Fine vertical adjustment in pixels (−24 to 24), useful for custom-padded Windhawk taskbars.">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ActionButton}" Content="&#x2212;" Width="28" Padding="0,4" Click="VerticalOffsetMinus_Click" ToolTip="Move 2 px up" AutomationProperties.Name="Move readout up"/>
                <TextBox x:Name="VerticalOffsetBox" Style="{StaticResource ModernDarkTextBox}" Width="72" Margin="8,0,0,0" LostFocus="VerticalOffsetBox_LostFocus" KeyDown="VerticalOffsetBox_KeyDown" AutomationProperties.Name="Vertical offset in pixels"/>
                <Button Style="{StaticResource ActionButton}" Content="+" Width="28" Padding="0,4" Margin="8,0,0,0" Click="VerticalOffsetPlus_Click" ToolTip="Move 2 px down" AutomationProperties.Name="Move readout down"/>
                <TextBlock Text="px" Style="{StaticResource CardCaptionText}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                <Button Style="{StaticResource ActionButton}" Content="Reset" Margin="8,0,0,0" Click="VerticalOffsetReset_Click" AutomationProperties.Name="Reset vertical offset"/>
            </StackPanel>
        </s:SettingRow>

        <TextBlock Style="{StaticResource SettingsGroupHeader}" Text="Typography and layout" Margin="0,16,0,2"/>
        <s:SettingRow Label="Font" Description="Defaults to the Windows taskbar font (Segoe UI Variable / Segoe UI).">
            <ComboBox x:Name="FontFamilyCombo" Style="{StaticResource ModernDarkComboBox}" Width="240" SelectionChanged="FontFamily_Changed" AutomationProperties.Name="Taskbar readout font"/>
        </s:SettingRow>
        <s:SettingRow Label="Font size" Description="Auto measures the taskbar height (including tall Windhawk taskbars) on every layout.">
            <ComboBox x:Name="FontSizeCombo" Style="{StaticResource ModernDarkComboBox}" Width="180" SelectionChanged="FontSize_Changed" AutomationProperties.Name="Taskbar readout font size"/>
        </s:SettingRow>
        <s:SettingRow Label="Bold text" Description="Draw readout labels and values in bold.">
            <CheckBox x:Name="BoldCheck" IsChecked="{Binding TaskbarFontBold, Mode=TwoWay}" Style="{StaticResource ModernDarkCheckBox}" AutomationProperties.Name="Bold taskbar readout text"/>
        </s:SettingRow>
        <s:SettingRow Label="Block spacing" Description="Gap between adjacent blocks (Auto scales with the font size).">
            <ComboBox x:Name="BlockSpacingCombo" Style="{StaticResource ModernDarkComboBox}" Width="180" SelectionChanged="BlockSpacing_Changed" AutomationProperties.Name="Taskbar block spacing"/>
        </s:SettingRow>
        <s:SettingRow Label="Stable width" Description="Reserve consistent column widths and right-align values so blocks do not shift as numbers change.">
            <CheckBox x:Name="StableWidthCheck" IsChecked="{Binding TaskbarStableWidth, Mode=TwoWay}" Style="{StaticResource ModernDarkCheckBox}" AutomationProperties.Name="Keep stable taskbar block widths"/>
        </s:SettingRow>
        <s:SettingRow Label="Compact labels" Description="Use short C / G / M / D labels instead of CPU / GPU / MEM / DISK.">
            <CheckBox x:Name="CompactLabelsCheck" IsChecked="{Binding TaskbarCompactLabels, Mode=TwoWay}" Style="{StaticResource ModernDarkCheckBox}" AutomationProperties.Name="Use compact taskbar labels"/>
        </s:SettingRow>
        <s:SettingRow Label="Refresh interval" Description="How often CPU, GPU, memory, disk and network values update.">
            <ComboBox x:Name="RefreshCombo" Style="{StaticResource ModernDarkComboBox}" Width="140" SelectionChanged="Refresh_Changed" AutomationProperties.Name="Taskbar refresh interval"/>
        </s:SettingRow>

        <Expander Style="{StaticResource SettingsExpander}" IsExpanded="False">
            <Expander.Header>
                <StackPanel>
                    <TextBlock Text="Colours and background" Style="{StaticResource CardSectionLabel}"/>
                    <TextBlock Text="Custom label/value hex colours and taskbar plate" Style="{StaticResource CardCaptionText}" Foreground="{DynamicResource IslandMutedInkBrush}"/>
                </StackPanel>
            </Expander.Header>
            <StackPanel>
                <s:SettingRow x:Name="LabelColorRow" Label="Label colour" Description="Optional #RRGGBB hex for labels (CPU, GPU, MEM, arrows). Leave empty for Auto; adapts automatically if contrast drops below 4.5:1 on a light or dark taskbar.">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="LabelColorSwatch" Width="20" Height="20" CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource IslandControlBorderBrush}" VerticalAlignment="Center"/>
                        <TextBox x:Name="LabelColorBox" Style="{StaticResource ModernDarkTextBox}" Width="96" Margin="8,0,0,0" controls:TextBoxHint.Text="Auto" LostFocus="LabelColor_LostFocus" KeyDown="LabelColor_KeyDown" AutomationProperties.Name="Label hex colour"/>
                        <Button Style="{StaticResource ActionButton}" Content="Auto" Margin="8,0,0,0" Click="LabelColorReset_Click" AutomationProperties.Name="Reset label colour to Auto"/>
                    </StackPanel>
                </s:SettingRow>
                <s:SettingRow x:Name="ValueColorRow" Label="Value colour" Description="Optional #RRGGBB hex for numbers and values. Warning lines always turn red at their alert threshold.">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="ValueColorSwatch" Width="20" Height="20" CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource IslandControlBorderBrush}" VerticalAlignment="Center"/>
                        <TextBox x:Name="ValueColorBox" Style="{StaticResource ModernDarkTextBox}" Width="96" Margin="8,0,0,0" controls:TextBoxHint.Text="Auto" LostFocus="ValueColor_LostFocus" KeyDown="ValueColor_KeyDown" AutomationProperties.Name="Value hex colour"/>
                        <Button Style="{StaticResource ActionButton}" Content="Auto" Margin="8,0,0,0" Click="ValueColorReset_Click" AutomationProperties.Name="Reset value colour to Auto"/>
                    </StackPanel>
                </s:SettingRow>
                <s:SettingRow Label="Background behind taskbar text" Description="Draw a plate behind the readout so it stays readable on transparent or restyled taskbars.">
                    <CheckBox IsChecked="{Binding ShowDeviceBatteryBackground, Mode=TwoWay}" Style="{StaticResource ModernDarkCheckBox}" AutomationProperties.Name="Background behind the taskbar readout"/>
                </s:SettingRow>
            </StackPanel>
        </Expander>

        <Expander Style="{StaticResource SettingsExpander}" IsExpanded="False">
            <Expander.Header>
                <StackPanel>
                    <TextBlock Text="Per-block formatting" Style="{StaticResource CardSectionLabel}"/>
                    <TextBlock Text="Network arrows/units, Prayer countdown windows, Weather icon and Battery layout" Style="{StaticResource CardCaptionText}" Foreground="{DynamicResource IslandMutedInkBrush}"/>
                </StackPanel>
            </Expander.Header>
            <StackPanel>
                <TextBlock Style="{StaticResource SettingsGroupHeader}" Text="Network" Margin="0,4,0,2"/>
                <s:SettingRow Label="Network arrows" Description="Arrow style used for upload and download rates.">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ArrowClassicRadio" Style="{StaticResource ModernDarkRadioButton}" Content="↑ ↓" GroupName="TaskbarArrows" Checked="Arrows_Checked" Margin="0,0,14,0"/>
                        <RadioButton x:Name="ArrowTriangleRadio" Style="{StaticResource ModernDarkRadioButton}" Content="▲ ▼" GroupName="TaskbarArrows" Checked="Arrows_Checked" Margin="0,0,14,0"/>
                        <RadioButton x:Name="ArrowEmojiRadio" Style="{StaticResource ModernDarkRadioButton}" GroupName="TaskbarArrows" Checked="Arrows_Checked">
                            <TextBlock controls:Emoji.Text="🔼 🔽" VerticalAlignment="Center"/>
                        </RadioButton>
                    </StackPanel>
                </s:SettingRow>
                <s:SettingRow Label="Network speed unit" Description="Show network throughput in bytes per second (KB/s, MB/s) or bits per second (Kb/s, Mb/s).">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="UnitBytesRadio" Style="{StaticResource ModernDarkRadioButton}" Content="Bytes (KB/s, MB/s)" GroupName="TaskbarNetUnit" Checked="NetUnit_Checked" Margin="0,0,14,0"/>
                        <RadioButton x:Name="UnitBitsRadio" Style="{StaticResource ModernDarkRadioButton}" Content="Bits (Kb/s, Mb/s)" GroupName="TaskbarNetUnit" Checked="NetUnit_Checked"/>
                    </StackPanel>
                </s:SettingRow>
                <s:SettingRow Label="Swap upload and download" Description="Show download on the top line and upload on the bottom line.">
                    <CheckBox x:Name="SwapNetCheck" IsChecked="{Binding TaskbarSwapNetworkLines, Mode=TwoWay}" Style="{StaticResource ModernDarkCheckBox}" AutomationProperties.Name="Swap upload and download lines"/>
                </s:SettingRow>

                <TextBlock Style="{StaticResource SettingsGroupHeader}" Text="Prayer" Margin="0,12,0,2"/>
                <s:SettingRow Label="Next prayer display" Description="Show the scheduled time, remaining countdown, or both.">
                    <ComboBox x:Name="PrayerDisplayCombo" Style="{StaticResource ModernDarkComboBox}" Width="260" SelectionChanged="PrayerDisplay_Changed" AutomationProperties.Name="Next prayer taskbar display"/>
                </s:SettingRow>
                <s:SettingRow Label="Countdown before prayer" Description="Highlight and show 'in Xm' (even in Time only mode) when the next prayer is within this window.">
                    <ComboBox x:Name="PrayerApproachCombo" Style="{StaticResource ModernDarkComboBox}" Width="180" SelectionChanged="PrayerApproach_Changed" AutomationProperties.Name="Countdown window before next prayer"/>
                </s:SettingRow>
                <s:SettingRow Label="Show current prayer after start" Description="Show the ongoing prayer and elapsed time (for example 'Asr / +5m') for this long after it begins.">
                    <ComboBox x:Name="PrayerElapsedCombo" Style="{StaticResource ModernDarkComboBox}" Width="180" SelectionChanged="PrayerElapsed_Changed" AutomationProperties.Name="Show current prayer elapsed duration"/>
                </s:SettingRow>

                <TextBlock Style="{StaticResource SettingsGroupHeader}" Text="Weather and batteries" Margin="0,12,0,2"/>
                <s:SettingRow Label="Weather icon" Description="Draw the taskbar weather icon as a colour emoji or monochrome taskbar ink.">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="WeatherIconEmojiRadio" Style="{StaticResource ModernDarkRadioButton}" GroupName="TaskbarWeatherIcon" Checked="WeatherIcon_Checked" Margin="0,0,14,0">
                            <TextBlock controls:Emoji.Text="⛅ Colour emoji" VerticalAlignment="Center"/>
                        </RadioButton>
                        <RadioButton x:Name="WeatherIconMonoRadio" Style="{StaticResource ModernDarkRadioButton}" Content="☁ Monochrome" GroupName="TaskbarWeatherIcon" Checked="WeatherIcon_Checked"/>
                    </StackPanel>
                </s:SettingRow>
                <s:SettingRow Label="Device battery layout" Description="Auto uses the classic single-row size for 1 device and stacks 2+ devices top and bottom; Side by side always keeps devices on one row.">
                    <ComboBox x:Name="BatteryLayoutCombo" Style="{StaticResource ModernDarkComboBox}" Width="220" SelectionChanged="BatteryLayout_Changed" AutomationProperties.Name="Device battery taskbar layout"/>
                </s:SettingRow>
            </StackPanel>
        </Expander>
    </StackPanel>
</s:SettingsSectionBase>
