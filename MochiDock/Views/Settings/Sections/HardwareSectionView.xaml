<s:SettingsSectionBase x:Class="MochiDock.Views.Settings.Sections.HardwareSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:MochiDock.Views.Settings"
             xmlns:controls="clr-namespace:MochiDock.Controls">
    <StackPanel>
        <!-- Alerts -->
        <TextBlock Style="{StaticResource SettingsGroupHeader}" Text="Alerts" Margin="0,0,0,2"/>
        <s:SettingRow Label="Hardware alerts" Description="Show a notice when CPU, GPU or temperature stay above the thresholds below. Alerts use measured readings only.">
            <CheckBox IsChecked="{Binding EnableHardwareAlerts, Mode=TwoWay}" Style="{StaticResource ModernDarkCheckBox}"/>
        </s:SettingRow>
        <s:SettingRow Label="CPU usage threshold" Description="Alert when CPU usage stays above this level." IsEnabled="{Binding EnableHardwareAlerts}">
            <StackPanel Orientation="Horizontal">
                <Slider x:Name="CpuSlider" Style="{StaticResource ModernDarkSlider}" Width="200" Minimum="50" Maximum="100" ValueChanged="Threshold_Changed"/>
                <TextBlock Text="{Binding Value, ElementName=CpuSlider, StringFormat='{}{0:0}%'}" Style="{StaticResource CardCaptionText}" Width="44" TextAlignment="Right" VerticalAlignment="Center"/>
            </StackPanel>
        </s:SettingRow>
        <s:SettingRow Label="GPU usage threshold" Description="Alert when GPU usage stays above this level." IsEnabled="{Binding EnableHardwareAlerts}">
            <StackPanel Orientation="Horizontal">
                <Slider x:Name="GpuSlider" Style="{StaticResource ModernDarkSlider}" Width="200" Minimum="50" Maximum="100" ValueChanged="Threshold_Changed"/>
                <TextBlock Text="{Binding Value, ElementName=GpuSlider, StringFormat='{}{0:0}%'}" Style="{StaticResource CardCaptionText}" Width="44" TextAlignment="Right" VerticalAlignment="Center"/>
            </StackPanel>
        </s:SettingRow>
        <s:SettingRow Label="Temperature threshold" Description="Alert when a measured CPU or GPU temperature stays above this level for a few seconds. The CPU temperature is only measured with the PawnIO driver; an estimate never alerts." IsEnabled="{Binding EnableHardwareAlerts}">
            <StackPanel Orientation="Horizontal">
                <Slider x:Name="TempSlider" Style="{StaticResource ModernDarkSlider}" Width="200" Minimum="60" Maximum="100" ValueChanged="Threshold_Changed"/>
                <TextBlock Text="{Binding Value, ElementName=TempSlider, StringFormat='{}{0:0} °C'}" Style="{StaticResource CardCaptionText}" Width="44" TextAlignment="Right" VerticalAlignment="Center"/>
            </StackPanel>
        </s:SettingRow>
        <s:SettingRow Label="Sustained heat" Description="Also alert once when a measured CPU or GPU temperature stays at or above this level for the whole time chosen, for example during a long game. Mochi looks hot while it lasts." IsEnabled="{Binding EnableHardwareAlerts}">
            <StackPanel Orientation="Horizontal">
                <Slider x:Name="HeatSlider" Style="{StaticResource ModernDarkSlider}" Width="140" Minimum="60" Maximum="95" ValueChanged="Heat_Changed" AutomationProperties.Name="Sustained heat temperature"/>
                <TextBlock Text="{Binding Value, ElementName=HeatSlider, StringFormat='{}{0:0} °C'}" Style="{StaticResource CardCaptionText}" Width="44" TextAlignment="Right" VerticalAlignment="Center"/>
                <ComboBox x:Name="HeatMinutesCombo" Style="{StaticResource ModernDarkComboBox}" Width="90" Margin="8,0,0,0" SelectionChanged="Heat_Changed" AutomationProperties.Name="Sustained heat duration">
                    <ComboBoxItem Content="5 min" Tag="5"/>
                    <ComboBoxItem Content="10 min" Tag="10"/>
                    <ComboBoxItem Content="20 min" Tag="20"/>
                </ComboBox>
            </StackPanel>
        </s:SettingRow>

        <TextBlock Style="{StaticResource SettingsGroupHeader}" Text="History" Margin="0,18,0,2"/>
        <s:SettingRow x:Name="HistoryRow" Label="Keep a 24-hour history" Description="Records CPU and GPU load and temperature and memory once every 15 seconds (one point a minute) for the Stats charts' 24 h view. Paused while the PC is locked or the screen is off. Kept on this PC only, in StatsHistory.json.">
            <StackPanel Orientation="Horizontal">
                <CheckBox IsChecked="{Binding RecordStatsHistory, Mode=TwoWay}" Style="{StaticResource ModernDarkCheckBox}" VerticalAlignment="Center"/>
                <Button Style="{StaticResource ActionButton}" Content="Clear history" Click="ClearHistory_Click" Margin="12,0,0,0"/>
            </StackPanel>
        </s:SettingRow>

        <!-- Wireless devices -->
        <TextBlock Style="{StaticResource SettingsGroupHeader}" Text="CPU sensors" Margin="0,18,0,2"/>
        <s:SettingRow Label="PawnIO driver (optional)" Description="Lets MochiDock read a real CPU temperature and more CPU sensors. Without it the CPU temperature is an estimate (marked ~) and the power total uses Windows' own counters. PawnIO is a separate third-party kernel driver (freeware, its own licence) that you install yourself; MochiDock never installs it.">
            <StackPanel>
                <TextBlock x:Name="PawnIoStatusText" Style="{StaticResource CardCaptionText}" TextWrapping="Wrap" MaxWidth="300" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="PawnIoSiteButton" Style="{StaticResource ActionButton}" Content="Get PawnIO" Click="PawnIoSite_Click" Margin="0"/>
                    <Button x:Name="PawnIoCopyButton" Style="{StaticResource ActionButton}" Content="Copy winget command" Click="PawnIoCopy_Click" Margin="8,0,0,0"/>
                    <Button Style="{StaticResource ActionButton}" Content="Check again" Click="PawnIoCheck_Click" Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </s:SettingRow>

        <TextBlock Style="{StaticResource SettingsGroupHeader}" Text="Wireless devices" Margin="0,18,0,2"/>
        <s:SettingRow Label="Wireless device batteries" Description="Read mouse and keyboard battery levels (Rongyuan/Monsgeek, LAMZU, Bluetooth, standard HID). Shown on the Battery page; a low device gives a silent notice at 15%.">
            <CheckBox IsChecked="{Binding EnableDeviceBatteries, Mode=TwoWay}" Style="{StaticResource ModernDarkCheckBox}"/>
        </s:SettingRow>
        <s:SettingRow Label="Show on taskbar" Description="Show the device batteries next to the system tray. Needs a horizontal taskbar on the primary monitor.">
            <CheckBox IsChecked="{Binding ShowDeviceBatteriesOnTaskbar, Mode=TwoWay}" IsEnabled="{Binding EnableDeviceBatteries}" Style="{StaticResource ModernDarkCheckBox}"/>
        </s:SettingRow>
        <s:SettingRow Label="Background behind taskbar text" Description="Draw a plate behind the taskbar readout so it stays readable on transparent or restyled taskbars.">
            <CheckBox IsChecked="{Binding ShowDeviceBatteryBackground, Mode=TwoWay}" IsEnabled="{Binding ShowDeviceBatteriesOnTaskbar}" Style="{StaticResource ModernDarkCheckBox}"/>
        </s:SettingRow>

        <!-- Power use -->
        <TextBlock Style="{StaticResource SettingsGroupHeader}" Text="Power use" Margin="0,18,0,2"/>
        <s:SettingRow Label="Log power usage" Description="Keep a running estimate of this PC's power use (energy, average and peak) per session and show the last session on the Battery page. About one sample every 10 seconds; stored only on this PC.">
            <CheckBox IsChecked="{Binding EnablePowerLogging, Mode=TwoWay}" Style="{StaticResource ModernDarkCheckBox}"/>
        </s:SettingRow>

        <Border Margin="0,6,0,8" Padding="12" CornerRadius="8" Background="{DynamicResource IslandControlBackgroundBrush}" BorderBrush="{DynamicResource IslandControlBorderBrush}" BorderThickness="1">
            <StackPanel Grid.IsSharedSizeScope="True">
                <!-- Title and actions -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Power estimate" Style="{StaticResource SettingsRowLabel}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource ActionButton}" Content="Detect components" Click="DetectComponents_Click" Margin="0" ToolTip="Find the motherboard, memory sticks and drives in this PC. Your edits are kept."/>
                        <Button Style="{StaticResource ActionButton}" Content="Reset to typical" Click="ResetComponents_Click" Margin="8,0,0,0" ToolTip="Put every part back to its typical wattage and switch it on."/>
                    </StackPanel>
                </Grid>
                <!-- What the numbers are -->
                <TextBlock Style="{StaticResource SettingsRowDescription}" TextWrapping="Wrap" Margin="0,0,0,10"
                           Text="MochiDock measures CPU and GPU power. The rest of the PC (board, memory, drives, fans) has no sensor, so each part listed here adds a typical wattage. Total estimate = measured CPU + GPU + the parts below. It is used on the Battery page's This PC card and in the power log. Detected parts come from Windows; fans can't be detected, so add them yourself."/>

                <!-- Column headers, aligned with the rows through the shared column sizes -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="PowerUse"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="PowerQty"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="PowerWatts"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="PowerSubtotal"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="PowerRemove"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Use" Style="{StaticResource CardCaptionText}" Foreground="{DynamicResource IslandMutedInkBrush}"/>
                    <TextBlock Grid.Column="1" Text="Part" Style="{StaticResource CardCaptionText}" Foreground="{DynamicResource IslandMutedInkBrush}" Margin="10,0,0,0"/>
                    <TextBlock Grid.Column="2" Text="Qty" Style="{StaticResource CardCaptionText}" Foreground="{DynamicResource IslandMutedInkBrush}" Margin="8,0,0,0"/>
                    <TextBlock Grid.Column="3" Text="Watts each" Style="{StaticResource CardCaptionText}" Foreground="{DynamicResource IslandMutedInkBrush}" Margin="8,0,0,0"/>
                    <TextBlock Grid.Column="4" Text="Subtotal" Style="{StaticResource CardCaptionText}" Foreground="{DynamicResource IslandMutedInkBrush}" TextAlignment="Right" Margin="8,0,0,0"/>
                    <Border Grid.Column="5" Width="28"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding PowerComponentItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Enabled}" Value="False"><Setter Property="Opacity" Value="0.5"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PowerUse"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PowerQty"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PowerWatts"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PowerSubtotal"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PowerRemove"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding Enabled, Mode=TwoWay}" Style="{StaticResource ModernDarkCheckBox}" VerticalAlignment="Center" ToolTip="Count this part in the estimate"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource CardBodyText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                    <TextBlock Text="{Binding KindLabel}" Style="{StaticResource CardCaptionText}" Foreground="{DynamicResource IslandMutedInkBrush}"/>
                                </StackPanel>
                                <TextBox Grid.Column="2" Text="{Binding CountText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource ModernDarkTextBox}" Width="44" Margin="8,0,0,0"
                                         KeyDown="ComponentBox_KeyDown" AutomationProperties.Name="Quantity" ToolTip="How many of this part, e.g. 4 fans"/>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0">
                                    <TextBox Text="{Binding WattsText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource ModernDarkTextBox}" Width="60"
                                             KeyDown="ComponentBox_KeyDown" AutomationProperties.Name="Watts each" ToolTip="{Binding WattsTooltip}"/>
                                    <TextBlock Text="W" Style="{StaticResource CardCaptionText}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="4" Text="{Binding SubtotalText}" Style="{StaticResource CardBodyText}" MinWidth="56" TextAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <Button Grid.Column="5" Content="&#x00D7;" FontSize="15" Style="{StaticResource ActionButton}" Click="RemoveComponent_Click" Padding="0" Width="24" Height="24" AutomationProperties.Name="Remove this part" Margin="4,0,0,0" ToolTip="Remove this part"
                                        Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Total -->
                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource IslandControlBorderBrush}" Margin="0,8,0,0" Padding="0,8,0,0">
                    <TextBlock TextWrapping="Wrap" TextAlignment="Right" Style="{StaticResource CardCaptionText}">
                        <Run Text="Other parts: "/><Run Text="{Binding PowerAllowanceTotalText, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource IslandInkBrush}"/><Run Text="{Binding PowerAllowanceHint, Mode=OneWay}"/>
                    </TextBlock>
                </Border>

                <!-- Add a part -->
                <TextBlock Text="Add a part" Style="{StaticResource CardCaptionText}" Foreground="{DynamicResource IslandMutedInkBrush}" Margin="0,12,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="ComponentKindCombo" Style="{StaticResource ModernDarkComboBox}" Width="190" AutomationProperties.Name="Kind of part" ToolTip="What kind of part it is. The typical wattage is filled in for you."/>
                    <TextBox x:Name="ComponentNameBox" Style="{StaticResource ModernDarkTextBox}" Width="190" Margin="8,0,0,0" AutomationProperties.Name="Name of the new part"
                             controls:TextBoxHint.Text="Name (optional)" KeyDown="ComponentName_KeyDown"/>
                    <Button Style="{StaticResource ActionButton}" Content="Add" Click="AddComponent_Click" Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</s:SettingsSectionBase>
