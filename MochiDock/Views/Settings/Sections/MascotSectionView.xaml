<s:SettingsSectionBase x:Class="MochiDock.Views.Settings.Sections.MascotSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:MochiDock.Views.Settings"
             xmlns:controls="clr-namespace:MochiDock.Controls">
    <StackPanel>
        <!-- Live Preview Strip: compact dock diagonal emote (22x19 + 14x14), expanded header corner badge (32x28) and 2x detail -->
        <Border Background="{DynamicResource IslandSubCardBackgroundBrush}"
                BorderBrush="{DynamicResource IslandSubCardBorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,14">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Live preview" Style="{StaticResource CardSectionLabel}"/>
                        <TextBlock Text="Compact dock floats the emote diagonally beside Mochi; expanded dock keeps it in the mascot's own corner."
                                   Style="{StaticResource CardCaptionText}" Foreground="{DynamicResource IslandMutedInkBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ComboBox x:Name="PreviewMoodCombo" Style="{StaticResource ModernDarkComboBox}" Width="210"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              SelectionChanged="PreviewMood_Changed"
                              AutomationProperties.Name="Preview expression"/>
                </Grid>

                <UniformGrid Columns="3">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Background="{DynamicResource IslandGroundBrush}" BorderBrush="{DynamicResource IslandBorderBrush}"
                                BorderThickness="1" CornerRadius="18" Padding="14,9,22,9" HorizontalAlignment="Center" MinHeight="36">
                            <Grid Width="22" Height="19" ClipToBounds="False" VerticalAlignment="Center">
                                <controls:MascotControl x:Name="PreviewCompact" Width="22" Height="19" ShowCornerBadge="False" DisableSpin="True"/>
                                <controls:MascotStatusBadge x:Name="PreviewCompactBadge" Width="14" Height="14" IsOverlay="True" DisablePop="True"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="Compact (22×19)" Style="{StaticResource CardCaptionText}"
                                   Foreground="{DynamicResource IslandMutedInkBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center">
                        <Border Background="{DynamicResource IslandGroundBrush}" BorderBrush="{DynamicResource IslandBorderBrush}"
                                BorderThickness="1" CornerRadius="22" Padding="16,8" HorizontalAlignment="Center" MinHeight="44">
                            <controls:MascotControl x:Name="PreviewExpanded" Width="32" Height="28" DisableSpin="True" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Expanded (32×28)" Style="{StaticResource CardCaptionText}"
                                   Foreground="{DynamicResource IslandMutedInkBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center">
                        <Border Background="{DynamicResource IslandGroundBrush}" BorderBrush="{DynamicResource IslandBorderBrush}"
                                BorderThickness="1" CornerRadius="24" Padding="18,10" HorizontalAlignment="Center" MinHeight="60">
                            <controls:MascotControl x:Name="PreviewLarge" Width="48" Height="42" DisableSpin="True" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Detail (2×)" Style="{StaticResource CardCaptionText}"
                                   Foreground="{DynamicResource IslandMutedInkBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SettingsGroupHeader}" Text="Character" Margin="0,0,0,2"/>
        <s:SettingRow Label="Mascot" Description="Auto is the theme's own mascot: Mochi on Default, Hojicha Mochi on Hojicha, Matcha Mochi on Matcha and Kuro, a black electric cat, on Kuro Night. Any other choice works with every theme; Shiro is a white cat. The same choice is in the dock's quick settings.">
            <ComboBox x:Name="MascotCombo" Style="{StaticResource ModernDarkComboBox}" Width="200" SelectionChanged="Mascot_Changed" AutomationProperties.Name="Mascot"/>
        </s:SettingRow>
        <s:SettingRow Label="Status badge style" Description="Compact dock floats a 14×14 diagonal emote beside the mascot; expanded dock keeps the badge inside the mascot's own corner so header tabs never shift.">
            <WrapPanel Orientation="Horizontal">
                <RadioButton x:Name="BadgeCharmRadio" Style="{StaticResource ModernDarkRadioButton}" Content="3D Charm" Tag="Charm" GroupName="MascotBadgeStyleGroup" Checked="BadgeStyle_Checked" Margin="0,0,14,0"/>
                <RadioButton x:Name="BadgeBubbleRadio" Style="{StaticResource ModernDarkRadioButton}" Content="Speech Bubble" Tag="Bubble" GroupName="MascotBadgeStyleGroup" Checked="BadgeStyle_Checked" Margin="0,0,14,0"/>
                <RadioButton x:Name="BadgeStickerRadio" Style="{StaticResource ModernDarkRadioButton}" Content="3D Sticker" Tag="Sticker" GroupName="MascotBadgeStyleGroup" Checked="BadgeStyle_Checked" Margin="0,0,14,0"/>
                <RadioButton x:Name="BadgeOffRadio" Style="{StaticResource ModernDarkRadioButton}" Content="Off" Tag="Off" GroupName="MascotBadgeStyleGroup" Checked="BadgeStyle_Checked"/>
            </WrapPanel>
        </s:SettingRow>

        <TextBlock Style="{StaticResource SettingsGroupHeader}" Text="Expressions" Margin="0,18,0,2"/>
        <s:SettingRow Label="Expressive Mochi" Description="Mochi shows more faces: angry for an overdue task you ignored, hot or freezing with the weather and a hot GPU, dizzy when the CPU or RAM is maxed out, drained on a low battery. Turn off to keep the simple faces.">
            <CheckBox x:Name="ExpressiveCheck" Style="{StaticResource ModernDarkCheckBox}" Checked="Expressive_Changed" Unchecked="Expressive_Changed"/>
        </s:SettingRow>
        <s:SettingRow x:Name="BirthdayRow" Label="Your birthday" Description="Mochi wears a party hat all day on your birthday. Only the month and day are kept, on this PC.">
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="BirthdayMonthCombo" Style="{StaticResource ModernDarkComboBox}" Width="120" SelectionChanged="Birthday_Changed" AutomationProperties.Name="Birthday month"/>
                <ComboBox x:Name="BirthdayDayCombo" Style="{StaticResource ModernDarkComboBox}" Width="70" Margin="8,0,0,0" SelectionChanged="Birthday_Changed" AutomationProperties.Name="Birthday day"/>
            </StackPanel>
        </s:SettingRow>
    </StackPanel>
</s:SettingsSectionBase>
