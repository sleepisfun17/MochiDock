<UserControl x:Class="MochiDock.Views.Cards.SummaryCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             FontFamily="{DynamicResource IslandUiFont}"
             d:DesignHeight="180" d:DesignWidth="360">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header: Title & Close -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="{Binding SummaryTitle}"
                           Style="{StaticResource CardHeadingText}" />
                <TextBlock Text="{Binding SummarySubtitle}"
                           Style="{StaticResource CardCaptionText}"
                           Margin="0,2,0,0" />
            </StackPanel>

            <Button Style="{StaticResource IslandIconButton}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Click="Close_Click"
                    ToolTip="Dismiss"
                    AutomationProperties.Name="Dismiss summary">
                <Path Data="M 0,0 L 10,10 M 10,0 L 0,10"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.5"
                      Stretch="Uniform"
                      Width="10" Height="10" />
            </Button>
        </Grid>

        <!-- Content Row: Stats & Badges -->
        <StackPanel Grid.Row="1" Orientation="Vertical" VerticalAlignment="Center" Margin="0,4,0,10"
                    Visibility="{Binding ShowSummaryDetails, Converter={StaticResource BoolToVisibility}}">
            <!-- Badges if any notifications -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <!-- WhatsApp Badge -->
                <Border Background="{DynamicResource IslandWhatsAppSubtleBrush}" BorderBrush="{DynamicResource IslandWhatsAppBorderBrush}" BorderThickness="1" CornerRadius="10"
                        Padding="8,4" Margin="0,0,8,0"
                        Visibility="{Binding HasSummaryWhatsApp, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/Icons/whatsapp.png" Width="14" Height="14" Margin="0,0,6,0"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="{Binding SummaryWhatsAppCount, StringFormat='{}{0} WhatsApp'}"
                                   Foreground="{DynamicResource IslandWhatsAppBrush}" FontSize="11" FontWeight="{DynamicResource IslandSmallLabelWeight}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Email Badge -->
                <Border Background="{DynamicResource IslandEmailBadgeBackgroundBrush}" BorderBrush="{DynamicResource IslandSelectionBorderBrush}" BorderThickness="1" CornerRadius="10"
                        Padding="8,4"
                        Visibility="{Binding HasSummaryEmail, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/Icons/email.png" Width="14" Height="14" Margin="0,0,6,0"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="{Binding SummaryEmailCount, StringFormat='{}{0} Mail'}"
                                   Foreground="{DynamicResource IslandEmailBadgeInkBrush}" FontSize="11" FontWeight="{DynamicResource IslandSmallLabelWeight}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Detailed Message / Summary Text (the lock and morning summaries) -->
            <TextBlock Text="{Binding SummaryDetails}"
                       FontSize="12"
                       Foreground="{DynamicResource IslandInkBrush}"
                       TextWrapping="Wrap"
                       LineHeight="16" />
        </StackPanel>

        <!-- A finished game: labelled rows on the left, the session graph on the right (top-aligned, so nothing is cut off) -->
        <Grid Grid.Row="1" Margin="0,2,0,8" VerticalAlignment="Top"
              Visibility="{Binding HasSummaryLines, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ItemsControl ItemsSource="{Binding SummaryLines}" VerticalAlignment="Top">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="66" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}" Style="{StaticResource CardCaptionText}" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <!-- Numbers: a bold value and a small caption each (a warning colour when a value deserves a look) -->
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Stats}"
                                          Visibility="{Binding HasStats, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                            <TextBlock Text="{Binding Value}" FontSize="13" FontWeight="{DynamicResource IslandSmallLabelWeight}" VerticalAlignment="Bottom">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource IslandInkBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Warn}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource IslandWarningBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Caption}" Style="{StaticResource CardCaptionText}" Margin="4,0,0,0" VerticalAlignment="Bottom" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Sentences: the match, the trend, what you missed -->
                            <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12" Foreground="{DynamicResource IslandInkBrush}" TextWrapping="Wrap"
                                       Visibility="{Binding IsPlain, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" Width="272" VerticalAlignment="Top"
                        Visibility="{Binding HasSummaryGraph, Converter={StaticResource BoolToVisibility}}">
                <Border Height="88" Padding="6,6"
                        Background="{DynamicResource IslandSubCardBackgroundBrush}" BorderBrush="{DynamicResource IslandSubCardBorderBrush}" BorderThickness="1" CornerRadius="10">
                    <Canvas x:Name="SessionGraph" Width="260" Height="76" ClipToBounds="True">
                        <Rectangle Canvas.Top="38" Width="260" Height="1" Fill="{DynamicResource IslandChartGridBrush}" />
                        <Path Data="{Binding SummaryStutterGeometry}" Stroke="{DynamicResource IslandWarningBrush}" StrokeThickness="1" Opacity="0.7" />
                        <Polyline Points="{Binding SummaryPingPoints}" Stroke="{DynamicResource IslandBlueBrush}" StrokeThickness="1.2" StrokeLineJoin="Round" Opacity="0.55" />
                        <Polyline Points="{Binding SummaryFpsPoints}" Stroke="{DynamicResource IslandAccentBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" />
                    </Canvas>
                </Border>
                <!-- Time runs left to right over the whole session -->
                <Grid Margin="4,3,4,0">
                    <TextBlock Text="start" Style="{StaticResource CardCaptionText}" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding SummaryGraphDuration}" Style="{StaticResource CardCaptionText}" HorizontalAlignment="Right" />
                </Grid>
                <!-- What each line is, and what its top edge means -->
                <StackPanel Margin="4,6,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="14" Height="2" Fill="{DynamicResource IslandAccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding SummaryGraphFpsLabel}" Style="{StaticResource CardCaptionText}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0" Visibility="{Binding HasSummaryGraphPing, Converter={StaticResource BoolToVisibility}}">
                        <Rectangle Width="14" Height="2" Fill="{DynamicResource IslandBlueBrush}" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding SummaryGraphPingLabel}" Style="{StaticResource CardCaptionText}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0" Visibility="{Binding HasSummaryGraphStutters, Converter={StaticResource BoolToVisibility}}">
                        <Rectangle Width="2" Height="10" Fill="{DynamicResource IslandWarningBrush}" Margin="6,0,12,0" />
                        <TextBlock Text="Stutter (a slow frame)" Style="{StaticResource CardCaptionText}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Bottom Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <!-- WhatsApp Action -->
            <Button Style="{StaticResource IslandSecondaryButtonStyle}" Click="OpenWhatsApp_Click"
                    Visibility="{Binding HasSummaryWhatsApp, Converter={StaticResource BoolToVisibility}}"
                    Foreground="{DynamicResource IslandWhatsAppBrush}" BorderBrush="{DynamicResource IslandWhatsAppBorderBrush}" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/Icons/whatsapp.png" Width="12" Height="12" Margin="0,0,5,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Open WhatsApp" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- Email Action -->
            <Button Style="{StaticResource IslandSecondaryButtonStyle}" Click="OpenMail_Click"
                    Visibility="{Binding HasSummaryEmail, Converter={StaticResource BoolToVisibility}}"
                    Foreground="{DynamicResource IslandAccentBrush}" BorderBrush="{DynamicResource IslandSelectionBorderBrush}" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/Icons/email.png" Width="12" Height="12" Margin="0,0,5,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Open Mail" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- Got it / Dismiss -->
            <Button Style="{StaticResource IslandPrimaryButtonStyle}" Click="Dismiss_Click" Content="Dismiss" Margin="0" />
        </StackPanel>
    </Grid>
</UserControl>
