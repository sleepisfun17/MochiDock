<UserControl x:Class="MochiDock.Views.Cards.WeatherCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="{DynamicResource IslandUiFont}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
        <UserControl.Resources>
    </UserControl.Resources>
    <Grid VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <!-- Row 0: Current Weather Header -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Hourly Forecast Strip -->
            <RowDefinition Height="Auto" />
            <!-- Row 2: 3-Day Forecast Cards -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ROW 0: Current Weather & City -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Weather Visual Icon Box -->
            <Border Grid.Column="0" Width="60" Height="60" CornerRadius="10" Background="{DynamicResource IslandSubCardBackgroundBrush}" BorderBrush="{DynamicResource IslandSubCardBorderBrush}" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                <ContentControl Content="{Binding WeatherInfo}"
                                ContentTemplate="{StaticResource WeatherVectorIconTemplate}"
                                Width="32" Height="32"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>

            <!-- City, Weather Details & Condition -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <!-- Location City Name -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,2">
                    <Image Source="{StaticResource IconLocation}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding WeatherCityDisplay, FallbackValue='Locating…'}" ToolTip="{Binding WeatherCityDisplay}" Foreground="{DynamicResource IslandSecondaryInkBrush}" FontSize="12" FontWeight="{DynamicResource IslandSmallLabelWeight}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Button Content="Change city" Click="ChangeCity_Click" Style="{StaticResource ActionButton}" FontSize="10.5" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="Change weather city in Settings" />
                </StackPanel>

                <!-- Temperature & Wind Speed -->
                <TextBlock Text="{Binding WeatherDisplayText, FallbackValue='Loading Weather...'}" Foreground="{DynamicResource IslandInkBrush}" FontSize="18" FontWeight="{DynamicResource IslandSmallLabelWeight}" Margin="0,0,0,2" />

                <!-- Condition Description -->
                <TextBlock Text="{Binding WeatherConditionText, FallbackValue='Checking forecast...'}" Foreground="{DynamicResource IslandMutedInkBrush}" FontSize="11" />
            </StackPanel>

            <!-- Right Side: Refresh Button -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0">
                <Button Style="{StaticResource IslandSecondaryButtonStyle}"
                        Click="Refresh_Click"
                        ToolTip="Refresh current weather data">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="↻ " FontSize="11" FontWeight="{DynamicResource IslandSmallLabelWeight}" VerticalAlignment="Center" />
                        <TextBlock Text="Refresh" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ROW 1: Hourly Forecast Strip (Next 12 Hours) -->
        <Border Grid.Row="1" Background="{DynamicResource IslandSubCardBackgroundBrush}" CornerRadius="10" Padding="6" Margin="0,0,0,8" BorderBrush="{DynamicResource IslandSubCardBorderBrush}" BorderThickness="1">
            <Grid>
                <ScrollViewer Style="{StaticResource ModernCardScrollViewer}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="HourlyScroll_PreviewMouseWheel">
                    <ItemsControl ItemsSource="{Binding WeatherInfo.HourlyList}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource IslandSurfaceBrush}" CornerRadius="6" Padding="8,6" Margin="0,0,6,0" Width="48">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayTime}" Foreground="{DynamicResource IslandMutedInkBrush}" FontSize="11" HorizontalAlignment="Center" />
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource WeatherVectorIconTemplate}" Width="16" Height="16" Margin="0,3,0,3" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding DisplayTemp}" Foreground="{DynamicResource IslandInkBrush}" FontSize="11" FontWeight="{DynamicResource IslandSmallLabelWeight}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="Hourly forecast unavailable — check connection or city"
                           Foreground="{DynamicResource IslandMutedInkBrush}"
                           FontSize="11.5"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="8,14"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WeatherInfo}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding WeatherInfo.HourlyList.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- ROW 2: 3-Day Forecast Cards -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding WeatherInfo.DailyList}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource IslandSubCardBackgroundBrush}" CornerRadius="10" Padding="10,8" Margin="3,0" BorderBrush="{DynamicResource IslandSubCardBorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DayName}" Foreground="{DynamicResource IslandSecondaryInkBrush}" FontSize="11" FontWeight="{DynamicResource IslandSmallLabelWeight}" />
                                <TextBlock Text="{Binding TempRange}" Foreground="{DynamicResource IslandMutedInkBrush}" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>

                            <ContentControl Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource WeatherVectorIconTemplate}" Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
