<UserControl x:Class="MochiDock.Views.Cards.TodayCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MochiDock.Controls"
             FontFamily="{DynamicResource IslandUiFont}">
    <UserControl.Resources>
        <!-- Standalone style: must not inherit the implicit ActionButton margin/padding, which pushed day cells into their neighbors. -->
        <Style x:Key="DayCellButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Hover" CornerRadius="7" Margin="1.5" Background="{DynamicResource IslandIconButtonHoverBrush}" Opacity="0" IsHitTestVisible="False"/>
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Column: Calendar (Width 290) -->
            <ColumnDefinition Width="290"/>
            <ColumnDefinition Width="14"/>
            <!-- Right Column: Agenda & Tasks -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Column: Calendar Header & Grid -->
        <Border Grid.Column="0" Background="{DynamicResource IslandSubCardBackgroundBrush}" BorderBrush="{DynamicResource IslandSubCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Month & Year Navigation + Holiday Checkboxes -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Month Navigation -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="‹" Click="Previous" Style="{StaticResource IslandSecondaryButtonStyle}" Width="24" Height="24" Padding="0" Margin="0,0,4,0" ToolTip="Previous month" AutomationProperties.Name="Previous month"/>
                        <TextBlock x:Name="MonthLabel" Foreground="{DynamicResource IslandInkBrush}" FontSize="13" FontWeight="{DynamicResource IslandSmallLabelWeight}" VerticalAlignment="Center" Margin="2,0"/>
                        <Button Content="›" Click="Next" Style="{StaticResource IslandSecondaryButtonStyle}" Width="24" Height="24" Padding="0" Margin="4,0,0,0" ToolTip="Next month" AutomationProperties.Name="Next month"/>
                    </StackPanel>

                    <!-- Holiday Country Filters -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="JpHolidayCheck" Content="JP 祝日" IsChecked="{Binding ShowJapanHolidays}" Checked="OnFilterChanged" Unchecked="OnFilterChanged" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <CheckBox x:Name="IdHolidayCheck" Content="ID Libur" Margin="0" IsChecked="{Binding ShowIndonesiaHolidays}" Checked="OnFilterChanged" Unchecked="OnFilterChanged" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- 7x7 Grid: Row 0 = Day of week headers, Rows 1-6 = 42 Calendar Days -->
                <UniformGrid x:Name="DaysPanel" Grid.Row="1" Columns="7" Rows="7"/>
            </Grid>
        </Border>

        <!-- Right Column: Selected Date, Fixed-Height Holiday Status, & Agenda Tasks -->
        <Border Grid.Column="2" Background="{DynamicResource IslandSubCardBackgroundBrush}" BorderBrush="{DynamicResource IslandSubCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Formatted Selected Date: yyyy/MM/dd youbi -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SelectedLabel" Style="{StaticResource CardHeadingText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="1" Content="Today" Click="JumpToToday" Style="{StaticResource IslandSecondaryButtonStyle}" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="Jump back to current date"/>
                </Grid>

                <!-- Row 1: Fixed-height holiday banner (never shifts list layout) -->
                <Border Grid.Row="1" x:Name="HolidayBanner" Background="{DynamicResource IslandWarningSubtleBrush}" CornerRadius="6" Padding="8,3" Margin="0,3,0,3" VerticalAlignment="Center">
                    <TextBlock x:Name="HolidayBannerText" Foreground="{DynamicResource IslandWarningBrush}" FontSize="11" FontWeight="{DynamicResource IslandSmallLabelWeight}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </Border>

                <!-- Row 2: Agenda (calendar events + tasks due that day); scrolls, never changes the card height -->
                <Border Grid.Row="2" Background="{DynamicResource IslandSurfaceBrush}" BorderBrush="{DynamicResource IslandSubCardBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,4,0,6">
                    <Grid>
                        <ScrollViewer Style="{DynamicResource ModernCardScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,6">
                            <ItemsControl x:Name="TaskList" FontFamily="{DynamicResource IslandUiFont}" FontSize="12" Focusable="False" Grid.IsSharedSizeScope="True">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="AgendaTime"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top">
                                                <Ellipse Width="6" Height="6" Fill="{Binding CalendarDotBrush}" Visibility="{Binding CalendarDotVisibility}" VerticalAlignment="Top" Margin="0,4,5,0"/>
                                                <CheckBox IsChecked="{Binding IsDone, Mode=OneWay}" Click="TaskCheck_Click" Visibility="{Binding TaskVisibility}" Style="{StaticResource ModernDarkCheckBox}" VerticalAlignment="Top" Margin="0,0,5,0" ToolTip="Mark done"/>
                                                <TextBlock Text="{Binding TimeText}" FontSize="11" Foreground="{DynamicResource IslandMutedInkBrush}" VerticalAlignment="Top" Margin="0,1,8,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{Binding TitleBrush}" FontWeight="{Binding TitleWeight}" TextDecorations="{Binding TitleDecorations}"/>
                                                <TextBlock Text="{Binding Detail}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{Binding DetailBrush}" Visibility="{Binding DetailVisibility}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                                <Button Content="Join" Tag="{Binding JoinUrl}" Click="JoinMeeting_Click" Visibility="{Binding JoinVisibility}" ToolTip="Open the meeting link"
                                                        Style="{StaticResource IslandPrimaryButtonStyle}" Padding="8,3" Margin="6,0,0,0" VerticalAlignment="Top"/>
                                                <Button Content="✕" Click="DeleteTask_Click" Visibility="{Binding TaskVisibility}" ToolTip="Delete task" AutomationProperties.Name="Delete task"
                                                        Style="{StaticResource IslandIconButton}" Margin="6,0,0,0" VerticalAlignment="Top"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="AgendaEmptyText" Text="Nothing scheduled" FontSize="11" Foreground="{DynamicResource IslandMutedInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <!-- Row 3: Calendar feed status (click opens Settings when not connected) -->
                <TextBlock Grid.Row="3" x:Name="CalendarStatusText" Text="" FontSize="11" Foreground="{DynamicResource IslandMutedInkBrush}" TextTrimming="CharacterEllipsis" Margin="2,0,2,6" MouseLeftButtonUp="CalendarStatus_Click"/>

                <!-- Row 4: Quick add (natural language, e.g. "Review in 30m") and time chips -->
                <StackPanel Grid.Row="4">
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <TextBox x:Name="TaskInputBox" KeyDown="TaskInputBox_KeyDown" AutomationProperties.Name="New task" VerticalAlignment="Center" controls:TextBoxHint.Text="New task, or 'Review in 30m'..."/>
                        </Grid>
                        <Button Grid.Column="1" Style="{StaticResource IslandPrimaryButtonStyle}" Content="+ Add" Click="AddTask_Click" Margin="8,0,0,0"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource IslandChipButtonStyle}" Content="+5m" Click="Chip5m_Click" Margin="0"/>
                        <Button Style="{StaticResource IslandChipButtonStyle}" Content="+15m" Click="Chip15m_Click" Margin="8,0,0,0"/>
                        <Button Style="{StaticResource IslandChipButtonStyle}" Content="+30m" Click="Chip30m_Click" Margin="8,0,0,0"/>
                        <Button Style="{StaticResource IslandChipButtonStyle}" Content="+1h" Click="Chip1h_Click" Margin="8,0,0,0"/>
                        <Button Style="{StaticResource IslandChipButtonStyle}" Content="No time" Click="ChipNoTime_Click" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
