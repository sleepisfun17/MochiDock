<UserControl xmlns:controls="clr-namespace:MochiDock.Controls" x:Class="MochiDock.Views.Cards.DiscordCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             FontFamily="{DynamicResource IslandUiFont}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="75" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Sender / Channel Title Header & Counter Badge -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Discord Blurple Emblem -->
                <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource IslandDiscordBrush}" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Path Width="13" Height="10" Stretch="Uniform" Fill="{DynamicResource IslandDiscordInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M19.27 5.33C17.94 4.71 16.5 4.26 15 4a.09.09 0 0 0-.07.03c-.18.33-.39.76-.53 1.09a16.09 16.09 0 0 0-4.8 0c-.14-.34-.35-.76-.54-1.09-.01-.02-.04-.03-.07-.03-1.5.26-2.93.71-4.27 1.33-.01 0-.02.01-.03.02-2.72 4.07-3.47 8.03-3.1 11.95 0 .02.01.04.03.05 1.8 1.32 3.53 2.12 5.24 2.65.03.01.06 0 .07-.02.4-.55.76-1.13 1.07-1.74.02-.04 0-.08-.04-.09-.57-.22-1.11-.48-1.64-.78-.04-.02-.04-.08-.01-.11.11-.08.22-.17.33-.25.02-.02.05-.02.07-.01 3.44 1.57 7.15 1.57 10.55 0 .02-.01.05-.01.07.01.11.09.22.17.33.26.04.03.04.08-.01.11-.52.31-1.07.56-1.64.78-.04.01-.05.06-.04.09.32.61.68 1.19 1.07 1.74.03.01.06.02.09.02 1.72-.53 3.45-1.33 5.25-2.65.02-.01.03-.03.03-.05.44-4.53-.73-8.46-3.1-11.95-.01-.01-.02-.02-.04-.02zM8.52 14.91c-1.03 0-1.89-.95-1.89-2.12s.84-2.12 1.89-2.12c1.06 0 1.9.96 1.89 2.12 0 1.17-.84 2.12-1.89 2.12zm6.97 0c-1.03 0-1.89-.95-1.89-2.12s.84-2.12 1.89-2.12c1.06 0 1.9.96 1.89 2.12 0 1.17-.83 2.12-1.89 2.12z" />
                </Border>
                <TextBlock Text="{Binding CurrentDiscord.Sender}" ToolTip="{Binding CurrentDiscord.Sender}" Foreground="{DynamicResource IslandInkBrush}" FontSize="13" FontWeight="{DynamicResource IslandSmallLabelWeight}" VerticalAlignment="Center" MaxWidth="210" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding CurrentDiscord.FormattedTime, StringFormat=' · {0}'}" Foreground="{DynamicResource IslandMutedInkBrush}" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0" />
            </StackPanel>

            <!-- Message Counter Badge -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource IslandChipBackgroundBrush}" BorderBrush="{DynamicResource IslandChipBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,3">
                <TextBlock Text="{Binding RecentDiscordMessages.Count, StringFormat='{}{0} messages'}" Foreground="{DynamicResource IslandSecondaryInkBrush}" FontSize="11" FontWeight="{DynamicResource IslandSmallLabelWeight}" />
            </Border>
        </Grid>

        <!-- Vertical Messages Feed (Scrollable with minimalist scrollbar) -->
        <Border Grid.Row="1" Background="{DynamicResource IslandSubCardBackgroundBrush}" CornerRadius="10" Padding="6" Margin="0,0,0,8" BorderBrush="{DynamicResource IslandSubCardBorderBrush}" BorderThickness="1">
            <ScrollViewer x:Name="MessageScrollViewer" 
                          Style="{StaticResource ModernCardScrollViewer}"
                          VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Disabled"
                          PreviewMouseWheel="MessageScrollViewer_PreviewMouseWheel">
                <ItemsControl ItemsSource="{Binding RecentDiscordMessages}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource IslandSurfaceBrush}" CornerRadius="6" BorderBrush="{DynamicResource IslandBorderBrush}" BorderThickness="1"
                                    Margin="0,0,0,4" Padding="8,6" Cursor="Hand" MouseLeftButtonDown="HistoryItem_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Message Details -->
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                            <TextBlock Text="{Binding Sender}" Foreground="{DynamicResource IslandDiscordBrush}" FontSize="11" FontWeight="{DynamicResource IslandSmallLabelWeight}" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding FormattedTime}" Foreground="{DynamicResource IslandMutedInkBrush}" FontSize="11" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock controls:Emoji.Text="{Binding Message}" Foreground="{DynamicResource IslandInkBrush}" FontSize="12" LineHeight="16" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Dismiss Single Item Button -->
                                    <Button Grid.Column="1" VerticalAlignment="Top" Margin="6,0,0,0" Click="DismissItem_Click"
                                            Style="{StaticResource IslandIconButton}" ToolTip="Dismiss message" AutomationProperties.Name="Dismiss message">
                                        <TextBlock Text="✕" Foreground="{DynamicResource IslandMutedInkBrush}" FontSize="11" FontWeight="{DynamicResource IslandSmallLabelWeight}" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Actions: Open Discord & Dismiss -->
        <Grid Grid.Row="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Style="{StaticResource IslandPrimaryButtonStyle}" Content="Open Discord" Click="OpenDiscord_Click" Background="{DynamicResource IslandDiscordBrush}" Foreground="{DynamicResource IslandDiscordInkBrush}" Margin="0" />
                <Button Style="{StaticResource ActionButton}" Content="Dismiss All" Click="Dismiss_Click"  Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
