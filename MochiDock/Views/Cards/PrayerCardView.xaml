<UserControl x:Class="MochiDock.Views.Cards.PrayerCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:MochiDock.Controls"
             mc:Ignorable="d"
             FontFamily="{DynamicResource IslandUiFont}">
    <Grid VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <!-- Row 0: 2-Column Content (Left Details & Countdown | Right Arc & Times) -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Bottom Quick Action Pills (Change Place, Read Quran, Sound Mode) -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ROW 0: horizon arc and next prayer -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="12"/><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: Next Prayer Countdown & City Details -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                <!-- Highlighted Next Prayer Title in Dynamic Theme Accent -->
                <TextBlock Text="{Binding CurrentPrayerSchedule.NextPrayer.Name}" Foreground="{DynamicResource IslandAccentBrush}" FontSize="18" FontWeight="{DynamicResource IslandSmallLabelWeight}" />

                <!-- Big Second-by-Second Countdown Display -->
                <Grid Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition x:Name="CountdownColumn" Width="158"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding CurrentPrayerSchedule.CountdownFullText}" Foreground="{DynamicResource IslandInkBrush}" x:Name="CountdownTextBlock" FontSize="30" FontWeight="Medium" Typography.NumeralAlignment="Tabular" FontFamily="{DynamicResource IslandUiFont}" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock x:Name="NextPrayerScheduledTime" Text="{Binding CurrentPrayerSchedule.NextPrayer.FormattedTime}" Foreground="{DynamicResource IslandInkBrush}" FontSize="15" FontWeight="{DynamicResource IslandSmallLabelWeight}" Typography.NumeralAlignment="Tabular" />
                        <TextBlock Text="{Binding CurrentPrayerSchedule.NextPrayerDayText}" Foreground="{DynamicResource IslandMutedInkBrush}" FontSize="11" />
                    </StackPanel>
                </Grid>

                <!-- City, Hijri date & current lunar phase -->
                <TextBlock Text="{Binding CurrentPrayerSchedule.City}" Foreground="{DynamicResource IslandSecondaryInkBrush}" FontSize="12" FontWeight="{DynamicResource IslandSmallLabelWeight}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                <Grid Margin="0,4,0,0" ToolTip="{Binding CurrentPrayerSchedule.MoonPhaseToolTip, FallbackValue='Current lunar phase'}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:MoonPhaseIcon Grid.Column="0" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,8,0"
                                            CycleFraction="{Binding CurrentPrayerSchedule.MoonCycleFraction, FallbackValue=0.38}"
                                            SouthernHemisphere="{Binding CurrentPrayerSchedule.IsSouthernHemisphere, FallbackValue=False}"
                                            LitBrush="{DynamicResource IslandWarningBrush}"
                                            ShadowBrush="{DynamicResource IslandControlBackgroundBrush}"
                                            OutlineBrush="{DynamicResource IslandMutedInkBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentPrayerSchedule.HijriDate, FallbackValue='From your location'}" Foreground="{DynamicResource IslandHighlightBrush}" FontSize="11" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding CurrentPrayerSchedule.MoonPhaseSummary, FallbackValue='Waxing Gibbous · 78%'}" Foreground="{DynamicResource IslandMutedInkBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- RIGHT: Horizon Arc with 5 Prayers and Qibla / Sunrise header -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <!-- Top Header Info: Imsak, Sunrise/Terbit, Qibla Bearing -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,3">
                    <TextBlock Text="Imsak " Foreground="{DynamicResource IslandMutedInkBrush}" FontSize="11" />
                    <TextBlock Text="{Binding CurrentPrayerSchedule.Imsak.FormattedTime}" Foreground="{DynamicResource IslandSecondaryInkBrush}" FontSize="11" FontWeight="{DynamicResource IslandSmallLabelWeight}" Margin="0,0,8,0" />
                    <TextBlock Text="Shuruq " Foreground="{DynamicResource IslandMutedInkBrush}" FontSize="11" />
                    <TextBlock Text="{Binding CurrentPrayerSchedule.Sunrise.FormattedTime}" Foreground="{DynamicResource IslandSecondaryInkBrush}" FontSize="11" FontWeight="{DynamicResource IslandSmallLabelWeight}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding CurrentPrayerSchedule.QiblaBearingText}" Foreground="{DynamicResource IslandQiblaBrush}" FontSize="11" FontWeight="{DynamicResource IslandSmallLabelWeight}" />
                </StackPanel>

                <!-- Visual-only active prayer / Dhuha period banner -->
                <Border HorizontalAlignment="Right" Margin="0,0,4,4" CornerRadius="6">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Padding" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentPrayerSchedule.HasPeriodBanner, FallbackValue=False}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentPrayerSchedule.IsAnyPeriodActive, FallbackValue=False}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource IslandAccentSubtleBrush}" />
                                    <Setter Property="Padding" Value="6,1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentPrayerSchedule.IsActivePeriodDhuha, FallbackValue=False}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource IslandWarningSubtleBrush}" />
                                    <Setter Property="Padding" Value="6,1" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding CurrentPrayerSchedule.ActivePeriodStatusText}" FontSize="11" ToolTip="{Binding CurrentPrayerSchedule.DhuhaStatusText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Foreground" Value="{DynamicResource IslandMutedInkBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPrayerSchedule.IsAnyPeriodActive, FallbackValue=False}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource IslandAccentBrush}" />
                                        <Setter Property="FontWeight" Value="{DynamicResource IslandSmallLabelWeight}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentPrayerSchedule.IsActivePeriodDhuha, FallbackValue=False}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource IslandWarningBrush}" />
                                        <Setter Property="FontWeight" Value="{DynamicResource IslandSmallLabelWeight}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <!-- Solar horizon arc and live prayer canvas -->
                <Grid Height="100" Margin="0,0,0,0">
                    <Canvas x:Name="ArcCanvas" ClipToBounds="False" Height="84" SizeChanged="ArcCanvas_SizeChanged" SnapsToDevicePixels="False" UseLayoutRounding="False" />
                </Grid>
            </StackPanel>
        </Grid>

        <!-- ROW 1: Bottom Quick Action Pills matching screenshot -->
        <Grid Grid.Row="1" Margin="0,2,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left Actions: Change Place + Read Quran -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource IslandSecondaryButtonStyle}" Content="Change place" Click="ChangePlace_Click" Margin="0" />
                <Button Style="{StaticResource IslandSecondaryButtonStyle}" Click="ReadQuran_Click" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="{StaticResource IconBook}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBlock Text="Read Quran" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel>
                </Button>
            </StackPanel>

            <!-- Right Actions: Sound Mode & Reminder Toggle -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Tone / Silent Segmented Pill -->
                <Border Background="{DynamicResource IslandControlBackgroundBrush}" BorderBrush="{DynamicResource IslandControlBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="2" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SoundToneBtn" Style="{StaticResource ActionButton}" Content="Tone" Click="SoundTone_Click" Background="{DynamicResource IslandControlBackgroundBrush}" Foreground="{DynamicResource IslandInkBrush}" FontWeight="{DynamicResource IslandSmallLabelWeight}" Padding="8,3" Margin="0" ToolTip="Play the prayer chime at prayer time" />
                        <Button x:Name="SoundSilentBtn" Style="{StaticResource ActionButton}" Content="Silent" Click="SoundSilent_Click" Background="Transparent" Padding="8,3" Margin="2,0,0,0" ToolTip="No sound at prayer time" />
                    </StackPanel>
                </Border>

                <!-- 10 min before toggle -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="10 min before" Foreground="{DynamicResource IslandMutedInkBrush}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <CheckBox Style="{StaticResource ModernToggleSwitch}" IsChecked="{Binding EnablePrayerPreNotification, Mode=TwoWay}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock Text="{Binding CurrentPrayerSchedule.Source}" ToolTip="Aladhan (cached): prayer times fetched from Aladhan and saved on this PC. Offline calculations are labeled separately." Foreground="{DynamicResource IslandHighlightBrush}" FontSize="11"/>
            <TextBlock Text="{Binding PrayerError}" Foreground="{DynamicResource IslandNegativeBrush}" TextWrapping="Wrap" FontSize="11"/>
        </StackPanel>    </Grid>
</UserControl>
