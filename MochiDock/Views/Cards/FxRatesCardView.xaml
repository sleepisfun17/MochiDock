<UserControl x:Class="MochiDock.Views.Cards.FxRatesCardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="{DynamicResource IslandUiFont}">
    <UserControl.Resources>
        <Style x:Key="FxPairCardStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="{DynamicResource IslandSubCardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource IslandSubCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" Margin="2" Padding="10,8" CornerRadius="10"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource IslandChipActiveBrush}"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource IslandSelectionBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource IslandSelectionFillBrush}"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource IslandSelectionBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FxSpanRadioStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource IslandMutedInkBrush}"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="{DynamicResource IslandSmallLabelWeight}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Pill" CornerRadius="10" Padding="8,2" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource IslandChipActiveBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource IslandInkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource IslandSelectionFillBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource IslandInkBrush}"/>
                                <Setter Property="FontWeight" Value="{DynamicResource IslandPrimaryReadingWeight}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="2,0,2,6">
            <Border x:Name="HeaderTrendBadge" DockPanel.Dock="Right" CornerRadius="4" Padding="5,1" Background="{DynamicResource IslandChipBackgroundBrush}">
                <TextBlock x:Name="HeaderTrend" Text="— (24h)" FontSize="11" FontWeight="{DynamicResource IslandSmallLabelWeight}"/>
            </Border>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="17" Height="13" Margin="0,0,6,0" CornerRadius="2" Background="{DynamicResource IslandAccentSubtleBrush}" BorderBrush="{DynamicResource IslandAccentBrush}" BorderThickness="1">
                    <TextBlock Text="¥" FontFamily="Segoe UI" FontSize="9" FontWeight="{DynamicResource IslandSmallStrongWeight}" Foreground="{DynamicResource IslandAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                </Border>
                <TextBlock Text="Live FX Rates &amp; Trajectory" Style="{StaticResource CardHeadingText}"/>
            </StackPanel>
        </DockPanel>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,6">
            <RadioButton x:Name="Pair1" Tag="USD/JPY" GroupName="FxPair" Checked="Pair_Checked" Style="{StaticResource FxPairCardStyle}" Margin="0,0,3,0" ToolTip="Select the USD/JPY trajectory">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Margin="0,0,5,0" CornerRadius="3" Padding="4,0" VerticalAlignment="Center" Background="{DynamicResource IslandAccentSubtleBrush}" BorderBrush="{DynamicResource IslandAccentBrush}" BorderThickness="1">
                            <TextBlock x:Name="Pair1Symbols" Text="" FontFamily="Segoe UI" FontSize="9.5" FontWeight="{DynamicResource IslandSmallStrongWeight}" Foreground="{DynamicResource IslandAccentBrush}"/>
                        </Border>
                        <TextBlock x:Name="Pair1Label" Grid.Column="1" Text="USD / JPY" Margin="0,0,4,0" TextTrimming="CharacterEllipsis" FontSize="10.5" FontWeight="{DynamicResource IslandSmallLabelWeight}" Foreground="{DynamicResource IslandSecondaryInkBrush}" VerticalAlignment="Center"/>
                        <Border x:Name="Pair1Badge" Grid.Column="2" CornerRadius="4" Padding="5,1" Background="{DynamicResource IslandChipBackgroundBrush}"><TextBlock x:Name="Pair1Change" Text="—" FontSize="10.5" FontWeight="{DynamicResource IslandSmallLabelWeight}"/></Border>
                    </Grid>
                    <TextBlock x:Name="Pair1Value" Grid.Row="1" Text="—" Margin="0,5,0,0" FontSize="17" FontWeight="{DynamicResource IslandSmallLabelWeight}" Foreground="{DynamicResource IslandInkBrush}"/>
                </Grid>
            </RadioButton>
            <RadioButton x:Name="Pair2" Tag="USD/IDR" GroupName="FxPair" Checked="Pair_Checked" Style="{StaticResource FxPairCardStyle}" Margin="3,0" ToolTip="Select the USD/IDR trajectory">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Margin="0,0,5,0" CornerRadius="3" Padding="4,0" VerticalAlignment="Center" Background="{DynamicResource IslandAccentSubtleBrush}" BorderBrush="{DynamicResource IslandAccentBrush}" BorderThickness="1">
                            <TextBlock x:Name="Pair2Symbols" Text="" FontFamily="Segoe UI" FontSize="9.5" FontWeight="{DynamicResource IslandSmallStrongWeight}" Foreground="{DynamicResource IslandAccentBrush}"/>
                        </Border>
                        <TextBlock x:Name="Pair2Label" Grid.Column="1" Text="USD / IDR" Margin="0,0,4,0" TextTrimming="CharacterEllipsis" FontSize="10.5" FontWeight="{DynamicResource IslandSmallLabelWeight}" Foreground="{DynamicResource IslandSecondaryInkBrush}" VerticalAlignment="Center"/>
                        <Border x:Name="Pair2Badge" Grid.Column="2" CornerRadius="4" Padding="5,1" Background="{DynamicResource IslandChipBackgroundBrush}"><TextBlock x:Name="Pair2Change" Text="—" FontSize="10.5" FontWeight="{DynamicResource IslandSmallLabelWeight}"/></Border>
                    </Grid>
                    <TextBlock x:Name="Pair2Value" Grid.Row="1" Text="—" Margin="0,5,0,0" FontSize="17" FontWeight="{DynamicResource IslandSmallLabelWeight}" Foreground="{DynamicResource IslandInkBrush}"/>
                </Grid>
            </RadioButton>
            <RadioButton x:Name="Pair3" Tag="JPY/IDR" GroupName="FxPair" Checked="Pair_Checked" Style="{StaticResource FxPairCardStyle}" Margin="3,0,0,0" ToolTip="Select the JPY/IDR trajectory">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Margin="0,0,5,0" CornerRadius="3" Padding="4,0" VerticalAlignment="Center" Background="{DynamicResource IslandAccentSubtleBrush}" BorderBrush="{DynamicResource IslandAccentBrush}" BorderThickness="1">
                            <TextBlock x:Name="Pair3Symbols" Text="" FontFamily="Segoe UI" FontSize="9.5" FontWeight="{DynamicResource IslandSmallStrongWeight}" Foreground="{DynamicResource IslandAccentBrush}"/>
                        </Border>
                        <TextBlock x:Name="Pair3Label" Grid.Column="1" Text="JPY / IDR" Margin="0,0,4,0" TextTrimming="CharacterEllipsis" FontSize="10.5" FontWeight="{DynamicResource IslandSmallLabelWeight}" Foreground="{DynamicResource IslandSecondaryInkBrush}" VerticalAlignment="Center"/>
                        <Border x:Name="Pair3Badge" Grid.Column="2" CornerRadius="4" Padding="5,1" Background="{DynamicResource IslandChipBackgroundBrush}"><TextBlock x:Name="Pair3Change" Text="—" FontSize="10.5" FontWeight="{DynamicResource IslandSmallLabelWeight}"/></Border>
                    </Grid>
                    <TextBlock x:Name="Pair3Value" Grid.Row="1" Text="—" Margin="0,5,0,0" FontSize="17" FontWeight="{DynamicResource IslandSmallLabelWeight}" Foreground="{DynamicResource IslandInkBrush}"/>
                </Grid>
            </RadioButton>
        </UniformGrid>

        <Border Grid.Row="2" CornerRadius="10" BorderBrush="{DynamicResource IslandSubCardBorderBrush}" BorderThickness="1" Background="{DynamicResource IslandSurfaceBrush}" Padding="10,7" Margin="2,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="ChartTitle" Text="7-Day Trajectory: JPY / IDR" FontSize="11" FontWeight="{DynamicResource IslandSmallLabelWeight}" Foreground="{DynamicResource IslandSecondaryInkBrush}" VerticalAlignment="Center"/>
                        <Border Margin="10,0,0,0" Background="{DynamicResource IslandGroundBrush}" BorderBrush="{DynamicResource IslandSubCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="Span7DRadio" Content="7D" GroupName="FxSpanGroup" Style="{StaticResource FxSpanRadioStyle}" Checked="Span_Checked" Tag="7D" IsChecked="True"/>
                                <RadioButton x:Name="Span1MRadio" Content="1M" GroupName="FxSpanGroup" Style="{StaticResource FxSpanRadioStyle}" Checked="Span_Checked" Tag="1M"/>
                                <RadioButton x:Name="Span1YRadio" Content="1Y" GroupName="FxSpanGroup" Style="{StaticResource FxSpanRadioStyle}" Checked="Span_Checked" Tag="1Y"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="ChartRange" Text="Low: —  ·  Avg: —  ·  High: —" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10.5" Foreground="{DynamicResource IslandAccentBrush}"/>
                </Grid>
                <Grid Grid.Row="1" Margin="0,5,0,0">
                    <Canvas x:Name="ChartReferenceLayer" IsHitTestVisible="False" ClipToBounds="True">
                        <Line x:Name="AvgLine" Visibility="Collapsed"
                              Stroke="{DynamicResource IslandSecondaryInkBrush}" StrokeThickness="1" StrokeDashArray="3,3" Opacity="0.5"/>
                        <Border x:Name="AvgBadge" Visibility="Collapsed" CornerRadius="4" Padding="5,1"
                                Background="{DynamicResource IslandSurfaceBrush}" BorderBrush="{DynamicResource IslandSubCardBorderBrush}" BorderThickness="1">
                            <TextBlock x:Name="AvgBadgeText" Text="Avg" FontSize="10.5" FontWeight="{DynamicResource IslandSmallLabelWeight}" Foreground="{DynamicResource IslandSecondaryInkBrush}"/>
                        </Border>
                    </Canvas>
                    <Canvas x:Name="Chart" SizeChanged="Chart_SizeChanged" ClipToBounds="True" Background="Transparent"
                            MouseMove="Chart_MouseMove" MouseLeave="Chart_MouseLeave"
                            ToolTip="Available Yahoo samples are spaced evenly. Missing periods and market closures are compressed; original sample timestamps are preserved."/>
                    <Canvas x:Name="ChartHoverLayer" IsHitTestVisible="False" ClipToBounds="True">
                        <Line x:Name="HoverLine" Y1="8" Visibility="Collapsed"
                              Stroke="{DynamicResource IslandAccentBrush}" StrokeThickness="1" StrokeDashArray="2,2" Opacity="0.85"/>
                        <Ellipse x:Name="HoverDot" Width="7" Height="7" Visibility="Collapsed"
                                 Fill="{DynamicResource IslandAccentBrush}" Stroke="{DynamicResource IslandInkBrush}" StrokeThickness="1.5">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="{DynamicResource IslandAccentColor}" BlurRadius="6" ShadowDepth="0" Opacity="0.8"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Border x:Name="HoverTooltip" Visibility="Collapsed">
                            <Grid>
                                <!-- Shadow on a text-free sibling layer so the tooltip text is not rasterized by an effect. -->
                                <Border CornerRadius="6" Background="{DynamicResource IslandSurfaceBrush}" IsHitTestVisible="False">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.6"/>
                                    </Border.Effect>
                                </Border>
                                <Border CornerRadius="6" Padding="7,4"
                                        Background="{DynamicResource IslandSurfaceBrush}" BorderBrush="{DynamicResource IslandSubCardBorderBrush}" BorderThickness="1.2">
                                    <StackPanel>
                                        <TextBlock x:Name="HoverDate" FontSize="10.5" FontWeight="{DynamicResource IslandSmallLabelWeight}" Foreground="{DynamicResource IslandMutedInkBrush}"/>
                                        <TextBlock x:Name="HoverValue" FontSize="11" FontWeight="{DynamicResource IslandSmallLabelWeight}" Foreground="{DynamicResource IslandInkBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Canvas>
                    <TextBlock x:Name="ChartEmpty" Text="Loading 7-day trajectory…" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource IslandMutedInkBrush}"/>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="2,5,2,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="SourceText" Text="Automatic keyless rates · waiting for data" FontSize="10.5" Foreground="{DynamicResource IslandSecondaryInkBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <Button x:Name="RefreshButton" Grid.Column="1" Content="↻" Margin="8,0,0,0" Click="Refresh_Click" Style="{StaticResource IslandIconButton}" FontSize="12" ToolTip="Refresh rates (available once per minute)"/>
        </Grid>
    </Grid>
</UserControl>
