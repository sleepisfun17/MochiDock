<UserControl x:Class="MochiDock.Views.Cards.BatteryModuleView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource IslandUiFont}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Power &amp; Batteries" Style="{StaticResource CardHeadingText}"/>
                <TextBlock Text="This PC and your wireless devices" Style="{StaticResource CardCaptionText}" Foreground="{DynamicResource IslandMutedInkBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="1" Style="{StaticResource IslandIconButton}" Width="28" Height="28" VerticalAlignment="Center"
                    ToolTip="Refresh the battery, power and wireless device readings" AutomationProperties.Name="Refresh" Click="RefreshButton_Click">
                <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource IslandSecondaryInkBrush}"/>
            </Button>
        </Grid>
        <ScrollViewer x:Name="CardsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Style="{DynamicResource ModernCardScrollViewer}" SizeChanged="CardsScroll_SizeChanged">
            <UniformGrid x:Name="CardsPanel" Columns="2" VerticalAlignment="Top"/>
        </ScrollViewer>
    </Grid>
</UserControl>
