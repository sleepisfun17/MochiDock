<UserControl x:Class="MochiDock.Views.Cards.MediaCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:MochiDock.Controls"
             mc:Ignorable="d" 
             FontFamily="{DynamicResource IslandUiFont}">

    <UserControl.Resources><Style x:Key="MediaSeekStyle" TargetType="Slider"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Background="Transparent" Height="22"><Border Height="4" VerticalAlignment="Center" Background="{DynamicResource IslandTrackBrush}" CornerRadius="2"/><Track x:Name="PART_Track"><Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}"><RepeatButton.Template><ControlTemplate><Border Height="4" VerticalAlignment="Center" CornerRadius="2" Background="{DynamicResource IslandAccentBrush}"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Opacity="0"/></Track.IncreaseRepeatButton><Track.Thumb><Thumb x:Name="SeekThumb" Width="12" Height="12" Opacity="0"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{DynamicResource IslandInkBrush}" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SeekThumb" Property="Opacity" Value="1"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="SeekThumb" Property="Opacity" Value="1"/></Trigger><Trigger Property="IsMouseCaptureWithin" Value="True"><Setter TargetName="SeekThumb" Property="Opacity" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></UserControl.Resources>
    <Grid VerticalAlignment="Center" Background="Transparent" PreviewMouseWheel="MediaCard_PreviewMouseWheel">
        <!-- Two columns: player on the left, synced lyrics and pronunciation on the right -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- COL 0: Album Art, Track Title/Artist & Playback Controls -->
        <Grid Grid.Column="0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Album Art -->
            <Border Grid.Column="0" Width="80" Height="80" CornerRadius="10" Background="{DynamicResource IslandSubCardBackgroundBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                <Image Source="{Binding CurrentMedia.AlbumArt}" Stretch="UniformToFill" />
            </Border>

            <!-- Title, Artist, Timeline Scrubber & Controls -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <!-- Smooth Marquee for Long Track Titles -->
                <controls:MarqueeTextBlock Text="{Binding CurrentMedia.Title}" Foreground="{DynamicResource IslandInkBrush}" FontSize="14" FontWeight="{DynamicResource IslandSmallLabelWeight}" MaxWidth="245" />

                <!-- Artist -->
                <TextBlock Text="{Binding CurrentMedia.Artist}" Foreground="{DynamicResource IslandSecondaryInkBrush}" FontSize="12" Margin="0,2,0,6" TextTrimming="CharacterEllipsis" MaxWidth="245" />

                <!-- Interactive Timeline Progress Bar & Scrubber -->
                <Grid Margin="0,0,2,6" Visibility="{Binding CurrentMedia.CanSeek, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="34" />
                    </Grid.ColumnDefinitions>

                    <!-- Current Position -->
                    <TextBlock Grid.Row="0" Grid.Column="0" x:Name="SeekPositionLabel" Text="0:00" Foreground="{DynamicResource IslandMutedInkBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Left" />

                    <!-- Scrubber Slider -->
                    <Slider Grid.Row="0" Grid.Column="1" x:Name="TrackSlider"
                            Margin="4,0"
                            Minimum="0"
                            Maximum="{Binding CurrentMedia.DurationSeconds}"
                            IsEnabled="{Binding CurrentMedia.CanSeek}"
                            Thumb.DragStarted="Seek_DragStarted" Thumb.DragCompleted="Seek_DragCompleted"
                            PreviewMouseMove="TrackSlider_Move" LostMouseCapture="TrackSlider_LostCapture" PreviewKeyDown="TrackSlider_KeyDown"
                            PreviewMouseDown="TrackSlider_PreviewMouseDown"
                            PreviewMouseUp="TrackSlider_PreviewMouseUp"
                            Style="{StaticResource MediaSeekStyle}"
                            VerticalAlignment="Center" />

                    <!-- Total Duration -->
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding CurrentMedia.DurationString}" Foreground="{DynamicResource IslandSecondaryInkBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" />

                    <TextBlock x:Name="SeekErrorText" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,3,0,0" Foreground="{DynamicResource IslandNegativeBrush}" FontSize="11" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Playback Buttons + Audio Output Switcher -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Previous Track -->
                    <Button Style="{StaticResource IslandIconButton}" Width="32" Height="28" Margin="0,0,4,0" Click="PrevButton_Click" ToolTip="Previous Track" AutomationProperties.Name="Previous track">
                        <Path Width="11" Height="11" Stretch="Uniform" Fill="{DynamicResource IslandInkBrush}" 
                              Data="M2,3 L4.5,3 L4.5,13 L2,13 Z M14,3 L5.5,8 L14,13 Z" />
                    </Button>

                    <!-- Play / Pause Button with Dynamic Vector Icon -->
                    <Button Style="{StaticResource IslandIconButton}" Width="38" Height="28" Margin="0,0,4,0" Background="{DynamicResource IslandAccentFillBrush}" Click="PlayPauseButton_Click" ToolTip="Play / Pause" AutomationProperties.Name="Play or pause">
                        <Grid Width="13" Height="13">
                            <!-- Pause Icon (Shown when playing) -->
                            <Path Stretch="Uniform" Fill="{DynamicResource IslandMediaGlyphBrush}"
                                  Visibility="{Binding CurrentMedia.IsPlaying, Converter={StaticResource BoolToVisibility}}"
                                  Data="M3,2 L6,2 L6,14 L3,14 Z M10,2 L13,2 L13,14 L10,14 Z" />
                            <!-- Play Icon (Shown when paused) -->
                            <Path Stretch="Uniform" Fill="{DynamicResource IslandMediaGlyphBrush}"
                                  Visibility="{Binding CurrentMedia.IsPlaying, Converter={StaticResource InverseBoolToVisibility}}"
                                  Data="M4,2 L14,8 L4,14 Z" Margin="1,0,0,0" />
                        </Grid>
                    </Button>

                    <!-- Next Track -->
                    <Button Style="{StaticResource IslandIconButton}" Width="32" Height="28" Margin="0,0,8,0" Click="NextButton_Click" ToolTip="Next Track" AutomationProperties.Name="Next track">
                        <Path Width="11" Height="11" Stretch="Uniform" Fill="{DynamicResource IslandInkBrush}" 
                              Data="M2,3 L10.5,8 L2,13 Z M11.5,3 L14,3 L14,13 L11.5,13 Z" />
                    </Button>

                    <!-- Audio Output Switcher Chip -->
                    <Button Style="{StaticResource ActionButton}" 
                            Background="{DynamicResource IslandSubCardBackgroundBrush}"
                            Padding="8,4"
                            Click="AudioSwitch_Click" 
                            MouseRightButtonUp="AudioSwitch_RightClick" ToolTip="Click to switch to the next audio output. Right-click to choose one from the list.">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Width="12" Height="12" Source="pack://application:,,,/Assets/Icons/headphone.png" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,5,0" />
                            <TextBlock Text="{Binding CurrentAudioDeviceName}" FontSize="11" Foreground="{DynamicResource IslandInkBrush}" MaxWidth="90" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- COL 1: Vertical Divider -->
        <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource IslandSubCardBorderBrush}" VerticalAlignment="Stretch" Margin="6,2" />

        <!-- COL 2: synced lyrics with word-aligned pronunciation -->
        <Grid Grid.Column="2">
        <Grid VerticalAlignment="Center" Margin="6,0,4,0">
            <!-- When Lyrics are Synced -->
            <StackPanel VerticalAlignment="Center" Visibility="{Binding HasLyrics, Converter={StaticResource BoolToVisibility}}">
                
                <!-- PREVIOUS LINE (Dimmed 65%, Word-Over-Romaji pairs) -->
                <ItemsControl ItemsSource="{Binding PreviousLyricPieces}" Margin="0,0,0,5">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical" Margin="0,0,8,2" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Text}" Foreground="{DynamicResource InactiveLyricBrush}" FontSize="12" FontWeight="{DynamicResource IslandSmallLabelWeight}" HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding Romaji}" Foreground="{DynamicResource InactiveLyricRomajiBrush}" FontSize="11" FontWeight="{DynamicResource IslandBodyWeight}" HorizontalAlignment="Left" Margin="0,1,0,0"
                                           Visibility="{Binding HasReading, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Active line: word-over-romaji pairs -->
                <ItemsControl ItemsSource="{Binding CurrentLyricPieces}" Margin="0,2,0,5">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical" Margin="0,0,9,3" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Text}" Foreground="{DynamicResource ActiveLyricBrush}" FontSize="15" FontWeight="{DynamicResource IslandSmallLabelWeight}" HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding Romaji}" Foreground="{DynamicResource ActiveLyricRomajiBrush}" FontSize="12" FontWeight="{DynamicResource IslandBodyWeight}" HorizontalAlignment="Left" Margin="0,1,0,0"
                                           Visibility="{Binding HasReading, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- NEXT LINE (Dimmed Word-Over-Romaji pairs) -->
                <ItemsControl ItemsSource="{Binding NextLyricPieces}" Margin="0,1,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical" Margin="0,0,8,2" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Text}" Foreground="{DynamicResource InactiveLyricBrush}" FontSize="12" FontWeight="{DynamicResource IslandSmallLabelWeight}" HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding Romaji}" Foreground="{DynamicResource InactiveLyricRomajiBrush}" FontSize="11" FontWeight="{DynamicResource IslandBodyWeight}" HorizontalAlignment="Left" Margin="0,1,0,0"
                                           Visibility="{Binding HasReading, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- When No Synced Lyrics Available -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding HasLyrics, Converter={StaticResource InverseBoolToVisibility}}">
                <Image Source="{StaticResource IconNote}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Width="22" Height="22" HorizontalAlignment="Center" Opacity="0.55" Margin="0,0,0,5"/>
                <TextBlock Text="{Binding LyricsStatusText}" Foreground="{DynamicResource IslandMutedInkBrush}" FontSize="12" FontWeight="{DynamicResource IslandSmallLabelWeight}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding PlainLyrics}" TextWrapping="Wrap" MaxHeight="90" Width="190" Foreground="{DynamicResource IslandMutedInkBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0" />
            <Button Content="Retry lyrics" Click="RetryLyrics_Click" Visibility="{Binding CanRetryLyrics, Converter={StaticResource BoolToVisibility}}" HorizontalAlignment="Center" Margin="0,8,0,0" Style="{StaticResource ActionButton}"/></StackPanel>
        </Grid>

            <!-- Lyric timing nudge: small, bottom-right, dim until hovered so it never moves the lyric lines. Positive = earlier. -->
            <StackPanel x:Name="LyricsOffsetPanel" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,0"
                        Visibility="{Binding HasLyrics, Converter={StaticResource BoolToVisibility}}" ToolTip="Lyric timing: + shows lines earlier, − later (click the value to reset)">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Opacity" Value="0.55"/>
                        <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="1"/></Trigger></Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Button Content="−" Click="LyricsOffsetLater_Click" Style="{StaticResource IslandIconButton}" Margin="0" ToolTip="Show lyrics later" AutomationProperties.Name="Show lyrics later"/>
                <TextBlock Text="{Binding LyricsOffsetText}" MouseLeftButtonUp="LyricsOffsetReset_Click" Cursor="Hand" FontSize="11" Foreground="{DynamicResource IslandMutedInkBrush}" VerticalAlignment="Center" TextAlignment="Center" MinWidth="64" Margin="2,0"/>
                <Button Content="+" Click="LyricsOffsetEarlier_Click" Style="{StaticResource IslandIconButton}" Margin="0" ToolTip="Show lyrics earlier" AutomationProperties.Name="Show lyrics earlier"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
