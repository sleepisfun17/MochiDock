<Window x:Class="MochiDock.Views.TaskbarHoverCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Focusable="False"
        IsHitTestVisible="False"
        FontFamily="{DynamicResource IslandUiFont}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Grid x:Name="RootGrid" Margin="14,10,14,16">
        <!-- Shadow layer kept separate so text stays sharp -->
        <Border Background="{DynamicResource IslandSurfaceBrush}"
                BorderBrush="{DynamicResource IslandSubCardBorderBrush}"
                BorderThickness="1.2"
                CornerRadius="12"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="Black" Opacity="0.55" />
            </Border.Effect>
        </Border>

        <Border Background="{DynamicResource IslandSurfaceBrush}"
                BorderBrush="{DynamicResource IslandSubCardBorderBrush}"
                BorderThickness="1.2"
                CornerRadius="12"
                Padding="12,9"
                MinWidth="172"
                MaxWidth="340">
            <StackPanel>
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ContentPresenter x:Name="IconHost" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock x:Name="TitleText"
                                   FontSize="12"
                                   FontWeight="{DynamicResource IslandSmallStrongWeight}"
                                   Foreground="{DynamicResource IslandInkBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Border x:Name="WarnBadge"
                            Visibility="Collapsed"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            CornerRadius="6"
                            Padding="6,1.5"
                            Margin="10,0,0,0"
                            Background="{DynamicResource IslandWarningSubtleBrush}">
                        <TextBlock Text="Alert"
                                   FontSize="10"
                                   FontWeight="{DynamicResource IslandSmallLabelWeight}"
                                   Foreground="{DynamicResource IslandWarningBrush}" />
                    </Border>
                </Grid>

                <Border Height="1" Background="{DynamicResource IslandSubCardBorderBrush}" Opacity="0.55" Margin="0,7,0,7" />

                <StackPanel x:Name="LinesHost" />

                <TextBlock Text="Click to open · Right-click for options"
                           FontSize="10.5"
                           Foreground="{DynamicResource IslandMutedInkBrush}"
                           Margin="0,7,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
