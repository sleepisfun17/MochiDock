<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib">
<!-- Text typed into text boxes, password boxes and combo boxes: the body text size, so typed text is never smaller than the labels around it. -->
<sys:Double x:Key="IslandInputFontSize">12</sys:Double>
<Style x:Key="HardwareBody" TargetType="TextBlock"><Setter Property="FontFamily" Value="{DynamicResource IslandUiFont}"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="{DynamicResource IslandSmallLabelWeight}"/></Style>
<Style x:Key="HardwareChipLabel" TargetType="TextBlock"><Setter Property="FontFamily" Value="{DynamicResource IslandUiFont}"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="{DynamicResource IslandSmallLabelWeight}"/></Style>
<Style x:Key="HardwareChipValue" TargetType="TextBlock"><Setter Property="FontFamily" Value="{DynamicResource IslandUiFont}"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="{DynamicResource IslandSmallLabelWeight}"/></Style>
<Style x:Key="HardwareSection" TargetType="TextBlock"><Setter Property="FontFamily" Value="{DynamicResource IslandUiFont}"/><Setter Property="FontSize" Value="10.5"/><Setter Property="FontWeight" Value="{DynamicResource IslandPrimaryReadingWeight}"/></Style>
<Style x:Key="HardwareGaugeCaption" TargetType="TextBlock"><Setter Property="FontFamily" Value="{DynamicResource IslandUiFont}"/><Setter Property="FontSize" Value="10.5"/><Setter Property="FontWeight" Value="{DynamicResource IslandSmallLabelWeight}"/></Style>
<Style x:Key="HardwareGaugeValue" TargetType="TextBlock"><Setter Property="FontFamily" Value="{DynamicResource IslandUiFont}"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="{DynamicResource IslandSmallLabelWeight}"/></Style>
<Style x:Key="HeaderLabel" TargetType="TextBlock"><Setter Property="FontFamily" Value="{DynamicResource IslandUiFont}"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="{DynamicResource IslandSmallLabelWeight}"/></Style>
<Style x:Key="HeaderClock" TargetType="TextBlock"><Setter Property="FontFamily" Value="{DynamicResource IslandUiFont}"/><Setter Property="Typography.NumeralAlignment" Value="Tabular"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="{DynamicResource IslandPrimaryReadingWeight}"/></Style>
<Style x:Key="HeaderDate" TargetType="TextBlock"><Setter Property="FontFamily" Value="{DynamicResource IslandUiFont}"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="{DynamicResource IslandSmallLabelWeight}"/></Style>
<Style x:Key="CardBodyText" TargetType="TextBlock"><Setter Property="FontFamily" Value="{DynamicResource IslandUiFont}"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="{DynamicResource IslandSmallLabelWeight}"/><Setter Property="Foreground" Value="{DynamicResource IslandInkBrush}"/></Style>
<Style x:Key="CardCaptionText" TargetType="TextBlock" BasedOn="{StaticResource CardBodyText}"><Setter Property="FontFamily" Value="{DynamicResource IslandUiFont}"/><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{DynamicResource IslandSecondaryInkBrush}"/></Style>
<Style x:Key="CardHeadingText" TargetType="TextBlock" BasedOn="{StaticResource CardBodyText}"><Setter Property="FontFamily" Value="{DynamicResource IslandUiFont}"/><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="{DynamicResource IslandPrimaryReadingWeight}"/></Style>
<Style x:Key="CardSectionLabel" TargetType="TextBlock" BasedOn="{StaticResource CardCaptionText}"><Setter Property="FontWeight" Value="{DynamicResource IslandSmallLabelWeight}"/></Style>
<Style TargetType="TextBlock" BasedOn="{StaticResource CardBodyText}"><Setter Property="FontFamily" Value="{DynamicResource IslandUiFont}"/><Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/><Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/></Style>
</ResourceDictionary>
