<UserControl x:Class="MochiDock.Controls.MascotControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Cursor="Hand"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             MouseLeftButtonDown="Mascot_MouseLeftButtonDown"
             MouseEnter="Mascot_MouseEnter">

    <UserControl.Resources>
        <!-- The face ink: the eyes, the happy and slanted eyes, the spiral and star eyes (MascotEyeBrush), the sunglasses (MascotInkBrush) and
             the closed sleepy arcs (MascotSleepyBrush). Dark in every theme except KuroNight, where Kuro wears light ink (MascotControl.ApplyTheme). -->
        <SolidColorBrush x:Key="MascotEyeBrush" Color="#1A1412" />
        <SolidColorBrush x:Key="MascotInkBrush" Color="#1A1412" />
        <SolidColorBrush x:Key="MascotSleepyBrush" Color="#2C2422" />
    </UserControl.Resources>

    <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
    <Grid Width="30" Height="26" ClipToBounds="False" UseLayoutRounding="True" SnapsToDevicePixels="True">
        <!-- The turn's wind (an anime transformation whirlwind), behind Mochi: the far halves of the brush-stroke rings, built in code
             (MascotControl.BuildWind); collapsed except while he spins -->
        <Canvas x:Name="WindBack" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" Width="30" Height="26">
            <Canvas.RenderTransform><TranslateTransform x:Name="WindBackRise" Y="0" /></Canvas.RenderTransform>
        </Canvas>
        <Grid x:Name="RootGrid" RenderTransformOrigin="0.5, 0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <!-- The turn on a change of face: ScaleX 1 -> 0 -> -1 -> 0 -> 1 reads as Mochi spinning round his vertical axis -->
                    <ScaleTransform x:Name="FlipScaleTransform" ScaleX="1.0" />
                    <ScaleTransform x:Name="BodyScaleTransform" ScaleX="1.0" ScaleY="1.0" />
                    <TranslateTransform x:Name="BodyBounceTransform" Y="0" />
                </TransformGroup>
            </Grid.RenderTransform>

            <!-- The cats' headband (Kuro and Shiro): drawn behind the ears and the body, so the ears sit in front of it. It follows HeadphonesLayer's
                 visibility (set in code, MascotControl constructor); Mochi hides it (opacity 0) and uses the front band instead. -->
            <Canvas x:Name="HeadbandBackLayer" Width="30" Height="26" IsHitTestVisible="False" Opacity="0"
                    Visibility="Collapsed">
                <Path x:Name="HeadbandBackRim" Data="M 1.5,9 C 1.5,-4.5 28.5,-4.5 28.5,9" Stroke="#EBEBF0" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Path x:Name="HeadbandBack" Data="M 1.5,9 C 1.5,-4.5 28.5,-4.5 28.5,9" Stroke="#3A3D4A" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Canvas>

            <!-- Kuro (KuroNight theme only): the ears behind the body, tips about 3 units above the box; one glow effect for both -->
            <Canvas x:Name="KuroEars" Visibility="Collapsed" Width="30" Height="26" IsHitTestVisible="False">
                <Canvas.Effect>
                    <DropShadowEffect x:Name="EarGlow" BlurRadius="5" ShadowDepth="0" Color="#FFD43B" Opacity="0.55" />
                </Canvas.Effect>
                <Path x:Name="EarLeft" Data="M 2.6,9 L 3.4,-0.6 Q 3.7,-3 5.6,-2.2 L 12.6,2.6 L 12.6,8 Z"
                      Fill="#3B3D52" Stroke="#FFD43B" StrokeThickness="0.6" StrokeLineJoin="Round" />
                <Path x:Name="EarRight" Data="M 27.4,9 L 26.6,-0.6 Q 26.3,-3 24.4,-2.2 L 17.4,2.6 L 17.4,8 Z"
                      Fill="#3B3D52" Stroke="#FFD43B" StrokeThickness="0.6" StrokeLineJoin="Round" />
                <Path x:Name="InnerEarLeft" Data="M 5.2,6 L 5.4,0.6 L 9.6,3.4 Z" Fill="#FFD43B" Opacity="0.55" />
                <Path x:Name="InnerEarRight" Data="M 24.8,6 L 24.6,0.6 L 20.4,3.4 Z" Fill="#FFD43B" Opacity="0.55" />
            </Canvas>

            <!-- Kuro's tail (KuroNight theme only): a filled tail tapering to a curled tip, behind the body so the body hides its base. It pokes out
                 about 4 units on the left (away from the clock), sways from the hip now and then and flicks when he is petted. -->
            <Canvas x:Name="KuroTail" Visibility="Collapsed" Width="30" Height="26" IsHitTestVisible="False">
                <Canvas.RenderTransform>
                    <RotateTransform x:Name="TailSwayRotate" CenterX="5" CenterY="21" Angle="0" />
                </Canvas.RenderTransform>
                <Path x:Name="TailShape" Data="M 6,24.2 C 0,25 -4.1,21.5 -4,16 C -3.9,12.5 -3,10 -3.4,7.6 C -2.2,8.6 -1.2,10.8 -1.2,14 C -1.2,17.6 0.8,19.6 6,19.8 Z"
                      Fill="#3B3D52" Stroke="#FFD43B" StrokeThickness="0.6" StrokeLineJoin="Round">
                    <Path.Effect>
                        <DropShadowEffect x:Name="TailGlow" BlurRadius="5" ShadowDepth="0" Color="#FFD43B" Opacity="0.55" />
                    </Path.Effect>
                </Path>
                <Path x:Name="TailSpark" Data="M -3,5.4 L -2.4,6.8 L -1,7.4 L -2.4,8 L -3,9.4 L -3.6,8 L -5,7.4 L -3.6,6.8 Z" Fill="#FFF3B0" Opacity="0.85" />
            </Canvas>
            <!-- Kuro's glow: a charcoal squircle under the body that carries the glow, because the body itself clips its own effect to its box -->
            <Border x:Name="BodyGlow" Visibility="Collapsed" CornerRadius="9" Background="#23253A" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect x:Name="BodyGlowFx" BlurRadius="5" ShadowDepth="0" Color="#FFD43B" Opacity="0.55" />
                </Border.Effect>
            </Border>
            <!-- Coucou Authentic Mochi Squircle Body (#EDEDEF to #C4C5CA) -->
            <Border x:Name="MochiBodyBorder"
                    CornerRadius="9" 
                    BorderThickness="0.8" 
                    BorderBrush="#B8B9C0"
                    ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush x:Name="MochiBodyGradient" StartPoint="0.3, 0" EndPoint="0.7, 1">
                        <GradientStop x:Name="BodyGradStopTop" Color="#EDEDEF" Offset="0.0" />
                        <GradientStop x:Name="BodyGradStopBottom" Color="#C4C5CA" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect x:Name="BodyShadow" BlurRadius="4" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.25" />
                </Border.Effect>

                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" UseLayoutRounding="True" SnapsToDevicePixels="True">
                    <!-- Subtle Top-Left Specular Highlight -->
                    <Ellipse x:Name="BodySheen" Width="16" Height="10"
                             HorizontalAlignment="Left" VerticalAlignment="Top" 
                             Margin="3,2,0,0" 
                             IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                <GradientStop Color="#90FFFFFF" Offset="0" />
                                <GradientStop Color="#00FFFFFF" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- The front surface: it rides round toward the edge and narrows while Mochi turns (MascotTurn), hidden on his back -->
                    <Grid x:Name="FaceLayer" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="FaceTurnScale" ScaleX="1" />
                            <TranslateTransform x:Name="FaceTurnShift" X="0" />
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <!-- Soft Pink Blush Cheeks (Coucou exact: rgba(255, 120, 150, 0.45)) -->
                    <Ellipse x:Name="LeftCheek" Width="6" Height="3.2" 
                             Fill="#73FF7896" 
                             HorizontalAlignment="Center" VerticalAlignment="Center" 
                             Margin="-15,7,0,0" 
                             IsHitTestVisible="False" />
                    
                    <Ellipse x:Name="RightCheek" Width="6" Height="3.2" 
                             Fill="#73FF7896" 
                             HorizontalAlignment="Center" VerticalAlignment="Center" 
                             Margin="15,7,0,0" 
                             IsHitTestVisible="False" />

                    <!-- Coucou Deep Ink Eyes (#1A1412) with Pill and Happy (Music) modes -->
                    <Grid x:Name="FaceGrid" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"
                          UseLayoutRounding="False" SnapsToDevicePixels="False">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="FaceTransform" X="0" Y="0" />
                        </Grid.RenderTransform>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Eye -->
                        <Grid Grid.Column="0" Width="4.8" Height="7.2" RenderTransformOrigin="0.5, 0.5"
                              UseLayoutRounding="False" SnapsToDevicePixels="False">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="LeftEyeBlinkTransform" ScaleY="1.0" />
                            </Grid.RenderTransform>

                            <!-- Standard Pill Eye Shape (#1A1412) via Vector Rectangle to prevent sub-pixel rounding jitter -->
                            <Rectangle x:Name="LeftPillEye" 
                                       Width="4.8" Height="7.2" 
                                       RadiusX="2.4" RadiusY="2.4"
                                       Fill="{DynamicResource MascotEyeBrush}"
                                       UseLayoutRounding="False" SnapsToDevicePixels="False">
                                <Rectangle.RenderTransform><TranslateTransform x:Name="LeftPillShift" X="0" Y="0" /></Rectangle.RenderTransform>
                            </Rectangle>

                            <!-- Happy Eye Arc (Shown when playing music / happy mood) -->
                            <Path x:Name="LeftHappyEye" 
                                  Visibility="Collapsed"
                                  Data="M 0,5.5 A 2.9,2.9 0 0 1 4.8,5.5" 
                                  Stroke="{DynamicResource MascotEyeBrush}"
                                  StrokeThickness="1.5" 
                                  StrokeStartLineCap="Round" 
                                  StrokeEndLineCap="Round" />
                            <!-- Faces: flat eye (hot), droopy eye (drained) and spiral eye (dizzy) -->
                            <Path x:Name="LeftDetermEye" Visibility="Collapsed" Data="M 0,0.6 L 4.8,2.2 L 4.8,4.2 A 2.4,2.4 0 0 1 0,4.2 Z" Fill="{DynamicResource MascotEyeBrush}" />
                            <Path x:Name="LeftFlatEye" Visibility="Collapsed" Data="M 0,3.6 L 4.8,3.6" Stroke="{DynamicResource MascotEyeBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Path x:Name="LeftDroopEye" Visibility="Collapsed" Data="M 0,4.6 L 4.8,2.6" Stroke="{DynamicResource MascotEyeBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Grid x:Name="LeftSpiralEye" Visibility="Collapsed" Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform><RotateTransform x:Name="LeftSpiralRotate" Angle="0" /></Grid.RenderTransform>
                                <Ellipse Width="6" Height="6" Stroke="{DynamicResource MascotEyeBrush}" StrokeThickness="1.15" Fill="Transparent" />
                                <Ellipse Width="2.6" Height="2.6" Stroke="{DynamicResource MascotEyeBrush}" StrokeThickness="1.15" Fill="Transparent" />
                                <Ellipse Width="1" Height="1" Fill="{DynamicResource MascotEyeBrush}" />
                            </Grid>
                            <!-- Wide eye (Notice, New message): a bigger pill with a catchlight -->
                            <Grid x:Name="LeftWideEye" Visibility="Collapsed" Width="6.4" Height="8.2" HorizontalAlignment="Center" VerticalAlignment="Center" UseLayoutRounding="False" SnapsToDevicePixels="False">
                                <Ellipse Width="6.4" Height="8.2" Fill="{DynamicResource MascotEyeBrush}" UseLayoutRounding="False" SnapsToDevicePixels="False" />
                                <Ellipse Width="1.9" Height="1.9" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1.2,1.3,0,0" Fill="#FFFFFF" Opacity="0.95" />
                            </Grid>
                            <!-- Round eye, an O (Surprised) -->
                            <Ellipse x:Name="LeftRoundEye" Visibility="Collapsed" Width="6.4" Height="6.4" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource MascotEyeBrush}" StrokeThickness="1.8" Fill="Transparent" />
                            <!-- Half-lidded eye (Bored, Waking, Up late, Studying): a pill with a flat top -->
                            <Path x:Name="LeftLidEye" Visibility="Collapsed" Data="M 0,3.4 L 4.8,3.4 L 4.8,4.8 A 2.4,2.4 0 0 1 0,4.8 Z" Fill="{DynamicResource MascotEyeBrush}" UseLayoutRounding="False" SnapsToDevicePixels="False" />
                            <!-- Sleepy Closed Eye Arc -->
                            <Path x:Name="LeftSleepyEye" 
                                  Visibility="Collapsed"
                                  Data="M 0,3.5 A 2.9,2.9 0 0 0 4.8,3.5" 
                                  Stroke="{DynamicResource MascotSleepyBrush}"
                                  StrokeThickness="1.5" 
                                  StrokeStartLineCap="Round" 
                                  StrokeEndLineCap="Round" />
                        </Grid>

                        <!-- Right Eye -->
                        <Grid Grid.Column="2" Width="4.8" Height="7.2" RenderTransformOrigin="0.5, 0.5"
                              UseLayoutRounding="False" SnapsToDevicePixels="False">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="RightEyeBlinkTransform" ScaleY="1.0" />
                            </Grid.RenderTransform>

                            <!-- Standard Pill Eye Shape (#1A1412) via Vector Rectangle to prevent sub-pixel rounding jitter -->
                            <Rectangle x:Name="RightPillEye" 
                                       Width="4.8" Height="7.2" 
                                       RadiusX="2.4" RadiusY="2.4"
                                       Fill="{DynamicResource MascotEyeBrush}"
                                       UseLayoutRounding="False" SnapsToDevicePixels="False">
                                <Rectangle.RenderTransform><TranslateTransform x:Name="RightPillShift" X="0" Y="0" /></Rectangle.RenderTransform>
                            </Rectangle>

                            <!-- Happy Eye Arc (Shown when playing music / happy mood) -->
                            <Path x:Name="RightHappyEye" 
                                  Visibility="Collapsed"
                                  Data="M 0,5.5 A 2.9,2.9 0 0 1 4.8,5.5" 
                                  Stroke="{DynamicResource MascotEyeBrush}"
                                  StrokeThickness="1.5" 
                                  StrokeStartLineCap="Round" 
                                  StrokeEndLineCap="Round" />
                            <!-- Faces: flat eye (hot), droopy eye (drained) and spiral eye (dizzy) -->
                            <Path x:Name="RightDetermEye" Visibility="Collapsed" Data="M 4.8,0.6 L 0,2.2 L 0,4.2 A 2.4,2.4 0 0 0 4.8,4.2 Z" Fill="{DynamicResource MascotEyeBrush}" />
                            <Path x:Name="RightFlatEye" Visibility="Collapsed" Data="M 0,3.6 L 4.8,3.6" Stroke="{DynamicResource MascotEyeBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Path x:Name="RightDroopEye" Visibility="Collapsed" Data="M 0,2.6 L 4.8,4.6" Stroke="{DynamicResource MascotEyeBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Grid x:Name="RightSpiralEye" Visibility="Collapsed" Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform><RotateTransform x:Name="RightSpiralRotate" Angle="0" /></Grid.RenderTransform>
                                <Ellipse Width="6" Height="6" Stroke="{DynamicResource MascotEyeBrush}" StrokeThickness="1.15" Fill="Transparent" />
                                <Ellipse Width="2.6" Height="2.6" Stroke="{DynamicResource MascotEyeBrush}" StrokeThickness="1.15" Fill="Transparent" />
                                <Ellipse Width="1" Height="1" Fill="{DynamicResource MascotEyeBrush}" />
                            </Grid>
                            <!-- Wide eye (Notice, New message): a bigger pill with a catchlight -->
                            <Grid x:Name="RightWideEye" Visibility="Collapsed" Width="6.4" Height="8.2" HorizontalAlignment="Center" VerticalAlignment="Center" UseLayoutRounding="False" SnapsToDevicePixels="False">
                                <Ellipse Width="6.4" Height="8.2" Fill="{DynamicResource MascotEyeBrush}" UseLayoutRounding="False" SnapsToDevicePixels="False" />
                                <Ellipse Width="1.9" Height="1.9" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1.2,1.3,0,0" Fill="#FFFFFF" Opacity="0.95" />
                            </Grid>
                            <!-- Round eye, an O (Surprised) -->
                            <Ellipse x:Name="RightRoundEye" Visibility="Collapsed" Width="6.4" Height="6.4" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource MascotEyeBrush}" StrokeThickness="1.8" Fill="Transparent" />
                            <!-- Half-lidded eye (Bored, Waking, Up late, Studying): a pill with a flat top -->
                            <Path x:Name="RightLidEye" Visibility="Collapsed" Data="M 0,3.4 L 4.8,3.4 L 4.8,4.8 A 2.4,2.4 0 0 1 0,4.8 Z" Fill="{DynamicResource MascotEyeBrush}" UseLayoutRounding="False" SnapsToDevicePixels="False" />
                            <!-- Sleepy Closed Eye Arc -->
                            <Path x:Name="RightSleepyEye" 
                                  Visibility="Collapsed"
                                  Data="M 0,3.5 A 2.9,2.9 0 0 0 4.8,3.5" 
                                  Stroke="{DynamicResource MascotSleepyBrush}"
                                  StrokeThickness="1.5" 
                                  StrokeStartLineCap="Round" 
                                  StrokeEndLineCap="Round" />
                        </Grid>
                    </Grid>

                    <!-- Faces: the tears, drawn in the same 30 x 26 space as the face and moving with the gaze. Mochi has no mouth and no eyebrows. -->
                    <Canvas x:Name="FaceExtras" Width="30" Height="26" IsHitTestVisible="False" RenderTransform="{Binding RenderTransform, ElementName=FaceGrid}">
                        <Path x:Name="TearDrop" Visibility="Collapsed" Data="M 6.4,14.6 C 5.5,16 5.2,16.8 5.2,17.4 A 1.2,1.2 0 0 0 7.6,17.4 C 7.6,16.8 7.3,16 6.4,14.6 Z" Fill="#7FC4F5" Stroke="#2F86C8" StrokeThickness="0.5">
                            <Path.RenderTransform><TranslateTransform x:Name="TearT" Y="0" /></Path.RenderTransform>
                        </Path>
                        <Path x:Name="TearDropRight" Visibility="Collapsed" Data="M 23.6,14.6 C 22.7,16 22.4,16.8 22.4,17.4 A 1.2,1.2 0 0 0 24.8,17.4 C 24.8,16.8 24.5,16 23.6,14.6 Z" Fill="#7FC4F5" Stroke="#2F86C8" StrokeThickness="0.5">
                            <Path.RenderTransform><TranslateTransform x:Name="TearRightT" Y="0" /></Path.RenderTransform>
                        </Path>
                        <!-- Activity faces drawn over the eyes (they follow the gaze): star eyes (Electric), coin eyes (Money), sunglasses (Sunny) -->
                        <Canvas x:Name="StarEyes" Visibility="Collapsed" Canvas.Left="-1" Canvas.Top="-1" UseLayoutRounding="False" SnapsToDevicePixels="False">
                            <Path Data="M 9.6,8.9 L 10.6,11.5 L 13.2,12.5 L 10.6,13.5 L 9.6,16.1 L 8.6,13.5 L 6,12.5 L 8.6,11.5 Z" Fill="{DynamicResource MascotEyeBrush}" />
                            <Path Data="M 20.4,8.9 L 21.4,11.5 L 24,12.5 L 21.4,13.5 L 20.4,16.1 L 19.4,13.5 L 16.8,12.5 L 19.4,11.5 Z" Fill="{DynamicResource MascotEyeBrush}" />
                            <Ellipse Canvas.Left="9.9" Canvas.Top="11.2" Width="1" Height="1" Fill="#FFF3B0" />
                            <Ellipse Canvas.Left="20.7" Canvas.Top="11.2" Width="1" Height="1" Fill="#FFF3B0" />
                        </Canvas>
                        <Canvas x:Name="CoinEyes" Visibility="Collapsed" Canvas.Left="-1" Canvas.Top="-1" UseLayoutRounding="False" SnapsToDevicePixels="False">
                            <Ellipse Canvas.Left="6.8" Canvas.Top="9.7" Width="5.6" Height="5.6" Fill="#F5C542" Stroke="#A87A12" StrokeThickness="0.6" />
                            <Ellipse Canvas.Left="17.6" Canvas.Top="9.7" Width="5.6" Height="5.6" Fill="#F5C542" Stroke="#A87A12" StrokeThickness="0.6" />
                            <Path Data="M 8.61,11.15 L 9.6,12.41 L 10.59,11.15 M 9.6,12.41 L 9.6,13.94 M 8.79,12.68 L 10.41,12.68 M 8.79,13.31 L 10.41,13.31" Stroke="#7A5200" StrokeThickness="0.55" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Path Data="M 19.41,11.15 L 20.4,12.41 L 21.39,11.15 M 20.4,12.41 L 20.4,13.94 M 19.59,12.68 L 21.21,12.68 M 19.59,13.31 L 21.21,13.31" Stroke="#7A5200" StrokeThickness="0.55" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                        <Canvas x:Name="Sunglasses" Visibility="Collapsed" Canvas.Left="-1" Canvas.Top="-1" UseLayoutRounding="False" SnapsToDevicePixels="False">
                            <Rectangle Canvas.Left="6.4" Canvas.Top="10.4" Width="6.4" Height="4.4" RadiusX="1.8" RadiusY="1.8" Fill="{DynamicResource MascotInkBrush}" />
                            <Rectangle Canvas.Left="17.2" Canvas.Top="10.4" Width="6.4" Height="4.4" RadiusX="1.8" RadiusY="1.8" Fill="{DynamicResource MascotInkBrush}" />
                            <Path Data="M 12.8,11.4 Q 15,10.4 17.2,11.4" Stroke="{DynamicResource MascotInkBrush}" StrokeThickness="0.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Path Data="M 7.6,11.4 L 9.2,11.4 M 18.4,11.4 L 20,11.4" Stroke="#9CC9FF" StrokeThickness="0.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.85" />
                        </Canvas>
                    </Canvas>
                    <!-- Vector Sweat Droplet (Shown when GPU/CPU runs hot) -->
                    <Path x:Name="SweatDrop" Visibility="Collapsed" IsHitTestVisible="False"
                          Data="M 23,2 C 21,5 20,7 20,8.5 A 2,2 0 0 0 24,8.5 C 24,7 23,5 23,2 Z"
                          Fill="#40C8FF" Stroke="#007ACC" StrokeThickness="0.5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,3,0">
                        <Path.RenderTransform><TranslateTransform x:Name="SweatTransform" Y="0" /></Path.RenderTransform>
                    </Path>
                    </Grid>
                </Grid>
            </Border>


            <!-- Faces: things outside the body (icicles, dizzy stars, confetti, bolts); every child starts collapsed. The meaning of a face
                 that used to float above the head as a thin prop now sits in the StatusBadge (the last layer) instead. -->
            <Canvas x:Name="ExtrasLayer" Width="30" Height="26" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- The startle lines: three short, bold strokes at the top corners and in the middle -->
                <Path x:Name="StartleLines" Visibility="Collapsed" Data="M 2.8,-0.4 L 0.8,-3.4 M 27.2,-0.4 L 29.2,-3.4 M 15,-1.2 L 15,-4.4"
                      Stroke="#F2A33A" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Canvas x:Name="IcicleGroup" Visibility="Collapsed">
                    <Polygon Points="7,-0.4 9,3.8 11,-0.4" Fill="#E6F1FB" Stroke="#85B7EB" StrokeThickness="0.5" StrokeLineJoin="Round" />
                    <Polygon Points="13,-0.4 15,5.2 17,-0.4" Fill="#E6F1FB" Stroke="#85B7EB" StrokeThickness="0.5" StrokeLineJoin="Round" />
                    <Polygon Points="19,-0.4 21,3.8 23,-0.4" Fill="#E6F1FB" Stroke="#85B7EB" StrokeThickness="0.5" StrokeLineJoin="Round" />
                </Canvas>
                <Canvas x:Name="StarsGroup" Visibility="Collapsed">
                    <Ellipse x:Name="StarA" Width="2.2" Height="2.2" Canvas.Left="5" Canvas.Top="-2.6" Fill="#EF9F27" />
                    <Ellipse x:Name="StarB" Width="2.2" Height="2.2" Canvas.Left="13.9" Canvas.Top="-3.6" Fill="#EF9F27" />
                    <Ellipse x:Name="StarC" Width="2.2" Height="2.2" Canvas.Left="22.8" Canvas.Top="-2.6" Fill="#EF9F27" />
                </Canvas>
                <Canvas x:Name="ConfettiGroup" Visibility="Collapsed">
                    <Canvas.RenderTransform><TranslateTransform x:Name="ConfettiT" Y="0" /></Canvas.RenderTransform>
                    <Rectangle Canvas.Left="0.6" Canvas.Top="1.2" Width="2.4" Height="1.2" Fill="#E24B4A" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><RotateTransform Angle="30" /></Rectangle.RenderTransform></Rectangle>
                    <Ellipse Canvas.Left="3.6" Canvas.Top="-2.4" Width="1.8" Height="1.8" Fill="#378ADD" />
                    <Rectangle Canvas.Left="13.6" Canvas.Top="-3" Width="2.4" Height="1.2" Fill="#5DB55F" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><RotateTransform Angle="-35" /></Rectangle.RenderTransform></Rectangle>
                    <Ellipse Canvas.Left="24.6" Canvas.Top="-2.4" Width="1.8" Height="1.8" Fill="#EF9F27" />
                    <Rectangle Canvas.Left="27" Canvas.Top="1.2" Width="2.4" Height="1.2" Fill="#D4537E" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><RotateTransform Angle="50" /></Rectangle.RenderTransform></Rectangle>
                </Canvas>
                <!-- Activity faces outside the body: the lightning ring (Electric), the rain drops (Rainy) and the scarf (Snowy) -->
                <Canvas x:Name="BoltOrbit" Visibility="Collapsed" Width="30" Height="26">
                    <Canvas.RenderTransform><RotateTransform x:Name="BoltOrbitRotate" CenterX="15" CenterY="13" Angle="0" /></Canvas.RenderTransform>
                    <Path x:Name="BoltA" Canvas.Left="13.5" Canvas.Top="-1.6" Data="M 1.7,0 L 0,2.9 L 1.4,2.9 L 0.7,5 L 3,1.9 L 1.6,1.9 L 2.5,0 Z" Fill="#FFD23F" Stroke="#C98A00" StrokeThickness="0.4" StrokeLineJoin="Round" />
                    <Path x:Name="BoltB" Canvas.Left="24.2" Canvas.Top="16.2" Data="M 1.7,0 L 0,2.9 L 1.4,2.9 L 0.7,5 L 3,1.9 L 1.6,1.9 L 2.5,0 Z" Fill="#FFD23F" Stroke="#C98A00" StrokeThickness="0.4" StrokeLineJoin="Round" />
                    <Path x:Name="BoltC" Canvas.Left="2.8" Canvas.Top="16.2" Data="M 1.7,0 L 0,2.9 L 1.4,2.9 L 0.7,5 L 3,1.9 L 1.6,1.9 L 2.5,0 Z" Fill="#FFD23F" Stroke="#C98A00" StrokeThickness="0.4" StrokeLineJoin="Round" />
                </Canvas>
                <Canvas x:Name="RainGroup" Visibility="Collapsed">
                    <Canvas.RenderTransform><TranslateTransform x:Name="RainT" Y="0" /></Canvas.RenderTransform>
                    <Path Data="M 3,-2 C 2.3,-0.9 2.1,-0.4 2.1,0 A 0.9,0.9 0 0 0 3.9,0 C 3.9,-0.4 3.7,-0.9 3,-2 Z" Fill="#7FC4F5" Stroke="#2F86C8" StrokeThickness="0.4" />
                    <Path Data="M 27,-4 C 26.3,-2.9 26.1,-2.4 26.1,-2 A 0.9,0.9 0 0 0 27.9,-2 C 27.9,-2.4 27.7,-2.9 27,-4 Z" Fill="#7FC4F5" Stroke="#2F86C8" StrokeThickness="0.4" />
                </Canvas>
                <Canvas x:Name="ScarfGroup" Visibility="Collapsed">
                    <Rectangle Canvas.Left="2.6" Canvas.Top="18.2" Width="24.8" Height="3.2" RadiusX="1.6" RadiusY="1.6" Fill="#E24B4A" Stroke="#A8302F" StrokeThickness="0.4" />
                    <Rectangle Canvas.Left="20" Canvas.Top="19.6" Width="3.2" Height="6.2" RadiusX="1" RadiusY="1" Fill="#E24B4A" Stroke="#A8302F" StrokeThickness="0.4" />
                    <Path Data="M 6,18.4 L 6,21.2 M 10,18.4 L 10,21.2 M 14,18.4 L 14,21.2" Stroke="#F7C1C1" StrokeThickness="0.5" />
                </Canvas>
                <!-- The day faces: a party hat (Birthday) and the headset's microphone boom (Meeting) -->
                <Canvas x:Name="PartyHat" Visibility="Collapsed">
                    <Polygon Points="11.8,0.5 15.4,-6.2 19,0.5" Fill="#FF7AA8" Stroke="#C24C7A" StrokeThickness="0.5" StrokeLineJoin="Round" />
                    <Path Data="M 13.1,-2.2 L 17.7,-2.2 M 14.3,-4.4 L 16.5,-4.4" Stroke="#FFFFFF" StrokeThickness="0.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Ellipse Canvas.Left="14.3" Canvas.Top="-8.4" Width="2.2" Height="2.2" Fill="#FFD23F" Stroke="#D9A21C" StrokeThickness="0.4" />
                </Canvas>
                <Canvas x:Name="MicBoom" Visibility="Collapsed">
                    <Path x:Name="MicBoomArm" Data="M 2.6,16.2 Q 3.4,21.4 8.4,21.2" Stroke="#3A3F4A" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Ellipse x:Name="MicBoomTip" Canvas.Left="7.8" Canvas.Top="20" Width="2.6" Height="2.4" Fill="#3A3F4A" />
                </Canvas>
            </Canvas>
            <!-- Vector Headphones Layer (OUTSIDE the clipped body so the band is never clipped), drawn in the body's 30 x 26 space:
                 the band rests on top of the head and runs down both sides into the ear cups, which sit on the edge of the body at ear height and stay inside its 30 unit width (anything wider is cut by the capsule) -->
            <Canvas x:Name="HeadphonesLayer" Visibility="Collapsed" IsHitTestVisible="False" Width="30" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path x:Name="HeadbandRim" Data="M 1.5,9 C 1.5,-4.5 28.5,-4.5 28.5,9" Stroke="#EBEBF0" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Path x:Name="HeadbandArc" Data="M 1.5,9 C 1.5,-4.5 28.5,-4.5 28.5,9" Stroke="#3A3D4A" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Border x:Name="EarCupLeft" Canvas.Left="0" Canvas.Top="7.6" Width="4.8" Height="8.8" Background="#3A3D4A" BorderBrush="#EBEBF0" BorderThickness="0.7" CornerRadius="2.2" />
                <Border x:Name="EarCupRight" Canvas.Left="25.2" Canvas.Top="7.6" Width="4.8" Height="8.8" Background="#3A3D4A" BorderBrush="#EBEBF0" BorderThickness="0.7" CornerRadius="2.2" />
                <!-- Gaming and Worried: a small red light on each cup -->
                <Ellipse x:Name="HeadsetLedLeft" Visibility="Collapsed" Canvas.Left="1.5" Canvas.Top="11.1" Width="1.8" Height="1.8" Fill="#E5484D" />
                <Ellipse x:Name="HeadsetLedRight" Visibility="Collapsed" Canvas.Left="26.7" Canvas.Top="11.1" Width="1.8" Height="1.8" Fill="#E5484D" />
            </Canvas>

            <!-- The status badge (MascotBadge): one disc in the top-right corner whose glyph and colour tell the face (a red "!" for a message, a navy
                 "z" for sleep, ...). Drawn around its own origin so it scales about its centre; BadgePos puts it in the corner (a little lower for the
                 cats, below the right ear). The ring separates the disc from the body. -->
            <!-- The cats' music: one eighth note that drifts up on the tail side (left, away from the clock) and fades, again and again while
                 music plays (MascotControl.StartMusicNote). Drawn around its head; NoteSteady cancels the body's dance like BadgeSteady, so it
                 moves only by its own drift. Its colour is read against the capsule ground (MascotNote.InkFor). -->
            <Canvas x:Name="MusicNote" Visibility="Collapsed" Width="30" Height="26" IsHitTestVisible="False">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform x:Name="NoteDrift" X="-2" Y="5" />
                        <TranslateTransform x:Name="NoteSteady" X="0" Y="0" />
                    </TransformGroup>
                </Canvas.RenderTransform>
                <Path x:Name="MusicNoteGlyph" Fill="#B58CFF"
                      Data="M -1.2,0 A 1.9,1.5 -20 1 0 2.6,0 A 1.9,1.5 -20 1 0 -1.2,0 Z M 1.75,-0.4 L 1.75,-8 L 2.75,-8 C 4.6,-7.2 5.4,-5.6 4.4,-3.6 C 4.4,-5.2 3.8,-6.1 2.75,-6.4 L 2.75,-0.4 Z" />
            </Canvas>
            <Canvas x:Name="StatusBadge" Visibility="Collapsed" Width="30" Height="26" IsHitTestVisible="False">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="BadgeSize" ScaleX="1" ScaleY="1" />
                        <ScaleTransform x:Name="BadgeScale" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="BadgePos" X="25.2" Y="3.8" />
                        <!-- Cancels the body's bounce and sway (bound, negated, to BodyBounceTransform in code), so the small glyph stays sharp
                             while the mascot dances: moved by fractions of a pixel every frame it shimmered into a blob -->
                        <TranslateTransform x:Name="BadgeSteady" X="0" Y="0" />
                    </TransformGroup>
                </Canvas.RenderTransform>
                <Ellipse x:Name="BadgeRing" Canvas.Left="-4.9" Canvas.Top="-4.9" Width="9.8" Height="9.8" Fill="#FFFFFF" />
                <Ellipse x:Name="BadgeDisc" Canvas.Left="-4" Canvas.Top="-4" Width="8" Height="8" Fill="#D13438" />
                <Path x:Name="BadgeGlyph" Fill="#FFFFFF" Data="M 0,0" />
            </Canvas>
        </Grid>

        <!-- The turn's wind in front of Mochi: the near halves of the rings and the curl (built in code), and dust puffing at his feet -->
        <Canvas x:Name="WindFront" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" Width="30" Height="26">
            <Canvas.RenderTransform><TranslateTransform x:Name="WindFrontRise" Y="0" /></Canvas.RenderTransform>
            <Canvas x:Name="DustPuffs">
                <Canvas.RenderTransform><ScaleTransform x:Name="DustScale" CenterX="15" CenterY="24" ScaleX="1" ScaleY="1" /></Canvas.RenderTransform>
                <Ellipse x:Name="DustA" Canvas.Left="4.4" Canvas.Top="22.6" Width="3.2" Height="2.4" Fill="#40FFFFFF" />
                <Ellipse x:Name="DustB" Canvas.Left="13.4" Canvas.Top="23.4" Width="3.2" Height="2.2" Fill="#40FFFFFF" />
                <Ellipse x:Name="DustC" Canvas.Left="22.4" Canvas.Top="22.6" Width="3.2" Height="2.4" Fill="#40FFFFFF" />
            </Canvas>
        </Canvas>

        <!-- Sleepy Zzz Particle: three vector letters (WPF text cannot draw colour emoji, so the old emoji was black and white) -->

        <!-- Floating Heart (click feedback): a vector heart, because WPF text cannot draw the colour emoji -->
        <Grid x:Name="FloatingHeart"
              Width="9"
              Height="8"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Margin="0,-2,0,0"
              Opacity="0"
              IsHitTestVisible="False">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="HeartTranslate" X="0" Y="0" />
            </Grid.RenderTransform>
            <Path Data="M 4.5,7.6 C 1,5 0.4,3.6 0.4,2.4 C 0.4,1.2 1.4,0.4 2.5,0.4 C 3.4,0.4 4.1,0.9 4.5,1.6 C 4.9,0.9 5.6,0.4 6.5,0.4 C 7.6,0.4 8.6,1.2 8.6,2.4 C 8.6,3.6 8,5 4.5,7.6 Z"
                  Fill="#FF5C8A" Stroke="#D63A6A" StrokeThickness="0.6" StrokeLineJoin="Round" />
            <Path Data="M 1.7,2.5 Q 1.8,1.5 2.8,1.3" Stroke="#FFFFFF" StrokeThickness="0.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.85" />
        </Grid>
    </Grid>
    </Viewbox>
</UserControl>
