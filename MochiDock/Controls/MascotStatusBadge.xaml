<UserControl x:Class="MochiDock.Controls.MascotStatusBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             IsHitTestVisible="False"
             Visibility="Collapsed">
    <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid x:Name="BadgeRoot" Width="20" Height="20" RenderTransformOrigin="0.5,0.5" ClipToBounds="False" UseLayoutRounding="False">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="BadgeScale" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>

            <!-- Style 1: 3D Squircle Charm -->
            <Grid x:Name="BadgeCharm" Visibility="Collapsed" Margin="1.5">
                <Grid.Effect>
                    <DropShadowEffect BlurRadius="3.5" ShadowDepth="1.1" Direction="270" Color="#000000" Opacity="0.42" />
                </Grid.Effect>
                <Border x:Name="BadgeBody" CornerRadius="5.5" BorderThickness="1.15" BorderBrush="#FFFFFF" ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0.25,0" EndPoint="0.75,1">
                            <GradientStop x:Name="BadgeGradTop" Color="#DE5558" Offset="0" />
                            <GradientStop x:Name="BadgeGradMid" Color="#D13438" Offset="0.48" />
                            <GradientStop x:Name="BadgeGradBottom" Color="#9B2629" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Ellipse Width="12" Height="6" HorizontalAlignment="Left" VerticalAlignment="Top"
                                 Margin="1,0.7,0,0" IsHitTestVisible="False">
                            <Ellipse.Fill>
                                <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                    <GradientStop Color="#68FFFFFF" Offset="0" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Viewbox Stretch="Uniform" Margin="2.2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="10" Height="10">
                                <Path x:Name="BadgeGlyphShadow" Fill="#48000000" Data="M 0,0" Canvas.Top="0.55" />
                                <Path x:Name="BadgeGlyph" Fill="#FFFFFF" Data="M 0,0" />
                            </Canvas>
                        </Viewbox>
                    </Grid>
                </Border>
            </Grid>

            <!-- Style 2: 3D Speech Bubble (points left toward Mochi/Neko) -->
            <Grid x:Name="BadgeBubble" Visibility="Collapsed" Margin="1.2,1.6,0.4,1.6" ClipToBounds="False">
                <Grid.Effect>
                    <DropShadowEffect BlurRadius="3.5" ShadowDepth="1.1" Direction="270" Color="#000000" Opacity="0.44" />
                </Grid.Effect>
                <Path x:Name="BadgeBubbleTail" Fill="#EEF1F7" Stroke="#B8C0D0" StrokeThickness="1.0" StrokeLineJoin="Round"
                      Data="M 3.2,6.2 L -0.8,9.0 L 3.2,11.6 Z" />
                <Border x:Name="BadgeBubbleBody" Margin="1.8,0,0,0" CornerRadius="7" BorderThickness="1.05" BorderBrush="#B8C0D0" ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0.25,0" EndPoint="0.75,1">
                            <GradientStop Color="#FFFFFF" Offset="0" />
                            <GradientStop Color="#F4F6FA" Offset="0.55" />
                            <GradientStop Color="#D9DFEA" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Ellipse Width="12" Height="5.2" HorizontalAlignment="Left" VerticalAlignment="Top"
                                 Margin="1.2,0.7,0,0" IsHitTestVisible="False">
                            <Ellipse.Fill>
                                <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                    <GradientStop Color="#88FFFFFF" Offset="0" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Viewbox Stretch="Uniform" Margin="2.2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="10" Height="10">
                                <Path x:Name="BadgeBubbleGlyphShadow" Fill="#28000000" Data="M 0,0" Canvas.Top="0.45" />
                                <Path x:Name="BadgeBubbleGlyph" Fill="#D13438" Data="M 0,0" />
                            </Canvas>
                        </Viewbox>
                    </Grid>
                </Border>
            </Grid>

            <!-- Style 3: 3D Die-Cut Sticker (13x13 canvas holds 10x10 glyph + 2.0px outer rim safely inside bounds) -->
            <Viewbox x:Name="BadgeSticker" Visibility="Collapsed" Stretch="Uniform" Margin="0.8"
                     HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas Width="13" Height="13">
                    <Path x:Name="BadgeStickerBack" Canvas.Left="1.5" Canvas.Top="1.5" Fill="#FFFFFF" Stroke="#FFFFFF" StrokeThickness="2.0"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 0,0">
                        <Path.Effect>
                            <DropShadowEffect BlurRadius="2.5" ShadowDepth="0.9" Direction="270" Color="#000000" Opacity="0.45" />
                        </Path.Effect>
                    </Path>
                    <Path x:Name="BadgeStickerFill" Canvas.Left="1.5" Canvas.Top="1.5" Data="M 0,0">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0.3,0" EndPoint="0.7,1">
                                <GradientStop x:Name="StickerGradTop" Color="#DE5558" Offset="0" />
                                <GradientStop x:Name="StickerGradMid" Color="#D13438" Offset="0.48" />
                                <GradientStop x:Name="StickerGradBottom" Color="#9B2629" Offset="1" />
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>
                    <Path x:Name="BadgeStickerSheen" Canvas.Left="1.5" Canvas.Top="1.5" Data="M 0,0" IsHitTestVisible="False">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0.3,0" EndPoint="0.5,0.65">
                                <GradientStop Color="#55FFFFFF" Offset="0" />
                                <GradientStop Color="#00FFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>
                </Canvas>
            </Viewbox>
        </Grid>
    </Viewbox>
</UserControl>
