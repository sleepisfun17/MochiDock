<UserControl x:Class="MochiDock.Controls.MarqueeTextBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             HorizontalAlignment="Stretch"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Grayscale">
    <!-- Outer clipping border ensures no visual overflow outside the allocated slot -->
    <Border x:Name="ClippingBorder" ClipToBounds="True" HorizontalAlignment="Stretch" VerticalAlignment="Center"
            SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Canvas x:Name="ViewportCanvas" Height="22" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                SnapsToDevicePixels="True" UseLayoutRounding="True">
            <StackPanel x:Name="ContentPanel" Orientation="Horizontal" Canvas.Left="0" Canvas.Top="0"
                        SnapsToDevicePixels="True" UseLayoutRounding="True">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="TranslateTransform" />
                </StackPanel.RenderTransform>

                <!-- Primary TextBlock -->
                <TextBlock x:Name="PrimaryText"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           VerticalAlignment="Center"
                           SnapsToDevicePixels="True"
                           UseLayoutRounding="True"
                           TextOptions.TextFormattingMode="Ideal"
                           TextTrimming="None" />

                <!-- Seamless Loop Duplicate TextBlock (Only shown when scrolling is active) -->
                <StackPanel x:Name="LoopPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed"
                            SnapsToDevicePixels="True" UseLayoutRounding="True">
                    <TextBlock x:Name="SeparatorBullet" Text="     ●     " Opacity="0.4"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               VerticalAlignment="Center"
                               SnapsToDevicePixels="True"
                               UseLayoutRounding="True"
                               TextOptions.TextFormattingMode="Ideal" />
                    <TextBlock x:Name="SecondaryText"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               VerticalAlignment="Center"
                               SnapsToDevicePixels="True"
                               UseLayoutRounding="True"
                               TextOptions.TextFormattingMode="Ideal"
                               TextTrimming="None" />
                </StackPanel>
            </StackPanel>
        </Canvas>
    </Border>
</UserControl>
